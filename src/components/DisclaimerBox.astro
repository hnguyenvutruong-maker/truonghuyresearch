---
import { portfolioDisclaimer } from '../data/valuation-models';

interface Props {
  label?: string;
  text?: string;
  variant?: 'terminal' | 'broadsheet';
}

const { label = 'Academic research / not investment advice', text = portfolioDisclaimer, variant = 'terminal' } = Astro.props;
---

{variant === 'broadsheet' ? (
<section class="border-y border-ink py-5 md:grid md:grid-cols-12 md:gap-6">
  <p class="font-news-mono text-news-label uppercase text-oxblood md:col-span-3">Disclosure · {label}</p>
  <p class="mt-2 font-news text-news-small italic text-ink-soft md:col-span-9 md:mt-0">{text}</p>
</section>
) : (
<section class="border border-terminal-border bg-terminal-card p-5 md:p-6">
  <p class="font-label-md uppercase text-label-md text-terminal-accent mb-3">{label}</p>
  <p class="font-body-sm md:font-body-md text-body-sm md:text-body-md text-on-surface-variant">{text}</p>
</section>
)}
