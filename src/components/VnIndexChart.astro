---
export interface TrendPoint {
  time: string;   // YYYY-MM-DD
  value: number;  // vn_index_close
}

export interface CandlePoint {
  time: string;   // YYYY-MM-DD
  open: number;
  high: number;
  low: number;
  close: number;
}

interface Props {
  trendData?: TrendPoint[];
  candleData?: CandlePoint[];
  label?: string;
  theme?: 'terminal' | 'broadsheet';
}

const { trendData = [], candleData = [], label = 'VN-INDEX TREND', theme = 'terminal' } = Astro.props;
const isBroadsheet = theme === 'broadsheet';

const hasTrend = trendData.length > 0;
const hasCandle = candleData.length > 0;
const hasData = hasTrend || hasCandle;
---

{hasData && (
  <div class:list={[
    isBroadsheet
      ? 'border-t-2 border-ink pt-3'
      : 'bg-terminal-bg border border-terminal-border border-t-2 border-t-terminal-accent p-4',
  ]}>
    <p class:list={[
      'mb-3',
      isBroadsheet
        ? 'font-news-mono text-news-label uppercase text-ink-muted'
        : 'font-label-md uppercase text-label-md text-on-surface-variant',
    ]}>{label}</p>
    <div
      id="vni-chart"
      class:list={['w-full', isBroadsheet ? 'h-[280px]' : 'h-[200px]']}
      data-theme={theme}
      data-trend={JSON.stringify(trendData)}
      data-candle={JSON.stringify(candleData)}
    ></div>
  </div>
)}

<script>
  import { createChart, CrosshairMode } from 'lightweight-charts';

  const container = document.getElementById('vni-chart');
  if (container) {
    const trendRaw = container.getAttribute('data-trend') ?? '[]';
    const candleRaw = container.getAttribute('data-candle') ?? '[]';
    const trendData: { time: string; value: number }[] = JSON.parse(trendRaw);
    const candleData: { time: string; open: number; high: number; low: number; close: number }[] = JSON.parse(candleRaw);

    const palettes = {
      terminal: { bg: '#0d1117', text: '#8b949e', grid: '#30363d', line: '#f0a500', up: '#84e588', down: '#ffb4ab', font: 'JetBrains Mono, monospace' },
      broadsheet: { bg: 'rgba(0, 0, 0, 0)', text: '#6B6259', grid: 'rgba(25, 23, 20, 0.09)', line: '#191714', up: '#1E6B52', down: '#8E1B1B', font: 'Geist Mono, monospace' },
    } as const;
    const isBroadsheet = container.dataset.theme === 'broadsheet';
    const palette = isBroadsheet ? palettes.broadsheet : palettes.terminal;

    const chart = createChart(container, {
      width: container.clientWidth,
      height: container.clientHeight || 200,
      layout: {
        background: { color: palette.bg },
        textColor: palette.text,
        fontFamily: palette.font,
      },
      grid: {
        vertLines: { color: palette.grid },
        horzLines: { color: palette.grid },
      },
      crosshair: { mode: CrosshairMode.Normal },
      rightPriceScale: { borderColor: palette.grid },
      timeScale: { borderColor: palette.grid, timeVisible: true },
      handleScroll: false,
      handleScale: false,
    });

    if (candleData.length > 0) {
      const candleSeries = chart.addCandlestickSeries({
        upColor: palette.up,
        downColor: palette.down,
        borderUpColor: palette.up,
        borderDownColor: palette.down,
        wickUpColor: palette.up,
        wickDownColor: palette.down,
      });
      candleSeries.setData(candleData);
    } else if (trendData.length > 0 && isBroadsheet) {
      const areaSeries = chart.addAreaSeries({
        lineColor: palette.line,
        topColor: 'rgba(25, 23, 20, 0.14)',
        bottomColor: 'rgba(25, 23, 20, 0)',
        lineWidth: 2,
        priceLineVisible: false,
        lastValueVisible: true,
        crosshairMarkerVisible: true,
      });
      areaSeries.setData(trendData);
    } else if (trendData.length > 0) {
      const lineSeries = chart.addLineSeries({
        color: '#f0a500',
        lineWidth: 2,
        priceLineVisible: false,
        lastValueVisible: true,
        crosshairMarkerVisible: true,
      });
      lineSeries.setData(trendData);
    }

    chart.timeScale().fitContent();

    new ResizeObserver(() => {
      chart.applyOptions({ width: container.clientWidth });
    }).observe(container);
  }
</script>
