---
// Compact institutional footer: credential lockup, site map, disclosure bar.
import BrandMark from './BrandMark.astro';
import { methodPages, valuationGroups, valuationModels } from '../../data/valuation-models';

const year = new Date().getFullYear();
const columns: Array<{ title: string; links: Array<{ href: string; label: string; external?: boolean }> }> = [
  { title: 'Coverage', links: [{ href: '/research', label: 'All companies' }, ...valuationModels.map((m) => ({ href: `/research/${m.slug}`, label: `${m.ticker} · ${m.company}` }))] },
  {
    title: 'Methods',
    links: [
      ...methodPages.map((p) => ({ href: p.href, label: valuationGroups.find((g) => g.id === p.id)?.title ?? p.id })),
      { href: '/research#files', label: 'Model files' },
    ],
  },
  {
    title: 'Market notes',
    links: [
      { href: '/market-views', label: 'All notes' },
      { href: '/market-views?kind=weekly#archive', label: 'Weekly' },
      { href: '/monthly-views', label: 'Monthly' },
      { href: '/market-views#foreign-flow', label: 'Foreign flow' },
      { href: '/rss.xml', label: 'RSS' },
    ],
  },
  {
    title: 'Analyst',
    links: [
      { href: '/contact', label: 'Profile & contact' },
      { href: '/cv.pdf', label: 'CV (PDF)', external: true },
      { href: 'https://www.linkedin.com/in/trghuyy/', label: 'LinkedIn', external: true },
      { href: 'https://github.com/hnguyenvutruong-maker/truonghuyresearch', label: 'Source code', external: true },
    ],
  },
];
---

<footer class="site-foot no-print">
  <div class="container site-foot__grid">
    <div class="site-foot__brand">
      <a class="brand" href="/" aria-label="Truong Huy Research home">
        <BrandMark />
        <span class="brand__name">Truong Huy <span>Research</span></span>
      </a>
      <p>
        Equity research on Vietnam-listed companies by Nguyen Vu Truong Huy · UEH Finance &amp; Banking · Passed Level II
        of the CFA Program. Valuations are ranges, every model is downloadable.
      </p>
      <p><a href="mailto:hnguyenvutruong@gmail.com">hnguyenvutruong@gmail.com</a></p>
    </div>
    {columns.map((c) => (
      <nav aria-label={c.title}>
        <h3>{c.title}</h3>
        <ul>
          {c.links.map((l) => (
            <li><a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}{l.external ? ' ↗' : ''}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="container site-foot__bar">
    <span>© {year} Nguyen Vu Truong Huy · Academic research, not investment advice · Prices are as of each model date, not live.</span>
    <nav aria-label="Legal">
      <a href="/disclaimer">Disclaimer</a>
      <a href="/sitemap-index.xml">Sitemap</a>
    </nav>
  </div>
</footer>
