---
import { portfolioDisclaimer } from '../../data/valuation-models';

const currentYear = new Date().getFullYear();
const links = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/trghuyy/', external: true },
  { label: 'CV', href: '/cv.pdf', external: true },
  { label: 'Contact', href: '/contact', external: false },
  { label: 'Disclaimer', href: '/disclaimer', external: false },
  { label: 'RSS', href: '/rss.xml', external: false },
];
---

<footer class="mt-auto w-full border-t border-chrome-line bg-chrome text-chrome-fg print:hidden">
  <div class="mx-auto grid w-full max-w-container-max grid-cols-1 gap-8 px-margin-mobile py-10 md:grid-cols-12 md:px-margin-desktop">
    <div class="space-y-3 md:col-span-8">
      <p class="font-display text-[1.375rem] font-extrabold tracking-tight">Truong Huy <span class="text-[#57D6C8]">Research</span></p>
      <p class="max-w-xl text-small text-chrome-fg/90">Vietnam equity research, valuation models, and market notes by Nguyen Vu Truong Huy.</p>
      <p class="max-w-xl text-[0.8125rem] leading-relaxed text-chrome-muted">{portfolioDisclaimer}</p>
      <p class="font-mono text-label uppercase text-chrome-muted">&copy; {currentYear} Nguyen Vu Truong Huy · Ho Chi Minh City</p>
    </div>
    <nav class="md:col-span-4 md:justify-self-end" aria-label="Footer">
      <ul class="flex flex-wrap gap-x-6 gap-y-3 md:flex-col md:items-end">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class="u-link font-mono text-[0.8125rem] text-chrome-fg transition-colors hover:text-white"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>
