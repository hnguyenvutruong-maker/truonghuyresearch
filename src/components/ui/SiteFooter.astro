---
// Institutional Colophon Footer: replaces the 100svh billboard close-word with a compact,
// authoritative research directory, recruiting availability banner, and disclosure bar.
import { portfolioDisclaimer, valuationModels } from '../../data/valuation-models';

const year = new Date().getFullYear();
---

<footer class="site-footer no-print" aria-labelledby="footer-mandate-h">
  <div class="footer-mandate">
    <div class="wrap footer-mandate__inner">
      <div>
        <span class="eyebrow">Recruiting &amp; Analyst Availability · Ho Chi Minh City</span>
        <h2 id="footer-mandate-h">Open to Equity Research, Investment Banking &amp; Capital Markets Roles</h2>
        <p class="t-small">
          Nguyen Vu Truong Huy · Passed Level II of the CFA Program · UEH Finance &amp; Banking (GPA 3.64 / 4.00)
        </p>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary" href="/cv.pdf" target="_blank" rel="noopener">
          Download the CV (PDF)
        </a>
        <a class="btn btn--secondary" href="/contact">
          Contact Dossier
        </a>
      </div>
    </div>
  </div>

  <div class="footer-main">
    <div class="wrap grid">
      <div class="span-5 stack-3">
        <a class="brand-lockup" href="/">
          <span class="brand-monogram" aria-hidden="true">TH</span>
          <span class="brand-text">
            <span class="brand-name text-inverse">Truong Huy Research</span>
          </span>
        </a>
        <p class="t-small text-inverse-muted">
          Independent Vietnam equity research portfolio featuring multi-method valuation models (FCFF DCF, Comparable Multiples, Precedent Transactions, Sponsor LBO), open Excel workbooks, one-page A4 tear sheets, and automated VN-Index market intelligence.
        </p>
      </div>

      <div class="span-3 footer-col">
        <h3>Company Reports</h3>
        <ul>
          {valuationModels.map((m) => (
            <li>
              <a href={`/research/${m.slug}`}>
                <span class="mono">{m.ticker}</span> — {m.company}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="span-2 footer-col">
        <h3>Methodologies</h3>
        <ul>
          <li><a href="/research">All Coverage Matrix</a></li>
          <li><a href="/research/dcf">Intrinsic DCF</a></li>
          <li><a href="/research/comparable-analysis">Comparable Multiples</a></li>
          <li><a href="/research/precedent-transactions-lbo">Precedent &amp; LBO</a></li>
        </ul>
      </div>

      <div class="span-2 footer-col">
        <h3>Intelligence &amp; Links</h3>
        <ul>
          <li><a href="/market-views">Weekly Market Notes</a></li>
          <li><a href="/monthly-views">Monthly Market Notes</a></li>
          <li><a href="/rss.xml">RSS Feed (Full HTML)</a></li>
          <li><a href="/contact">Contact Huy</a></li>
          <li><a href="https://www.linkedin.com/in/trghuyy/" target="_blank" rel="noopener">LinkedIn Profile</a></li>
          <li><a href="/disclaimer">Academic Disclaimer</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="wrap footer-legal">
    <span class="mono">&copy; {year} Nguyen Vu Truong Huy · truonghuyresearch.xyz</span>
    <span class="measure">{portfolioDisclaimer}</span>
  </div>
</footer>
