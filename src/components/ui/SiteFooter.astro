---
// footer.closing (Taste): row 1 the dealt close, close-word (the h2 and the main action, then the name set
// across the .wrap: the page's type moment), row 2 footer-columns and the legal row.
import { portfolioDisclaimer } from '../../data/valuation-models';

const year = new Date().getFullYear();
const columns = [
  { title: 'Research', links: [{ label: 'Coverage', href: '/research' }, { label: 'DCF', href: '/research/dcf' }, { label: 'Comparables', href: '/research/comparable-analysis' }, { label: 'Transactions and LBO', href: '/research/precedent-transactions-lbo' }] },
  { title: 'Notes', links: [{ label: 'All market notes', href: '/market-views' }, { label: 'Monthly notes', href: '/monthly-views' }, { label: 'RSS feed', href: '/rss.xml' }] },
  { title: 'Huy', links: [{ label: 'Contact', href: '/contact' }, { label: 'LinkedIn', href: 'https://www.linkedin.com/in/trghuyy/' }, { label: 'Disclaimer', href: '/disclaimer' }] },
];
---

<footer class="footer closing" id="contact" aria-labelledby="close-h">
  <div class="wrap">
    <div class="closing__cta close--word">
      <div class="section-head--split">
        <div>
          <h2 id="close-h">Download the CV</h2>
          <p class="t-lead">Open to equity research and investment banking internships in Ho Chi Minh City.</p>
        </div>
        <a class="btn btn--primary" href="/cv.pdf" target="_blank" rel="noopener">Download the CV<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
      </div>
      <p class="close__word" aria-hidden="true">Trường Huy</p>
    </div>
    <div class="closing__links">
      <div class="grid">
        <div class="span-6 stack-4">
          <a class="nav__logo" href="/"><span class="mark" data-mark="stack" aria-hidden="true"></span>Truong Huy<span class="logo-kind">&nbsp;Research</span></a>
          <p class="footer__lede">Valuation models and market notes on Vietnam-listed companies.</p>
        </div>
        {columns.map((column) => (
          <div class="span-2 footer__col">
            <h3>{column.title}</h3>
            <ul>{column.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
          </div>
        ))}
      </div>
      <div class="footer__legal">
        <span>&copy; {year} Nguyen Vu Truong Huy</span>
        <span>{portfolioDisclaimer}</span>
      </div>
    </div>
  </div>
</footer>
