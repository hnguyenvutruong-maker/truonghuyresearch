---
// Inner-page header: breadcrumb, eyebrow, serif title, lead, action slot and an optional aside (fact panel).
import Icon from './Icon.astro';

interface Crumb {
  href?: string;
  label: string;
}
interface Props {
  crumbs?: Crumb[];
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { crumbs = [], eyebrow, title, lead } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<header class="page-head">
  <div class="container">
    <div class:list={['page-head__grid', hasAside && 'page-head__grid--aside']}>
      <div>
        {crumbs.length > 0 && (
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/">Home</a>
            {crumbs.map((c) => (
              <>
                <Icon name="chevron_right" size={12} />
                {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
              </>
            ))}
          </nav>
        )}
        <slot name="before" />
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 class="display display-m">{title}</h1>
        {lead && <p class="lead">{lead}</p>}
        <slot />
      </div>
      {hasAside && <div><slot name="aside" /></div>}
    </div>
  </div>
</header>
