---
// The "research terminal" app window: sidebar of real destinations + the live coverage matrix.
import { getCollection } from 'astro:content';
import BrandMark from './BrandMark.astro';
import CoverageTable from './CoverageTable.astro';
import Icon from './Icon.astro';
import Ticker from './Ticker.astro';
import { valuationModels } from '../../data/valuation-models';
import { formatDate } from '../../lib/format';

interface Props {
  title?: string;
}
const { title = 'Vietnam equity coverage' } = Astro.props;

const weeklyCount = (await getCollection('market-views')).length;
const monthlyCount = (await getCollection('monthly-views')).length;
const files = valuationModels.reduce((t, m) => t + m.downloads.length, 0);
const asOf = formatDate(valuationModels[0].referencePrice.asOf);
---

<div class="window">
  <div class="window__body window__body--side">
    <aside class="window__side" aria-label="Research workspace">
      <div class="side-brand">
        <span><BrandMark class="" /> Truong Huy</span>
        <Icon name="sidebar" size={15} />
      </div>
      <button type="button" class="side-quick" data-cmd-open>
        <Icon name="search" size={14} /> Quick search <span class="kbd">⌘K</span>
      </button>
      <a class="side-link is-active" href="/research"><Icon name="home" /> Coverage</a>
      <a class="side-link" href="/market-views"><Icon name="book" /> Market notes <span class="side-meta">{weeklyCount + monthlyCount}</span></a>
      <a class="side-link" href="/market-views#foreign-flow"><Icon name="flow" /> Foreign flow</a>
      <a class="side-link" href="/research#files"><Icon name="file" /> Model files <span class="side-meta">{files}</span></a>

      <p class="side-label"><Icon name="chevron_down" size={12} /> Companies</p>
      {valuationModels.map((m) => (
        <a class="side-link" href={`/research/${m.slug}`}>
          <Ticker label={m.ticker} /> {m.company}
        </a>
      ))}

      <p class="side-label"><Icon name="chevron_down" size={12} /> Methods</p>
      <a class="side-link" href="/research/dcf"><Icon name="layers" /> DCF</a>
      <a class="side-link" href="/research/comparable-analysis"><Icon name="grid" /> Comparables</a>
      <a class="side-link" href="/research/precedent-transactions-lbo"><Icon name="table" /> Precedent &amp; LBO</a>
    </aside>

    <div class="window__main">
      <div class="window__bar">
        <span class="window__title">{title} <Icon name="star" size={13} /></span>
        <span class="window__actions" aria-hidden="true">
          <Icon name="plus" size={15} />
          <Icon name="sidebar" size={15} />
          <Icon name="dots" size={15} />
        </span>
      </div>
      <div class="window__head">
        <span class="window__h">Valuation monitor <Icon name="chevron_down" size={14} /></span>
        <span class="row">
          <a class="btn btn--secondary btn--sm" href="/research#comparator">Method spread</a>
          <a class="btn btn--secondary btn--sm" href="/research#files">Download models</a>
        </span>
      </div>
      <CoverageTable label="Sorted by ticker" />
      <div class="window__foot">
        <span>{valuationModels.length} companies · {files} Excel workbooks</span>
        <span>Implied moves vs. the price each model used ({asOf})</span>
      </div>
    </div>
  </div>
</div>
