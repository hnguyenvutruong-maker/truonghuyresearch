---
// Market-note index: one ruled list per year, newest first; the All / Weekly / Monthly filter is synced to ?kind=.
import { formatIndex, signedPct } from '../../lib/format';
import type { NoteSummary } from '../../lib/notes';
interface Props { notes: NoteSummary[]; filter?: boolean }
const { notes, filter = false } = Astro.props;
const sorted = [...notes].sort((a, b) => b.date.valueOf() - a.date.valueOf());
const years = [...new Set(sorted.map((n) => n.date.getUTCFullYear()))];
const filters = [
  { key: 'all', label: 'All notes', count: notes.length },
  { key: 'weekly', label: 'Weekly', count: notes.filter((n) => n.kind === 'Weekly').length },
  { key: 'monthly', label: 'Monthly', count: notes.filter((n) => n.kind === 'Monthly').length },
];
---
<div data-note-list class="stack-6">
  {filter && (
    <div class="filter" role="group" aria-label="Filter notes">
      {filters.map((f, i) => <button type="button" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label} <span class="muted">{f.count}</span></button>)}
    </div>
  )}
  {years.map((year) => (
    <section data-year aria-labelledby={`y-${year}`}>
      <div class="section-head--row"><h2 id={`y-${year}`}>{year}</h2><span class="t-label muted" data-year-count></span></div>
      <ol class="notelist">
        {sorted.filter((n) => n.date.getUTCFullYear() === year).map((n) => (
          <li data-kind={n.kind.toLowerCase()}>
            <a href={n.href}>
              <span class="t-label muted">{n.kind} · {n.period}</span>
              <h3>{n.headline}</h3>
              <span class="num t-small">{formatIndex(n.close)} <span class:list={[n.change >= 0 ? 'up' : 'down']}>{signedPct(n.change)}</span></span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  ))}
</div>
<script>
  const root = document.querySelector<HTMLElement>('[data-note-list]');
  const buttons = Array.from(root?.querySelectorAll<HTMLButtonElement>('button[data-filter]') ?? []);
  const apply = (kind: string) => {
    if (!root) return;
    root.querySelectorAll<HTMLElement>('li[data-kind]').forEach((li) => { li.hidden = kind !== 'all' && li.dataset.kind !== kind; });
    root.querySelectorAll<HTMLElement>('[data-year]').forEach((sec) => {
      const n = sec.querySelectorAll('li[data-kind]:not([hidden])').length;
      sec.hidden = n === 0;
      const label = sec.querySelector('[data-year-count]');
      if (label) label.textContent = `${n} note${n === 1 ? '' : 's'}`;
    });
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === kind)));
  };
  buttons.forEach((b) => b.addEventListener('click', () => {
    const kind = b.dataset.filter ?? 'all';
    apply(kind);
    const url = new URL(window.location.href);
    if (kind === 'all') url.searchParams.delete('kind'); else url.searchParams.set('kind', kind);
    history.replaceState(null, '', url);
  }));
  const initial = new URLSearchParams(window.location.search).get('kind');
  apply(initial === 'weekly' || initial === 'monthly' ? initial : 'all');
</script>
