---
// Market-note index: grouped by year, newest first, with All / Weekly / Monthly filter tabs
// synced to ?kind= AND an instant keyword search filter.
import { formatIndex, signedPct } from '../../lib/format';
import type { NoteSummary } from '../../lib/notes';

interface Props {
  notes: NoteSummary[];
  filter?: boolean;
}
const { notes, filter = false } = Astro.props;
const sorted = [...notes].sort((a, b) => b.date.valueOf() - a.date.valueOf());
const years = [...new Set(sorted.map((n) => n.date.getUTCFullYear()))];
const filters = [
  { key: 'all', label: 'All', count: notes.length },
  { key: 'weekly', label: 'Weekly', count: notes.filter((n) => n.kind === 'Weekly').length },
  { key: 'monthly', label: 'Monthly', count: notes.filter((n) => n.kind === 'Monthly').length },
];
---

<div data-note-list>
  {filter && (
    <div class="row row--between">
      <div class="seg" role="group" aria-label="Filter notes by frequency">
        {filters.map((f, i) => (
          <button type="button" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.label} <span class="count">{f.count}</span>
          </button>
        ))}
      </div>
      <input type="search" class="search-input" data-note-search placeholder="Filter by headline, month or sector…" aria-label="Filter market notes by keyword" />
    </div>
  )}

  {years.map((year) => (
    <section data-year aria-labelledby={`y-${year}`}>
      <div class="year-head">
        <h2 id={`y-${year}`}>{year}</h2>
        <span class="mono xsmall muted" data-year-count></span>
      </div>
      <ol class="notelist">
        {sorted
          .filter((n) => n.date.getUTCFullYear() === year)
          .map((n) => (
            <li data-kind={n.kind.toLowerCase()} data-search={`${n.kind} ${n.period} ${n.headline} ${n.slug}`.toLowerCase()}>
              <a href={n.href}>
                <span class="notelist__when">
                  <span class:list={['tag', n.kind === 'Monthly' ? 'tag--violet' : 'tag--blue']}>{n.kind}</span>
                  <span class="mono">{n.period}</span>
                </span>
                <span class="notelist__title">{n.headline}</span>
                <span class="notelist__fig">
                  <span class="num">{formatIndex(n.close)}</span>
                  <span class:list={['tag', 'tag--mono', n.change >= 0 ? 'tag--up' : 'tag--down']}>{signedPct(n.change)}</span>
                </span>
              </a>
            </li>
          ))}
      </ol>
    </section>
  ))}
  <p class="small muted" data-note-empty hidden>No notes match that filter.</p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-note-list]');
  const buttons = Array.from(root?.querySelectorAll<HTMLButtonElement>('button[data-filter]') ?? []);
  const searchInput = root?.querySelector<HTMLInputElement>('[data-note-search]');

  let currentKind = 'all';

  const apply = () => {
    if (!root) return;
    const q = (searchInput?.value ?? '').trim().toLowerCase();

    root.querySelectorAll<HTMLElement>('li[data-kind]').forEach((li) => {
      const kindMatch = currentKind === 'all' || li.dataset.kind === currentKind;
      const textMatch = !q || (li.dataset.search ?? '').includes(q);
      li.hidden = !(kindMatch && textMatch);
    });

    root.querySelectorAll<HTMLElement>('[data-year]').forEach((sec) => {
      const n = sec.querySelectorAll('li[data-kind]:not([hidden])').length;
      sec.hidden = n === 0;
      const label = sec.querySelector('[data-year-count]');
      if (label) label.textContent = `${n} note${n === 1 ? '' : 's'}`;
    });

    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === currentKind)));
    const empty = root.querySelector<HTMLElement>('[data-note-empty]');
    if (empty) empty.hidden = root.querySelectorAll('li[data-kind]:not([hidden])').length > 0;
  };

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      currentKind = b.dataset.filter ?? 'all';
      apply();
      const url = new URL(window.location.href);
      if (currentKind === 'all') url.searchParams.delete('kind');
      else url.searchParams.set('kind', currentKind);
      history.replaceState(null, '', url);
    })
  );

  searchInput?.addEventListener('input', apply);

  const initial = new URLSearchParams(window.location.search).get('kind');
  currentKind = initial === 'weekly' || initial === 'monthly' ? initial : 'all';
  apply();
</script>
