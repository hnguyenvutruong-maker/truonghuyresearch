---
// Valuation Method Spread & Implied Upside/Downside Analyzer:
// Breaks down why different valuation methods diverge for each company ("where methods disagree, the spread is the finding").
import Ticker from './Ticker.astro';
import { formatOutput, impliedMovePct, outputMethodLabel, valuationModels } from '../../data/valuation-models';
import { formatVndK, signedPct } from '../../lib/format';

const items = valuationModels.map((m) => {
  const ref = m.referencePrice;
  const outputs = m.outputs.map((o) => ({
    ...o,
    label: outputMethodLabel[o.method],
    formatted: formatOutput(o),
    move: impliedMovePct(o, ref),
  }));
  const moves = outputs.map((o) => o.move);
  const lowMove = Math.min(...moves);
  const highMove = Math.max(...moves);
  const spreadPts = Math.abs(highMove - lowMove);
  const whyDiffer =
    m.report.assumptions.find((a) => a.label.toLowerCase().includes('differ') || a.label.toLowerCase().includes('range'))?.detail ??
    m.conclusion;
  return {
    model: m,
    outputs,
    lowMove,
    highMove,
    spreadPts,
    whyDiffer,
  };
});
---

<div class="table-scroll" tabindex="0" role="region" aria-label="Method spread by company, scrolls horizontally">
  <table class="dtable dtable--pin">
    <thead>
      <tr>
        <th scope="col">Company</th>
        <th scope="col">Method</th>
        <th scope="col" class="r">Output, VND</th>
        <th scope="col" class="r">vs. price used</th>
        <th scope="col">What the range spans</th>
      </tr>
    </thead>
    <tbody>
      {items.map(({ model, outputs, spreadPts, whyDiffer }) => (
        <>
          {outputs.map((o, i) => (
            <tr>
              <th scope="row">
                {i === 0 ? (
                  <a class="cell-co" href={`/research/${model.slug}`}><Ticker label={model.ticker} /> {formatVndK(model.referencePrice.value)}</a>
                ) : (
                  <span class="sr-only">{model.ticker}</span>
                )}
              </th>
              <td>{o.label}</td>
              <td class="r">{o.formatted}</td>
              <td class="r"><span class:list={['tag', o.move >= 0 ? 'tag--up' : 'tag--down']}>{signedPct(o.move, 1)}</span></td>
              <td class="wrap">{o.basis}</td>
            </tr>
          ))}
          <tr class="subtotal">
            <th scope="row"><span class="sr-only">{model.ticker}</span></th>
            <td>{outputs.length > 1 ? 'Method spread' : 'Single method'}</td>
            <td class="r">{outputs.length > 1 ? `${spreadPts.toFixed(1)} pts` : '—'}</td>
            <td></td>
            <td class="wrap">{whyDiffer}</td>
          </tr>
        </>
      ))}
    </tbody>
  </table>
</div>
