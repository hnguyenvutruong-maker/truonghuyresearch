---
// Valuation Method Spread & Implied Upside/Downside Analyzer:
// Breaks down why different valuation methods diverge for each company ("where methods disagree, the spread is the finding").
import Ticker from './Ticker.astro';
import { formatOutput, impliedMovePct, outputMethodLabel, valuationModels } from '../../data/valuation-models';
import { formatVndK, signedPct } from '../../lib/format';

const items = valuationModels.map((m) => {
  const ref = m.referencePrice;
  const outputs = m.outputs.map((o) => ({
    ...o,
    label: outputMethodLabel[o.method],
    formatted: formatOutput(o),
    move: impliedMovePct(o, ref),
  }));
  const moves = outputs.map((o) => o.move);
  const lowMove = Math.min(...moves);
  const highMove = Math.max(...moves);
  const spreadPts = Math.abs(highMove - lowMove);
  const whyDiffer =
    m.report.assumptions.find((a) => a.label.toLowerCase().includes('differ') || a.label.toLowerCase().includes('range'))?.detail ??
    m.conclusion;
  return {
    model: m,
    outputs,
    lowMove,
    highMove,
    spreadPts,
    whyDiffer,
  };
});
---

<div class="grid-2">
  {items.map(({ model, outputs, spreadPts, whyDiffer }) => (
    <article class="card stack-4">
      <div class="row row--between">
        <a href={`/research/${model.slug}`} class="cell-co">
          <Ticker label={model.ticker} size="lg" />
          <span>
            {model.ticker} · {model.company}
            <span class="cell-co__sub">{model.sector} · price used {formatVndK(model.referencePrice.value)}</span>
          </span>
        </a>
        <span class="tag tag--mono">{outputs.length > 1 ? `Spread ${spreadPts.toFixed(1)} pts` : 'Single method'}</span>
      </div>
      <p class="small text-2">{model.investmentQuestion ?? model.report.headline}</p>
      <table class="dtable dtable--compact">
        <tbody>
          {outputs.map((o) => (
            <tr>
              <th scope="row"><span class="ff-detail-row__label"><i class:list={['legend-dot', `l-${o.method.toLowerCase()}`]}></i>{o.label}</span><span class="cell-co__sub">{o.basis}</span></th>
              <td class="r"><span class="cell-stack"><span class="num">{o.formatted}</span><span class:list={['num', 'xsmall', o.move >= 0 ? 'up' : 'down']}>{signedPct(o.move, 1)}</span></span></td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="small muted">{whyDiffer}</p>
      <div class="btn-row">
        <a class="btn btn--secondary btn--sm" href={`/research/${model.slug}`}>Read {model.ticker} report</a>
        <a class="btn btn--ghost btn--sm" href={`/research/${model.slug}/tear-sheet`}>A4 tear sheet</a>
      </div>
    </article>
  ))}
</div>
