---
// Coverage table: issuer, price used, each method's output with its implied move, and the
// low / high move across methods. With `sortable`, column headings sort the rows (data-*
// attributes carry the sort keys; missing values always sink to the bottom).
import Ticker from './Ticker.astro';
import { formatOutput, impliedMovePct, valuationModels, type OutputMethod } from '../../data/valuation-models';
import { formatVndK, signedPct } from '../../lib/format';

interface Props {
  sortable?: boolean;
}

const { sortable = false } = Astro.props;

const columns: Array<{ method: OutputMethod; label: string }> = [
  { method: 'DCF', label: 'DCF' },
  { method: 'Comparable', label: 'Comparables' },
  { method: 'Precedent', label: 'Precedent' },
  { method: 'LBO', label: 'LBO' },
];

const rows = [...valuationModels]
  .sort((a, b) => a.ticker.localeCompare(b.ticker))
  .map((model) => {
    const moves = model.outputs.map((output) => impliedMovePct(output, model.referencePrice));
    const byMethod = Object.fromEntries(
      model.outputs.map((output) => [output.method, { text: formatOutput(output), move: impliedMovePct(output, model.referencePrice) }])
    ) as Partial<Record<OutputMethod, { text: string; move: number }>>;
    return { model, byMethod, low: Math.min(...moves), high: Math.max(...moves) };
  });

const heads = [
  { key: 'price', label: 'Price used' },
  ...columns.map((column) => ({ key: column.method.toLowerCase(), label: column.label })),
  { key: 'low', label: 'Low move' },
  { key: 'high', label: 'High move' },
];
const thClass = 't-label border-b border-line-strong px-3 py-3 text-ink-muted';
const sortClass = 'inline-flex min-h-6 cursor-pointer items-center gap-1 text-ink-muted transition-colors hover:text-action';
---

<div class="overflow-x-auto" tabindex="0" role="region" aria-label="Coverage table, scrolls sideways on small screens">
  <table class="w-full min-w-[54rem] border-collapse" data-sortable={sortable ? '' : undefined}>
    <caption class="sr-only">Valuation coverage in VND per share, with implied moves against the price each model used</caption>
    <thead>
      <tr>
        <th scope="col" class:list={[thClass, 'sticky left-0 z-10 bg-ground-card text-left']} aria-sort={sortable ? 'ascending' : undefined}>
          {sortable ? (
            <button type="button" data-sort="ticker" data-type="text" class={sortClass}>Company <span data-arrow aria-hidden="true">↑</span></button>
          ) : 'Company'}
        </th>
        {heads.map((head) => (
          <th scope="col" class:list={[thClass, 'text-right']} aria-sort={sortable ? 'none' : undefined}>
            {sortable ? (
              <button type="button" data-sort={head.key} class={sortClass}>{head.label} <span data-arrow aria-hidden="true"></span></button>
            ) : head.label}
          </th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr
          class="group border-b border-line transition-colors hover:bg-ground"
          data-ticker={row.model.ticker}
          data-price={row.model.referencePrice.value}
          data-low={row.low}
          data-high={row.high}
          {...Object.fromEntries(columns.map((column) => [`data-${column.method.toLowerCase()}`, row.byMethod[column.method]?.move ?? '']))}
        >
          <th scope="row" class="sticky left-0 z-10 bg-ground-card px-3 py-4 text-left font-normal transition-colors group-hover:bg-ground">
            <a href={`/research/${row.model.slug}`} class="flex items-center gap-3 no-underline">
              <Ticker label={row.model.ticker} />
              <span class="hidden sm:block">
                <span class="block font-medium text-ink transition-colors group-hover:text-action">{row.model.company}</span>
                <span class="t-label block text-ink-muted">{row.model.sector}</span>
              </span>
            </a>
          </th>
          <td class="t-data px-3 py-4 text-right text-ink">{formatVndK(row.model.referencePrice.value)}</td>
          {columns.map((column) => {
            const cell = row.byMethod[column.method];
            return (
              <td class="px-3 py-4 text-right align-top">
                {cell ? (
                  <>
                    <span class="t-data block whitespace-nowrap font-medium text-ink">{cell.text}</span>
                    <span class:list={['pill mt-1.5', cell.move >= 0 ? 'pill--up' : 'pill--down']}>{signedPct(cell.move, 1)}</span>
                  </>
                ) : (
                  <span class="text-ink-muted" aria-label="Not used">—</span>
                )}
              </td>
            );
          })}
          <td class:list={['t-data px-3 py-4 text-right', row.low >= 0 ? 'text-up' : 'text-down']}>{signedPct(row.low, 1)}</td>
          <td class:list={['t-data px-3 py-4 text-right', row.high >= 0 ? 'text-up' : 'text-down']}>{signedPct(row.high, 1)}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<script>
  // Sort any coverage table marked data-sortable; numeric keys sort high → low first.
  document.querySelectorAll<HTMLTableElement>('table[data-sortable]').forEach((table) => {
    const body = table.tBodies[0];
    const buttons = Array.from(table.querySelectorAll<HTMLButtonElement>('button[data-sort]'));
    let current = { key: 'ticker', dir: 1 };

    const sortBy = (key: string, isText: boolean) => {
      const dir = current.key === key ? -current.dir : isText ? 1 : -1;
      current = { key, dir };
      Array.from(body.rows)
        .sort((a, b) => {
          const av = a.dataset[key] ?? '';
          const bv = b.dataset[key] ?? '';
          if (isText) return av.localeCompare(bv) * dir;
          if (av === '' && bv === '') return 0;
          if (av === '') return 1;
          if (bv === '') return -1;
          return (Number(av) - Number(bv)) * dir;
        })
        .forEach((row) => body.appendChild(row));
      buttons.forEach((button) => {
        const active = button.dataset.sort === key;
        button.closest('th')?.setAttribute('aria-sort', active ? (dir === 1 ? 'ascending' : 'descending') : 'none');
        const arrow = button.querySelector('[data-arrow]');
        if (arrow) arrow.textContent = active ? (dir === 1 ? '↑' : '↓') : '';
      });
    };

    buttons.forEach((button) => button.addEventListener('click', () => sortBy(button.dataset.sort ?? 'ticker', button.dataset.type === 'text')));
  });
</script>
