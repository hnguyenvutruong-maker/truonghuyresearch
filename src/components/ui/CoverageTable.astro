---
// Coverage matrix: method filter chips + sortable columns (aria-sort), one row per company.
import Ticker from './Ticker.astro';
import Icon from './Icon.astro';
import { formatOutput, impliedMovePct, valuationModels, type OutputMethod } from '../../data/valuation-models';
import { formatVndK, signedPct } from '../../lib/format';

interface Props {
  /** Optional caption shown in the toolbar row. */
  label?: string;
}
const { label = 'Sorted by ticker' } = Astro.props;

const columns: Array<{ method: OutputMethod; label: string }> = [
  { method: 'DCF', label: 'DCF' },
  { method: 'Comparable', label: 'Comparables' },
  { method: 'Precedent', label: 'Precedent' },
  { method: 'LBO', label: 'LBO' },
];
const sectorTag = ['tag--blue', 'tag--teal', 'tag--violet', 'tag--amber', 'tag--up'];

const rows = [...valuationModels]
  .sort((a, b) => a.ticker.localeCompare(b.ticker))
  .map((model) => {
    const moves = model.outputs.map((o) => impliedMovePct(o, model.referencePrice));
    const by = Object.fromEntries(
      model.outputs.map((o) => [o.method, { text: formatOutput(o), move: impliedMovePct(o, model.referencePrice) }])
    ) as Partial<Record<OutputMethod, { text: string; move: number }>>;
    const groups = [...new Set(model.valuationNotes.flatMap((n) => n.groups))];
    const low = Math.min(...moves);
    const high = Math.max(...moves);
    const signal =
      low > 0
        ? { text: 'All methods above', cls: 'signal--up' }
        : high < 0
          ? { text: 'All methods below', cls: 'signal--down' }
          : { text: 'Straddles price', cls: 'signal--amber' };
    return { model, by, groups, low, high, signal, sectorIdx: valuationModels.indexOf(model) % sectorTag.length };
  });

const count = (g: string) => rows.filter((r) => r.groups.includes(g as never)).length;
const heads = [
  { key: 'price', label: 'Price used', r: true },
  ...columns.map((c) => ({ key: c.method.toLowerCase(), label: c.label, r: true })),
  { key: 'low', label: 'Low move', r: true },
  { key: 'high', label: 'High move', r: true },
];
---

<div data-coverage-root>
  <div class="toolbar" role="group" aria-label="Filter companies by valuation method">
    <span class="chip" aria-hidden="true"><Icon name="sort" /> <span data-sort-label>{label}</span></span>
    <button type="button" class="chip" data-cov-filter="all" aria-pressed="true">All <span class="count">{rows.length}</span></button>
    <button type="button" class="chip" data-cov-filter="dcf" aria-pressed="false">DCF <span class="count">{count('dcf')}</span></button>
    <button type="button" class="chip" data-cov-filter="comparable" aria-pressed="false">Comparables <span class="count">{count('comparable')}</span></button>
    <button type="button" class="chip" data-cov-filter="transaction-lbo" aria-pressed="false">Precedent &amp; LBO <span class="count">{count('transaction-lbo')}</span></button>
  </div>

  <div class="table-scroll" tabindex="0" role="region" aria-label="Coverage table, scrolls horizontally">
    <table class="dtable" data-sortable>
      <caption class="sr-only">Valuation coverage in VND per share, with implied moves against the price each model used</caption>
      <thead>
        <tr>
          <th scope="col" aria-sort="ascending">
            <button type="button" class="sort" data-sort="ticker" data-type="text">Company <span data-arrow aria-hidden="true">↑</span></button>
          </th>
          <th scope="col">Sector</th>
          {heads.map((h) => (
            <th scope="col" aria-sort="none" class={h.r ? 'r' : undefined}>
              <button type="button" class="sort" data-sort={h.key}>{h.label} <span data-arrow aria-hidden="true">↕</span></button>
            </th>
          ))}
          <th scope="col">Signal</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr
            data-cov-row
            data-groups={r.groups.join(' ')}
            data-ticker={r.model.ticker}
            data-price={r.model.referencePrice.value}
            data-low={r.low}
            data-high={r.high}
            {...Object.fromEntries(columns.map((c) => [`data-${c.method.toLowerCase()}`, r.by[c.method]?.move ?? '']))}
          >
            <th scope="row">
              <span class="cell-co">
                <Ticker label={r.model.ticker} />
                <a href={`/research/${r.model.slug}`}>
                  {r.model.ticker}
                  <span class="cell-co__sub">{r.model.company}</span>
                </a>
              </span>
            </th>
            <td><span class:list={['tag', sectorTag[r.sectorIdx]]}>{r.model.sector}</span></td>
            <td class="r num">{formatVndK(r.model.referencePrice.value)}</td>
            {columns.map((c) => {
              const cell = r.by[c.method];
              return (
                <td class="r">
                  {cell ? (
                    <span class="cell-stack">
                      <span class="num">{cell.text}</span>
                      <span class:list={['num', 'xsmall', cell.move >= 0 ? 'up' : 'down']}>{signedPct(cell.move, 1)}</span>
                    </span>
                  ) : (
                    <span class="muted">—</span>
                  )}
                </td>
              );
            })}
            <td class="r"><span class:list={['tag', 'tag--mono', r.low >= 0 ? 'tag--up' : 'tag--down']}>{signedPct(r.low, 1)}</span></td>
            <td class="r"><span class:list={['tag', 'tag--mono', r.high >= 0 ? 'tag--up' : 'tag--down']}>{signedPct(r.high, 1)}</span></td>
            <td><span class:list={['signal', r.signal.cls]}>{r.signal.text}</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-coverage-root]').forEach((root) => {
    const filterButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-cov-filter]'));
    const tableRows = Array.from(root.querySelectorAll<HTMLTableRowElement>('[data-cov-row]'));
    const sortLabel = root.querySelector<HTMLElement>('[data-sort-label]');

    filterButtons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const group = btn.dataset.covFilter ?? 'all';
        filterButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        tableRows.forEach((row) => {
          row.hidden = group !== 'all' && !(row.dataset.groups ?? '').split(/\s+/).includes(group);
        });
      })
    );

    const table = root.querySelector<HTMLTableElement>('table[data-sortable]');
    if (!table) return;
    const body = table.tBodies[0];
    const buttons = Array.from(table.querySelectorAll<HTMLButtonElement>('button[data-sort]'));
    let current = { key: 'ticker', dir: 1 };

    const sortBy = (btn: HTMLButtonElement) => {
      const key = btn.dataset.sort ?? 'ticker';
      const isText = btn.dataset.type === 'text';
      const dir = current.key === key ? -current.dir : isText ? 1 : -1;
      current = { key, dir };
      Array.from(body.rows)
        .sort((a, b) => {
          const av = a.dataset[key] ?? '';
          const bv = b.dataset[key] ?? '';
          if (isText) return av.localeCompare(bv) * dir;
          if (av === '' && bv === '') return 0;
          if (av === '') return 1;
          if (bv === '') return -1;
          return (Number(av) - Number(bv)) * dir;
        })
        .forEach((row) => body.appendChild(row));
      buttons.forEach((b) => {
        const active = b === btn;
        b.closest('th')?.setAttribute('aria-sort', active ? (dir === 1 ? 'ascending' : 'descending') : 'none');
        const arrow = b.querySelector('[data-arrow]');
        if (arrow) arrow.textContent = active ? (dir === 1 ? '↑' : '↓') : '↕';
      });
      if (sortLabel) sortLabel.textContent = `Sorted by ${(btn.textContent ?? '').replace(/[↑↓↕]/g, '').trim().toLowerCase()}`;
    };
    buttons.forEach((b) => b.addEventListener('click', () => sortBy(b)));
  });
</script>
