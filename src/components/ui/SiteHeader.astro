---
// nav-split (dealt): the words on the left line, the name in the middle, the one main action on the
// right line. No hover panel (nav-split's panel holds photograph cards, and the site has none).
// On a phone system.js turns the bar into the full-screen sheet behind .nav__toggle.
const links = [
  { label: 'Research', href: '/research', match: (p: string) => p.startsWith('/research') && !/^\/research\/(dcf|comparable|precedent)/.test(p) },
  { label: 'Methods', href: '/research/dcf', match: (p: string) => /^\/research\/(dcf|comparable|precedent)/.test(p) },
  { label: 'Notes', href: '/market-views', match: (p: string) => p.startsWith('/market-views') || p.startsWith('/monthly-views') },
  { label: 'Contact', href: '/contact', match: (p: string) => p.startsWith('/contact') },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="nav nav--split">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Skip to content</a>
    <a class="nav__logo" href="/"><span class="mark" data-mark="stack" aria-hidden="true"></span>Truong Huy<span class="logo-kind">&nbsp;Research</span></a>
    <nav class="nav__links" aria-label="Main">
      {links.map((link) => (
        <div class="nav__item"><a class="nav__link" href={link.href} aria-current={link.match(path) ? 'page' : undefined}>{link.label}</a></div>
      ))}
    </nav>
    <div class="nav__actions">
      <a class="btn btn--primary" href="/cv.pdf" target="_blank" rel="noopener">Download the CV</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menu">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
  </div>
</header>
