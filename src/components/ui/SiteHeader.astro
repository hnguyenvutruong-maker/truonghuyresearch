---
// Fixed, opaque header with a hairline (Taste system.md, Nav): the wordmark on the left
// content line, five one-word nouns, and the one main action as the only filled button.
// Under 1024px the nouns move into a full-screen sheet behind the menu button.
import Icon from './Icon.astro';

const links = [
  { label: 'Research', href: '/research', match: (p: string) => p === '/research' || /^\/research\/(?!dcf|comparable|precedent)/.test(p) },
  { label: 'Methods', href: '/research/dcf', match: (p: string) => /^\/research\/(dcf|comparable|precedent)/.test(p) },
  { label: 'Notes', href: '/market-views', match: (p: string) => p.startsWith('/market-views') || p.startsWith('/monthly-views') },
  { label: 'About', href: '/#about', match: () => false },
  { label: 'Contact', href: '/contact', match: (p: string) => p.startsWith('/contact') },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-nav">
  <div class="wrap">
    <a class="skip-link" href="#main">Skip to content</a>
    <a href="/" class="brand" aria-label="Truong Huy Research, home">
      <span class="brand__name">Truong Huy</span><span class="brand__kind">Research</span>
    </a>
    <nav aria-label="Primary" class="ml-auto hidden lg:block">
      <ul class="nav-links">
        {links.map((link) => (
          <li><a href={link.href} aria-current={link.match(path) ? 'page' : undefined}>{link.label}</a></li>
        ))}
      </ul>
    </nav>
    <a href="/cv.pdf" class="btn btn--primary nav-cta" target="_blank" rel="noopener">Download the CV</a>
    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-sheet" aria-label="Open the menu" data-nav-toggle>
      <span data-icon-open><Icon name="menu" size={22} /></span>
      <span data-icon-close hidden><Icon name="close" size={22} /></span>
    </button>
  </div>
</header>

<div id="nav-sheet" class="nav-sheet" data-nav-sheet>
  <nav aria-label="Menu" class="wrap py-4">
    {links.map((link) => <a href={link.href} aria-current={link.match(path) ? 'page' : undefined}>{link.label}</a>)}
    <a href="/disclaimer">Disclaimer</a>
    <div class="pt-6"><a href="/cv.pdf" class="btn btn--primary w-full" target="_blank" rel="noopener">Download the CV</a></div>
  </nav>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const sheet = document.querySelector<HTMLElement>('[data-nav-sheet]');
  const setOpen = (open: boolean) => {
    if (!toggle || !sheet) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close the menu' : 'Open the menu');
    toggle.querySelector<HTMLElement>('[data-icon-open]')!.hidden = open;
    toggle.querySelector<HTMLElement>('[data-icon-close]')!.hidden = !open;
    sheet.toggleAttribute('data-open', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  sheet?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => event.matches && setOpen(false));
</script>
