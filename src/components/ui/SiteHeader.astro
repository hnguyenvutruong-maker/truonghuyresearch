---
// Floating pill navigation: brand, primary research sections, ⌘K search, light/dark switch, CTA, mobile drawer.
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isMethod = ['/research/dcf', '/research/comparable-analysis', '/research/precedent-transactions-lbo'].some((p) =>
  path.startsWith(p)
);

const links = [
  { href: '/research', label: 'Research', hint: '5 companies', active: path.startsWith('/research') && !isMethod },
  { href: '/research/dcf', label: 'Methods', hint: 'DCF · Comps · LBO', active: isMethod },
  {
    href: '/market-views',
    label: 'Market notes',
    hint: 'Weekly & monthly',
    active: path.startsWith('/market-views') || path.startsWith('/monthly-views'),
  },
  { href: '/contact', label: 'About', hint: 'Profile & contact', active: path.startsWith('/contact') },
];
---

<div class="site-nav no-print" data-site-nav>
  <header class="nav-bar">
    <a class="brand" href="/" aria-label="Truong Huy Research home">
      <BrandMark />
      <span>Truong Huy <span class="brand__sub">Research</span></span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav-links">
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={l.active ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav-actions">
      <button type="button" class="nav-search" data-cmd-open aria-label="Search research, tickers and notes">
        <Icon name="search" size={14} />
        <span>Search research…</span>
        <kbd>⌘K</kbd>
      </button>
      <button type="button" class="nav-search__icon" data-cmd-open aria-label="Search research, tickers and notes">
        <Icon name="search" />
      </button>
      <div class="theme-switch" role="group" aria-label="Colour theme">
        <button type="button" data-theme-set="light" aria-pressed="false" aria-label="Light theme">
          <Icon name="sun" size={14} />
        </button>
        <button type="button" data-theme-set="dark" aria-pressed="true" aria-label="Dark theme">
          <Icon name="moon" size={14} />
        </button>
      </div>
      <a class="btn btn--primary btn--sm nav-cta" href="/research">View coverage</a>
      <button type="button" class="nav-menu-btn" data-nav-toggle aria-expanded="false" aria-controls="nav-drawer" aria-label="Open menu">
        <Icon name="menu" size={18} class="icon-open" />
        <Icon name="close" size={18} class="icon-close" />
      </button>
    </div>
  </header>

  <nav class="nav-drawer" id="nav-drawer" aria-label="Mobile">
    {links.map((l) => (
      <a href={l.href} aria-current={l.active ? 'page' : undefined}>
        {l.label}
        <span>{l.hint}</span>
      </a>
    ))}
    <div class="nav-drawer__foot">
      <button type="button" class="btn btn--secondary btn--sm" data-cmd-open>
        <Icon name="search" size={14} /> Search
      </button>
      <a class="btn btn--primary btn--sm" href="/cv.pdf" target="_blank" rel="noopener">Download CV</a>
    </div>
  </nav>
</div>
