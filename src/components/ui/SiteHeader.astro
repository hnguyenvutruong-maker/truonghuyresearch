---
const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const isAbout = pathname.startsWith('/contact');
const isMethods =
  pathname.startsWith('/research/dcf') ||
  pathname.startsWith('/research/comparable-analysis') ||
  pathname.startsWith('/research/precedent-transactions-lbo');
const isResearch = pathname.startsWith('/research') && !isMethods;
const isMarketNotes = pathname.startsWith('/market-views') || pathname.startsWith('/monthly-views');
---

<header class="once-header no-print" data-border="rounded">
  <div class="once-header-left">
    <span>Asia/Ho_Chi_Minh</span>
  </div>

  <div class="once-header-center">
    <nav class="once-dock" aria-label="Primary navigation">
      <a
        class:list={['once-toggle-btn', 'is-icon-only', isHome && 'is-selected']}
        href="/"
        aria-label="Home"
        aria-current={isHome ? 'page' : undefined}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
          <polyline points="9 22 9 12 15 12 15 22" />
        </svg>
      </a>

      <span class="once-dock-divider" aria-hidden="true"></span>

      <a
        class:list={['once-toggle-btn', isAbout && 'is-selected']}
        href="/contact"
        aria-current={isAbout ? 'page' : undefined}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="8" r="4" />
          <path d="M20 21a8 8 0 0 0-16 0" />
        </svg>
        <span class="once-toggle-label">About</span>
      </a>

      <a
        class:list={['once-toggle-btn', isResearch && 'is-selected']}
        href="/research"
        aria-current={isResearch ? 'page' : undefined}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="7" height="7" x="3" y="3" rx="1" />
          <rect width="7" height="7" x="14" y="3" rx="1" />
          <rect width="7" height="7" x="14" y="14" rx="1" />
          <rect width="7" height="7" x="3" y="14" rx="1" />
        </svg>
        <span class="once-toggle-label">Work</span>
      </a>

      <a
        class:list={['once-toggle-btn', isMarketNotes && 'is-selected']}
        href="/market-views"
        aria-current={isMarketNotes ? 'page' : undefined}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20" />
        </svg>
        <span class="once-toggle-label">Blog</span>
      </a>

      <a
        class:list={['once-toggle-btn', isMethods && 'is-selected']}
        href="/research/dcf"
        aria-current={isMethods ? 'page' : undefined}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="18" height="18" x="3" y="3" rx="2" />
          <path d="M3 9h18" />
          <path d="M9 21V9" />
        </svg>
        <span class="once-toggle-label">Models</span>
      </a>

      <span class="once-dock-divider" aria-hidden="true"></span>

      <button
        type="button"
        class="once-toggle-btn is-icon-only"
        data-cmd-open
        aria-label="Search research, tickers, and models (Command+K)"
        title="Search (⌘K)"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
      </button>

      <button
        type="button"
        class="once-toggle-btn is-icon-only"
        data-theme-toggle
        aria-label="Toggle color theme"
        title="Switch theme"
      >
        <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
        <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
    </nav>
  </div>

  <div class="once-header-right">
    <span data-once-clock>16:45:00</span>
  </div>
</header>
