---
// Top Institutional Market Tape + Sticky Navigation Bar with Command Palette trigger and mobile drawer.
import { valuationModels } from '../../data/valuation-models';
import rawFlow from '../../content/market-views/_foreign_flow_cache.json';
import { formatDate, signedNumber } from '../../lib/format';

const links = [
  { label: 'Research Coverage', href: '/research', match: (p: string) => p.startsWith('/research') && !/^\/research\/(dcf|comparable|precedent)/.test(p) },
  { label: 'Valuation Methods', href: '/research/dcf', match: (p: string) => /^\/research\/(dcf|comparable|precedent)/.test(p) },
  { label: 'Market Notes', href: '/market-views', match: (p: string) => p.startsWith('/market-views') || p.startsWith('/monthly-views') },
  { label: 'Contact', href: '/contact', match: (p: string) => p.startsWith('/contact') },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const workbooks = valuationModels.reduce((acc, m) => acc + m.downloads.length, 0);

const flowDates = Object.keys(rawFlow).sort();
const latestFlowDate = flowDates[flowDates.length - 1];
const latestFlow = latestFlowDate ? (rawFlow as Record<string, { net: number }>)[latestFlowDate] : null;
---

<div class="market-tape no-print" role="region" aria-label="Research portfolio telemetry">
  <div class="wrap market-tape__inner">
    <div class="market-tape__items">
      <span class="market-tape__item">
        <span class="market-tape__dot" aria-hidden="true"></span>
        <strong>VIETNAM EQUITY RESEARCH</strong>
      </span>
      <span class="market-tape__sep" aria-hidden="true">·</span>
      <span class="market-tape__item">
        COVERAGE: <strong>{valuationModels.map((m) => m.ticker).join(' · ')}</strong>
      </span>
      <span class="market-tape__sep market-tape__hide-sm" aria-hidden="true">·</span>
      <span class="market-tape__item market-tape__hide-sm">
        DELIVERABLES: <strong>{workbooks} EXCEL MODELS &amp; {valuationModels.length} TEAR SHEETS</strong>
      </span>
    </div>
    {latestFlow && (
      <div class="market-tape__items market-tape__hide-sm">
        <span class="market-tape__item">
          HOSE FOREIGN FLOW ({formatDate(latestFlowDate)}):
          <strong>{signedNumber(latestFlow.net, 1)} bn VND</strong>
        </span>
      </div>
    )}
  </div>
</div>

<header class="site-header no-print">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Skip to main content</a>

    <a class="brand-lockup" href="/">
      <span class="brand-monogram" aria-hidden="true">TH</span>
      <span class="brand-text">
        <span class="brand-name">Truong Huy Research</span>
        <span class="brand-sub">Passed CFA Level II · Vietnam Equities</span>
      </span>
    </a>

    <nav class="nav__links" aria-label="Main navigation">
      {links.map((link) => (
        <a class="nav__link" href={link.href} aria-current={link.match(path) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="nav__actions">
      <button type="button" class="cmd-trigger" data-cmd-open aria-label="Search tickers, methods, and market notes (Ctrl+K)">
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <circle cx="7" cy="7" r="4.8" />
          <path d="M10.6 10.6 14 14" stroke-linecap="round" />
        </svg>
        <span>Search</span>
        <kbd class="cmd-kbd">⌘K</kbd>
      </button>

      <a class="btn btn--primary btn--sm nav__cv-desktop" href="/cv.pdf" target="_blank" rel="noopener">
        Download CV (PDF)
      </a>

      <button class="nav__toggle" type="button" data-mobile-toggle aria-expanded="false" aria-controls="mobile-nav-drawer" aria-label="Toggle navigation menu">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M2.5 5h13M2.5 9h13M2.5 13h13" />
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-drawer" id="mobile-nav-drawer" hidden>
    <nav class="mobile-drawer__nav" aria-label="Mobile navigation">
      {links.map((link) => (
        <a class="mobile-drawer__link" href={link.href} aria-current={link.match(path) ? 'page' : undefined}>
          <span>{link.label}</span>
          <span class="mono muted" aria-hidden="true">→</span>
        </a>
      ))}
    </nav>
    <div class="btn-row">
      <a class="btn btn--primary btn--sm" href="/cv.pdf" target="_blank" rel="noopener">Download the CV (PDF)</a>
      <button type="button" class="btn btn--secondary btn--sm" data-cmd-open>Search All Reports &amp; Notes</button>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.querySelector<HTMLButtonElement>('[data-mobile-toggle]');
  const drawer = document.getElementById('mobile-nav-drawer');

  toggleBtn?.addEventListener('click', () => {
    if (!drawer) return;
    const isOpen = !drawer.hidden;
    drawer.hidden = isOpen;
    toggleBtn.setAttribute('aria-expanded', String(!isOpen));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && !drawer.hidden) {
      drawer.hidden = true;
      toggleBtn?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
