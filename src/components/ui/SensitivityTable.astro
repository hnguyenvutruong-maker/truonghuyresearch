---
// Two-way DCF sensitivity: cells shaded around the price the model used (green above, red below, none
// within ±2%); every value printed, so colour is never the only channel; the base case outlined.
import type { ReferencePrice, SensitivityGrid } from '../../data/valuation-models';
import { formatDate, formatVndK } from '../../lib/format';
interface Props { grid: SensitivityGrid; reference: ReferencePrice }
const { grid, reference } = Astro.props;
const axis = (v: number, f: SensitivityGrid['rowFormat']) => (f === 'pct' ? `${(v * 100).toFixed(1)}%` : `${v.toFixed(1)}x`);
const refK = reference.value / 1000;
const shade = (k: number) => {
  const m = (k / refK - 1) * 100;
  return m >= 10 ? 's-up2' : m >= 2 ? 's-up1' : m > -2 ? 's-mid' : m > -10 ? 's-dn1' : 's-dn2';
};
---
<figure class="sheet">
  <div class="table-scroll" tabindex="0" role="region" aria-label={`${grid.title}, scrolls sideways`}>
    <table class="data sens">
      <caption class="t-label">{grid.title}</caption>
      <thead><tr><th scope="col">{grid.rowLabel} by {grid.colLabel}</th>{grid.cols.map((c) => <th scope="col">{axis(c, grid.colFormat)}</th>)}</tr></thead>
      <tbody>
        {grid.values.map((row, i) => (
          <tr>
            <th scope="row" class="num">{axis(grid.rows[i], grid.rowFormat)}</th>
            {row.map((v, j) => <td class:list={['num', shade(v), i === grid.baseRow && j === grid.baseCol && 's-base']}>{v.toFixed(1)}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <figcaption class="t-small muted field__note">VND thousands per share. Outlined: the model's base case. Green sits above and red below the {formatVndK(reference.value)} price used on {formatDate(reference.asOf)}; darker beyond ±10%. {grid.note}</figcaption>
</figure>
