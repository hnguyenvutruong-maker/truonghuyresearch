---
// Open Workbook & Tear Sheet Vault (unslop-ui clean header)
import Icon from './Icon.astro';
import Ticker from './Ticker.astro';
import { valuationModels } from '../../data/valuation-models';
import { publicFileSize } from '../../lib/files';

type VaultItem = {
  ticker: string;
  company: string;
  slug: string;
  title: string;
  kind: 'workbook' | 'tearsheet';
  format: string;
  size: string;
  sheets: string;
  href: string;
};

const rows: VaultItem[] = valuationModels.flatMap((m) => {
  const workbooks: VaultItem[] = m.downloads.map((d) => ({
    ticker: m.ticker,
    company: m.company,
    slug: m.slug,
    title: d.modelType ?? `${m.ticker} ${d.label} Model`,
    kind: 'workbook',
    format: d.format,
    size: publicFileSize(d.href) ?? '—',
    sheets: d.sheets.join(', '),
    href: d.href,
  }));

  const tearHref = `/research/tear-sheets/${m.slug}.pdf`;
  const tearSize = publicFileSize(tearHref);
  const tearSheets: VaultItem[] = tearSize
    ? [
        {
          ticker: m.ticker,
          company: m.company,
          slug: m.slug,
          title: `${m.ticker} One-Page Valuation Tear Sheet`,
          kind: 'tearsheet',
          format: 'PDF (A4)',
          size: tearSize,
          sheets: 'Football field, outputs vs price used, assumptions, conclusion & risks',
          href: tearHref,
        },
      ]
    : [];

  return [...workbooks, ...tearSheets];
});

const workbookCount = rows.filter((r) => r.kind === 'workbook').length;
const tearCount = rows.filter((r) => r.kind === 'tearsheet').length;
---

<div class="window" data-vault-root>
  <div class="window__bar">
    <span class="window__title"><Icon name="file" size={14} /> {workbookCount} Excel models · {tearCount} PDF tear sheets</span>
    <span class="window__actions">
      <span class="seg" role="group" aria-label="Filter files">
        <button type="button" data-vault-filter="all" aria-pressed="true">All <span class="count">{rows.length}</span></button>
        <button type="button" data-vault-filter="workbook" aria-pressed="false">Excel / ZIP <span class="count">{workbookCount}</span></button>
        <button type="button" data-vault-filter="tearsheet" aria-pressed="false">PDF <span class="count">{tearCount}</span></button>
      </span>
    </span>
  </div>
  <div class="table-scroll" tabindex="0" role="region" aria-label="Model workbooks and tear sheets, scrolls horizontally">
    <table class="dtable">
      <thead>
        <tr>
          <th scope="col">Company</th>
          <th scope="col">File</th>
          <th scope="col">Worksheets &amp; contents</th>
          <th scope="col">Format</th>
          <th scope="col" class="r">Size</th>
          <th scope="col"><span class="sr-only">Download</span></th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr data-vault-row={r.kind}>
            <th scope="row">
              <a class="cell-co" href={`/research/${r.slug}`}><Ticker label={r.ticker} />{r.ticker}</a>
            </th>
            <td>
              <span class="cell-co">
                <span class:list={['file-ico', r.kind === 'tearsheet' ? 'file-ico--pdf' : r.format === 'ZIP' ? 'file-ico--zip' : '']}>{r.format.split(' ')[0]}</span>
                {r.title}
              </span>
            </td>
            <td class="wrap muted">{r.sheets}</td>
            <td><span class="tag">{r.format}</span></td>
            <td class="r num muted">{r.size}</td>
            <td>
              <a class="btn btn--secondary btn--sm" href={r.href} download aria-label={`Download ${r.title} (${r.format})`}>
                <Icon name="download" size={14} /> Download
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-vault-root]').forEach((root) => {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-vault-filter]'));
    const rows = Array.from(root.querySelectorAll<HTMLElement>('[data-vault-row]'));
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const kind = btn.dataset.vaultFilter ?? 'all';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        rows.forEach((row) => {
          row.hidden = kind !== 'all' && row.dataset.vaultRow !== kind;
        });
      });
    });
  });
</script>
