---
// HOSE Foreign Flow Monitor: visualizes real daily foreign investor buy/sell/net flows
// from src/content/market-views/_foreign_flow_cache.json with smooth cross-blur window switching.
import rawFlow from '../../content/market-views/_foreign_flow_cache.json';
import Icon from './Icon.astro';
import { formatDate, formatNumber, signedNumber } from '../../lib/format';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

type RawEntry = { buy: number | null; sell: number | null; net: number };
const entries = Object.entries(rawFlow as Record<string, RawEntry>)
  .filter(([, v]) => v && typeof v.net === 'number')
  .sort(([a], [b]) => a.localeCompare(b));

const buildWindow = (id: string, label: string, count: number) => {
  const slice = count > 0 ? entries.slice(-count) : entries;
  let running = 0;
  const sessions = slice.map(([date, v]) => {
    running += v.net;
    return {
      date,
      buy: v.buy ?? 0,
      sell: v.sell ?? 0,
      net: v.net,
      cumNet: running,
    };
  });

  const totalBuy = sessions.reduce((acc, s) => acc + s.buy, 0);
  const totalSell = sessions.reduce((acc, s) => acc + s.sell, 0);
  const totalNet = sessions.reduce((acc, s) => acc + s.net, 0);
  const netBuyDays = sessions.filter((s) => s.net >= 0).length;
  const netSellDays = sessions.length - netBuyDays;

  const maxAbsNet = Math.max(...sessions.map((s) => Math.abs(s.net)), 1);
  const cumValues = sessions.map((s) => s.cumNet);
  const minCum = Math.min(...cumValues, 0);
  const maxCum = Math.max(...cumValues, 0);
  const cumSpan = Math.max(maxCum - minCum, 1);

  const W = 1000;
  const yZero = 110;
  const N = sessions.length;
  const slot = W / Math.max(N, 1);
  const barW = Math.max(slot * 0.72, 3);

  const bars = sessions.map((s, i) => {
    const x = Number((i * slot + (slot - barW) / 2).toFixed(2));
    const h = Number((Math.max((Math.abs(s.net) / maxAbsNet) * 86, 2)).toFixed(2));
    const y = Number((s.net >= 0 ? yZero - h : yZero).toFixed(2));
    const cx = Number((i * slot + slot / 2).toFixed(2));
    const cy = Number((195 - ((s.cumNet - minCum) / cumSpan) * 170).toFixed(2));
    return {
      ...s,
      x,
      y,
      w: Number(barW.toFixed(2)),
      h,
      cx,
      cy,
      dateLabel: formatDate(s.date),
      buyLabel: `${formatNumber(s.buy, 1)} bn`,
      sellLabel: `${formatNumber(s.sell, 1)} bn`,
      netLabel: `${signedNumber(s.net, 1)} bn`,
      cumLabel: `${signedNumber(s.cumNet, 1)} bn`,
    };
  });

  const polyline = bars.map((b) => `${b.cx},${b.cy}`).join(' ');
  const latest = bars[bars.length - 1];
  const first = bars[0];

  return {
    id,
    label,
    sessions: bars,
    polyline,
    totalBuy,
    totalSell,
    totalNet,
    netBuyDays,
    netSellDays,
    latest,
    first,
    yZero,
  };
};

const windows = compact
  ? [buildWindow('w30', '30 Sessions', 30)]
  : [
      buildWindow('w20', '20 Sessions', 20),
      buildWindow('w60', '60 Sessions', 60),
      buildWindow('all', `All ${entries.length} Sessions`, 0),
    ];
---

<div class="panel" data-flow-monitor>
  <div class="panel__head">
    <span class="panel__title"><Icon name="flow" size={14} /> HOSE foreign net flow, daily</span>
    {!compact && (
      <span class="panel__actions">
        <span class="seg" role="tablist" aria-label="Foreign flow window">
          {windows.map((w, idx) => (
            <button type="button" role="tab" data-flow-tab={w.id} aria-selected={idx === 0 ? 'true' : 'false'}>
              {w.label}
            </button>
          ))}
        </span>
      </span>
    )}
  </div>

  <div class="panel__body">
    {windows.map((w, idx) => (
      <div data-flow-panel={w.id} hidden={idx !== 0}>
        <dl class="flow-kpis">
          <div>
            <dt>Net flow ({w.sessions.length} sessions)</dt>
            <dd class:list={[w.totalNet >= 0 ? 'up' : 'down']}>{signedNumber(w.totalNet, 1)} bn VND</dd>
          </div>
          <div>
            <dt>Foreign buy</dt>
            <dd>{formatNumber(w.totalBuy, 0)} bn VND</dd>
          </div>
          <div>
            <dt>Foreign sell</dt>
            <dd>{formatNumber(w.totalSell, 0)} bn VND</dd>
          </div>
          <div>
            <dt>Net-buy / net-sell days</dt>
            <dd><span class="up">{w.netBuyDays}</span> / <span class="down">{w.netSellDays}</span></dd>
          </div>
        </dl>

        {w.latest && (
          <div class="inspector" aria-live="polite">
            <span><strong data-flow-date>{w.latest.dateLabel}</strong></span>
            <span>Buy <strong data-flow-buy>{w.latest.buyLabel}</strong></span>
            <span>Sell <strong data-flow-sell>{w.latest.sellLabel}</strong></span>
            <span>Net <strong data-flow-net class:list={[w.latest.net >= 0 ? 'up' : 'down']}>{w.latest.netLabel}</strong></span>
            <span>Cumulative <strong data-flow-cum class:list={[w.latest.cumNet >= 0 ? 'up' : 'down']}>{w.latest.cumLabel}</strong></span>
          </div>
        )}

        <svg viewBox="0 0 1000 215" preserveAspectRatio="none" class="flow-svg" role="img" aria-label={`HOSE daily foreign net flow from ${w.first?.dateLabel} to ${w.latest?.dateLabel}`}>
          <line x1="0" x2="1000" y1="24" y2="24" class="c-grid" vector-effect="non-scaling-stroke" />
          <line x1="0" x2="1000" y1={w.yZero} y2={w.yZero} class="flow-zero" vector-effect="non-scaling-stroke" />
          <line x1="0" x2="1000" y1="196" y2="196" class="c-grid" vector-effect="non-scaling-stroke" />
          {w.sessions.map((b) => (
            <rect
              x={b.x}
              y={b.y}
              width={b.w}
              height={b.h}
              rx="1.5"
              class={b.net >= 0 ? 'flow-bar--up' : 'flow-bar--down'}
              data-flow-bar
              data-date={b.dateLabel}
              data-buy={b.buyLabel}
              data-sell={b.sellLabel}
              data-net={b.netLabel}
              data-cum={b.cumLabel}
              data-net-pos={b.net >= 0 ? '1' : '0'}
              data-cum-pos={b.cumNet >= 0 ? '1' : '0'}
              tabindex="0"
              aria-label={`${b.dateLabel}: net ${b.netLabel}`}
            />
          ))}
          <polyline points={w.polyline} class="flow-cum" vector-effect="non-scaling-stroke" />
        </svg>

        <div class="chart-foot">
          <span>{w.first?.dateLabel} – {w.latest?.dateLabel}</span>
          <span class="legend"><span><i class="l-up"></i>Net buy</span><span><i class="l-down"></i>Net sell</span><span><i class="l-cum"></i>Cumulative net</span></span>
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-flow-monitor]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-flow-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-flow-panel]'));

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.dataset.flowTab;
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        panels.forEach((p) => {
          p.hidden = p.dataset.flowPanel !== targetId;
        });
      });
    });

    panels.forEach((panel) => {
      const dateEl = panel.querySelector<HTMLElement>('[data-flow-date]');
      const buyEl = panel.querySelector<HTMLElement>('[data-flow-buy]');
      const sellEl = panel.querySelector<HTMLElement>('[data-flow-sell]');
      const netEl = panel.querySelector<HTMLElement>('[data-flow-net]');
      const cumEl = panel.querySelector<HTMLElement>('[data-flow-cum]');

      const inspect = (bar: SVGRectElement) => {
        if (dateEl) dateEl.textContent = bar.dataset.date ?? '';
        if (buyEl) buyEl.textContent = bar.dataset.buy ?? '';
        if (sellEl) sellEl.textContent = bar.dataset.sell ?? '';
        if (netEl) {
          netEl.textContent = bar.dataset.net ?? '';
          netEl.classList.toggle('up', bar.dataset.netPos === '1');
          netEl.classList.toggle('down', bar.dataset.netPos !== '1');
        }
        if (cumEl) {
          cumEl.textContent = bar.dataset.cum ?? '';
          cumEl.classList.toggle('up', bar.dataset.cumPos === '1');
          cumEl.classList.toggle('down', bar.dataset.cumPos !== '1');
        }
      };

      panel.querySelectorAll<SVGRectElement>('[data-flow-bar]').forEach((bar) => {
        bar.addEventListener('pointerenter', () => inspect(bar));
        bar.addEventListener('focus', () => inspect(bar));
        bar.addEventListener('click', () => inspect(bar));
      });
    });
  });
</script>
