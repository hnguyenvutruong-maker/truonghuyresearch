---
// The framed block every piece of content sits in: a coloured title bar over a solid panel.
// Tone picks the section colour (profile violet, valuation teal, market notes amber) or the
// navy chrome for neutral panels.
import type { Tone } from '../../lib/tone';

interface Props {
  title: string;
  meta?: string;
  tone?: Tone;
  as?: 'section' | 'article' | 'aside' | 'div' | 'nav';
  level?: 2 | 3;
  id?: string;
  class?: string;
  bodyClass?: string;
  flush?: boolean;
  reveal?: boolean;
  label?: string;
}

const { title, meta, tone = 'neutral', as: Tag = 'section', level = 2, id, class: className, bodyClass, flush = false, reveal = false, label }: Props = Astro.props;
const Heading = level === 3 ? 'h3' : 'h2';
const bars: Record<Tone, string> = { neutral: 'bg-chrome text-chrome-fg', profile: 'bg-profile text-white', value: 'bg-value text-white', market: 'bg-market text-white' };
const bar = bars[tone];
const hasMeta = Boolean(meta) || Astro.slots.has('meta');
---

<Tag id={id} aria-label={label} class:list={['flex min-w-0 flex-col border border-line bg-panel shadow-panel', id && 'scroll-mt-28', className]} data-reveal={reveal ? '' : undefined}>
  <div class:list={['flex flex-wrap items-center justify-between gap-x-4 gap-y-1 px-4 py-2', bar]}>
    <Heading class="font-mono text-label uppercase">{title}</Heading>
    {hasMeta && <div class="font-mono text-[0.75rem] font-medium opacity-90"><slot name="meta">{meta}</slot></div>}
  </div>
  <div class:list={['flex-1', !flush && 'p-4 md:p-5', bodyClass]}>
    <slot />
  </div>
</Tag>
