---
// Site-wide quick jump: Ctrl/⌘+K, "/" or any [data-palette-open] button opens a native
// <dialog> (focus trap + Esc for free) with a combobox over every page, ticker, method and
// note. The index is built at compile time; matching ignores case and Vietnamese diacritics.
import { getCollection } from 'astro:content';
import { methodPages, valuationGroups, valuationModels } from '../../data/valuation-models';
import { monthlySummary, weeklySummary } from '../../lib/notes';

type Entry = { kind: string; title: string; detail: string; href: string; keywords: string; rank: number };

const notes = [
  ...(await getCollection('market-views')).map(weeklySummary),
  ...(await getCollection('monthly-views')).map(monthlySummary),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const entries: Entry[] = [
  { kind: 'Page', title: 'Front page', detail: 'Profile, coverage and the latest notes', href: '/', keywords: 'home', rank: 0 },
  { kind: 'Page', title: 'Coverage', detail: 'Sortable valuation table for every issuer', href: '/research', keywords: 'research valuation table', rank: 0 },
  { kind: 'Page', title: 'Market notes', detail: 'Weekly and monthly VN-Index notes', href: '/market-views', keywords: 'market views weekly', rank: 0 },
  { kind: 'Page', title: 'Monthly views', detail: 'Monthly notes only', href: '/monthly-views', keywords: 'monthly', rank: 1 },
  { kind: 'Page', title: 'Download CV', detail: 'PDF', href: '/cv.pdf', keywords: 'resume curriculum vitae', rank: 0 },
  { kind: 'Page', title: 'Contact', detail: 'Email, phone and LinkedIn', href: '/contact', keywords: 'email linkedin phone', rank: 1 },
  { kind: 'Page', title: 'Disclaimer', detail: 'Academic portfolio disclosure', href: '/disclaimer', keywords: '', rank: 2 },
  ...valuationModels.map((model) => ({
    kind: 'Report',
    title: `${model.ticker} · ${model.company}`,
    detail: `${model.sector} · ${model.methods.join(', ')}`,
    href: `/research/${model.slug}`,
    keywords: `${model.ticker} ${model.company} ${model.sector}`,
    rank: 0,
  })),
  ...methodPages.flatMap((page) => {
    const group = valuationGroups.find((item) => item.id === page.id);
    return group
      ? [{ kind: 'Method', title: group.title, detail: group.eyebrow, href: page.href, keywords: `${group.description} lbo precedent comps comparable dcf`, rank: 1 }]
      : [];
  }),
  ...notes.map((note, index) => ({
    kind: `${note.kind} note`,
    title: note.headline,
    detail: note.period,
    href: note.href,
    keywords: `${note.kind} ${note.period} ${note.date.toISOString().slice(0, 10)}`,
    rank: 2 + index / 1000,
  })),
];

// The default list before typing: pages, reports, then the three newest notes
const defaults = [
  ...entries.filter((entry) => entry.kind === 'Page' && entry.rank === 0),
  ...entries.filter((entry) => entry.kind === 'Report'),
  ...entries.filter((entry) => entry.kind.endsWith('note')).slice(0, 3),
].map((entry) => entry.href);
---

<dialog
  id="command-palette"
  aria-label="Search the site"
  class="m-0 mx-auto mt-[12vh] w-[calc(100%-2rem)] max-w-2xl border border-line bg-panel p-0 text-fg shadow-lift backdrop:bg-[#04060A]/60"
>
  <div class="flex items-center gap-3 border-b border-line bg-chrome px-4 text-chrome-fg">
    <label for="palette-input" class="font-mono text-label uppercase text-[#57D6C8]">Go to</label>
    <input
      id="palette-input"
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-results"
      aria-autocomplete="list"
      autocomplete="off"
      spellcheck="false"
      placeholder="Ticker, method, note, CV…"
      class="min-w-0 flex-1 bg-transparent py-4 font-sans text-xl text-chrome-fg placeholder:text-chrome-muted focus:outline-none"
    />
    <kbd class="hidden border border-chrome-line px-1.5 py-0.5 font-mono text-label text-chrome-muted sm:inline">Esc</kbd>
  </div>
  <ul id="palette-results" role="listbox" aria-label="Results" class="max-h-[60vh] overflow-y-auto"></ul>
  <p id="palette-empty" class="hidden px-4 py-6 text-small text-fg-muted">Nothing matches. Try a ticker such as HPG, or a month such as May 2026.</p>
  <p class="flex flex-wrap gap-x-4 gap-y-1 border-t border-line bg-panel-alt px-4 py-2 font-mono text-label uppercase text-fg-muted">
    <span>↑↓ move</span><span>Enter open</span><span>Esc close</span>
  </p>
</dialog>

<script type="application/json" id="palette-data" set:html={JSON.stringify({ entries, defaults })}></script>

<script>
  type Entry = { kind: string; title: string; detail: string; href: string; keywords: string; rank: number };

  const dialog = document.getElementById('command-palette') as HTMLDialogElement | null;
  const input = document.getElementById('palette-input') as HTMLInputElement | null;
  const list = document.getElementById('palette-results');
  const empty = document.getElementById('palette-empty');
  const raw = document.getElementById('palette-data')?.textContent ?? '{"entries":[],"defaults":[]}';
  const { entries, defaults } = JSON.parse(raw) as { entries: Entry[]; defaults: string[] };

  // Lowercase and strip diacritics so "phu nhuan" finds "Phú Nhuận"
  const fold = (text: string) => text.normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/đ/gi, 'd').toLowerCase();
  const index = entries.map((entry) => ({ entry, hay: fold(`${entry.title} ${entry.detail} ${entry.keywords} ${entry.kind}`), title: fold(entry.title) }));

  let results: Entry[] = [];
  let active = 0;

  const search = (query: string): Entry[] => {
    const terms = fold(query).split(/\s+/).filter(Boolean);
    if (terms.length === 0) return defaults.map((href) => entries.find((entry) => entry.href === href)).filter((entry): entry is Entry => Boolean(entry));
    return index
      .filter((item) => terms.every((term) => item.hay.includes(term)))
      .map((item) => {
        const first = terms[0];
        const score = (item.title.startsWith(first) ? 0 : item.title.includes(` ${first}`) ? 1 : 2) + item.entry.rank;
        return { entry: item.entry, score };
      })
      .sort((a, b) => a.score - b.score)
      .slice(0, 12)
      .map((item) => item.entry);
  };

  const render = () => {
    if (!list || !input) return;
    list.replaceChildren(
      ...results.map((entry, i) => {
        const li = document.createElement('li');
        li.id = `palette-option-${i}`;
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', String(i === active));
        li.dataset.index = String(i);
        li.className = 'flex cursor-pointer items-baseline gap-4 border-b border-line px-4 py-3 aria-selected:bg-panel-alt';
        const kind = document.createElement('span');
        kind.className = `w-24 shrink-0 font-mono text-label uppercase ${entry.kind === 'Report' || entry.kind === 'Method' ? 'text-value-ink' : entry.kind.endsWith('note') ? 'text-market-ink' : 'text-profile-ink'}`;
        kind.textContent = entry.kind;
        const body = document.createElement('span');
        body.className = 'min-w-0 flex-1';
        const title = document.createElement('span');
        title.className = 'block truncate text-small font-semibold text-fg';
        title.textContent = entry.title;
        const detail = document.createElement('span');
        detail.className = 'block truncate font-mono text-[0.8125rem] text-fg-muted';
        detail.textContent = entry.detail;
        body.append(title, detail);
        li.append(kind, body);
        li.addEventListener('mousemove', () => {
          if (active !== i) {
            active = i;
            update();
          }
        });
        li.addEventListener('click', () => go(entry));
        return li;
      })
    );
    empty?.classList.toggle('hidden', results.length > 0);
    update();
  };

  const update = () => {
    list?.querySelectorAll<HTMLElement>('[role="option"]').forEach((li) => {
      const selected = li.dataset.index === String(active);
      li.setAttribute('aria-selected', String(selected));
      if (selected) li.scrollIntoView({ block: 'nearest' });
    });
    if (results.length > 0) input?.setAttribute('aria-activedescendant', `palette-option-${active}`);
    else input?.removeAttribute('aria-activedescendant');
  };

  const go = (entry: Entry) => {
    dialog?.close();
    window.location.href = entry.href;
  };

  const open = () => {
    if (!dialog || !input || dialog.open) return;
    input.value = '';
    results = search('');
    active = 0;
    render();
    dialog.showModal();
    input.focus();
  };

  input?.addEventListener('input', () => {
    results = search(input.value);
    active = 0;
    render();
  });

  input?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      if (results.length === 0) return;
      active = (active + (event.key === 'ArrowDown' ? 1 : -1) + results.length) % results.length;
      update();
    } else if (event.key === 'Enter') {
      event.preventDefault();
      const entry = results[active];
      if (entry) go(entry);
    }
  });

  // Click on the backdrop (outside the dialog box) closes it
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  document.querySelectorAll('[data-palette-open]').forEach((button) => button.addEventListener('click', open));

  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement | null;
    const typing = target?.closest('input, textarea, select, [contenteditable="true"]');
    if ((event.key === 'k' || event.key === 'K') && (event.metaKey || event.ctrlKey)) {
      event.preventDefault();
      if (dialog?.open) dialog.close();
      else open();
    } else if (event.key === '/' && !typing && !dialog?.open) {
      event.preventDefault();
      open();
    }
  });
</script>
