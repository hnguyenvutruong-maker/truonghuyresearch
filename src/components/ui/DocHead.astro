---
// Inner document header: back link, institutional eyebrow label, h1, lead, and optional aside slot.
interface Props {
  label?: string;
  title: string;
  lead?: string;
  back?: { href: string; label: string };
}
const { label, title, lead, back } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class="doc-head">
  <div class="wrap">
    {back && <a href={back.href} class="back">← {back.label}</a>}
    <div class="grid grid--top">
      <div class:list={[hasAside ? 'span-6' : 'span-8', 'stack-4']}>
        <slot name="before" />
        {label && <p class="eyebrow">{label}</p>}
        <h1 class="t-h1">{title}</h1>
        {lead && <p class="t-lead measure secondary">{lead}</p>}
        <slot />
      </div>
      {hasAside && <div class="span-6"><slot name="aside" /></div>}
    </div>
  </div>
</section>
