---
import { portfolioDisclaimer } from '../../data/valuation-models';

interface Props {
  label?: string;
  text?: string;
}

const { label = 'Academic research, not investment advice', text = portfolioDisclaimer } = Astro.props;
---

<aside class="rule-top mt-16 pt-6" aria-label="Disclosure">
  <p class="t-label">{label}</p>
  <p class="t-small measure mt-1 text-ink-muted">{text}</p>
</aside>
