---
// VN-Index chart (lightweight-charts): an area of weekly closes, or daily candles when a note
// carries `vn_index_daily`. Colours come from the tokens in global.css. The library is imported
// only when the chart nears the viewport.
export interface TrendPoint {
  time: string; // YYYY-MM-DD
  value: number;
}

export interface CandlePoint {
  time: string;
  open: number;
  high: number;
  low: number;
  close: number;
}

interface Props {
  trendData?: TrendPoint[];
  candleData?: CandlePoint[];
  label: string;
  height?: 'md' | 'lg';
}

const { trendData = [], candleData = [], label, height = 'lg' } = Astro.props;
const hasData = trendData.length > 0 || candleData.length > 0;
---

{hasData && (
  <div>
    <div
      data-vni-chart
      role="img"
      aria-label={label}
      class:list={['vni', height === 'lg' ? 'vni--lg' : 'vni--md']}
      data-trend={JSON.stringify(trendData)}
      data-candle={JSON.stringify(candleData)}
    ></div>
    <p class="t-label muted vni__credit">
      Chart by <a href="https://www.tradingview.com/" target="_blank" rel="noopener noreferrer" class="link">TradingView Lightweight Charts</a>
    </p>
  </div>
)}

<script>
  const css = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(`--${name}`).trim();
  const rgba = (hex: string, alpha: number) => {
    const n = parseInt(hex.replace('#', ''), 16);
    return `rgba(${(n >> 16) & 255}, ${(n >> 8) & 255}, ${n & 255}, ${alpha})`;
  };

  const draw = async (el: HTMLElement) => {
    const { createChart, CrosshairMode } = await import('lightweight-charts');
    const trendData: { time: string; value: number }[] = JSON.parse(el.dataset.trend ?? '[]');
    const candleData: { time: string; open: number; high: number; low: number; close: number }[] = JSON.parse(el.dataset.candle ?? '[]');
    const action = css('action') || '#1e3a5f';
    const line = 'rgba(19, 33, 46, 0.1)';

    const chart = createChart(el, {
      width: el.clientWidth,
      height: el.clientHeight || 260,
      layout: {
        background: { color: 'rgba(0, 0, 0, 0)' },
        textColor: css('muted') || '#4f5d6b',
        fontFamily: 'Libre Franklin, Arial, sans-serif',
        fontSize: 12,
        // The logo injects an inline <style> (blocked by the CSP); the text link below credits the library
        attributionLogo: false,
      },
      grid: { vertLines: { visible: false }, horzLines: { color: line } },
      crosshair: { mode: CrosshairMode.Normal },
      rightPriceScale: { borderVisible: false, scaleMargins: { top: 0.08, bottom: 0.06 } },
      timeScale: { borderColor: line, timeVisible: true },
      handleScroll: false,
      handleScale: false,
    });

    if (candleData.length > 0) {
      const up = css('up') || '#13703a';
      const down = css('down') || '#b42318';
      chart.addCandlestickSeries({ upColor: up, downColor: down, borderUpColor: up, borderDownColor: down, wickUpColor: up, wickDownColor: down }).setData(candleData);
    } else if (trendData.length > 0) {
      chart
        .addAreaSeries({ lineWidth: 2, lineColor: action, topColor: rgba(action, 0.18), bottomColor: rgba(action, 0.01), priceLineVisible: false, lastValueVisible: true })
        .setData(trendData);
    }
    chart.timeScale().fitContent();
    new ResizeObserver(() => chart.applyOptions({ width: el.clientWidth })).observe(el);
  };

  document.querySelectorAll<HTMLElement>('[data-vni-chart]').forEach((el) => {
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            observer.disconnect();
            void draw(el);
          }
        },
        { rootMargin: '300px 0px' }
      );
      observer.observe(el);
    } else {
      void draw(el);
    }
  });
</script>
