---
// Inner-page header (no full-screen hero on document pages): a back link, a sentence-case
// label, the h1, a lead, and an optional aside (facts, a download) on the right columns.
import Icon from './Icon.astro';

interface Props {
  label?: string;
  title: string;
  lead?: string;
  back?: { href: string; label: string };
  alt?: boolean;
}

const { label, title, lead, back, alt = false } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class:list={['page-head', alt && 'bg-ground-alt']}>
  <div class="wrap">
    {back && (
      <a href={back.href} class="crumb mb-8"><Icon name="arrow_left" size={18} /> {back.label}</a>
    )}
    <div class:list={['grid grid-cols-1 gap-10', hasAside && 'lg:grid-cols-12 lg:gap-6']}>
      <div class:list={['min-w-0', hasAside && 'lg:col-span-7']} data-enter>
        <slot name="before" />
        {label && <p class="t-label muted">{label}</p>}
        <h1 class="t-h1 mt-3">{title}</h1>
        {lead && <p class="t-lead measure mt-5 text-ink-muted">{lead}</p>}
        <slot />
      </div>
      {hasAside && <div class="min-w-0 lg:col-span-4 lg:col-start-9"><slot name="aside" /></div>}
    </div>
  </div>
</section>
