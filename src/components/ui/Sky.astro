---
// Dusk backdrop for the hero and closing band. The horizon is the VN-Index itself: the far ridge
// traces the weekly closes, the near ridge the same series mirrored, drawn as a landscape silhouette.
import { getCollection } from 'astro:content';

interface Props {
  variant?: 'hero' | 'cta';
}
const { variant = 'hero' } = Astro.props;

const closes = (await getCollection('market-views'))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .map((e) => e.data.vn_index_close);

const W = 1440;
const H = 400;
const series = closes.length > 2 ? closes : [1, 2, 1.5, 2.5, 2];
const min = Math.min(...series);
const max = Math.max(...series);
const span = Math.max(max - min, 1);

const ridge = (values: number[], top: number, amp: number) => {
  const n = values.length - 1;
  const pts = values.map((v, i) => [(i / n) * W, top + (1 - (v - min) / span) * amp] as const);
  // Catmull-Rom → cubic Bézier for a soft hill line
  let d = `M0,${pts[0][1].toFixed(1)}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] ?? p2;
    const c1x = p1[0] + (p2[0] - p0[0]) / 6;
    const c1y = p1[1] + (p2[1] - p0[1]) / 6;
    const c2x = p2[0] - (p3[0] - p1[0]) / 6;
    const c2y = p2[1] - (p3[1] - p1[1]) / 6;
    d += ` C${c1x.toFixed(1)},${c1y.toFixed(1)} ${c2x.toFixed(1)},${c2y.toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
  }
  return d;
};

const far = ridge(series, 90, 170);
const near = ridge([...series].reverse(), 230, 90);
---

<div class="sky" aria-hidden="true">
  <div class="sky__grain"></div>
  <svg class="sky__ridge" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
    <path class="ridge-far" d={`${far} L${W},${H} L0,${H} Z`} />
    <path class="ridge-line" d={far} vector-effect="non-scaling-stroke" />
    <path class="ridge-near" d={`${near} L${W},${H} L0,${H} Z`} />
  </svg>
  {variant === 'hero' && <div class="sky__fade"></div>}
</div>
