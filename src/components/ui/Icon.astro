---
// Inline stroke icons on a 24-unit grid, one stroke weight, round caps (no icon font, nothing for the CSP to allow).
type IconName =
  | 'arrow_down'
  | 'arrow_right'
  | 'arrow_left'
  | 'chevron_right'
  | 'chevron_down'
  | 'close'
  | 'download'
  | 'menu'
  | 'north_east'
  | 'file'
  | 'chart'
  | 'search'
  | 'sun'
  | 'moon'
  | 'star'
  | 'home'
  | 'layers'
  | 'book'
  | 'grid'
  | 'table'
  | 'flow'
  | 'calendar'
  | 'mail'
  | 'github'
  | 'linkedin'
  | 'rss'
  | 'user'
  | 'check'
  | 'plus'
  | 'sort'
  | 'filter'
  | 'sidebar'
  | 'dots'
  | 'printer'
  | 'globe';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;

const paths: Record<IconName, string> = {
