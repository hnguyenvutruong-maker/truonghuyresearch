---
// Football field: each method's value range (or point estimate) against the share price the
// model used. Marks are inline SVG on a shared 0–1000 scale per row; every label and figure is
// HTML. Navy bars, a white gap at the base case, the price used as an amber line.
import {
  formatOutput,
  impliedMovePct,
  outputMethodLabel,
  type ReferencePrice,
  type ValuationOutput,
} from '../../data/valuation-models';
import { formatDate, formatVndK, signedPct } from '../../lib/format';

interface Props {
  outputs: ValuationOutput[];
  reference: ReferencePrice;
  ticker: string;
  /** Shorter rows and no footnote (tear sheets, the home page). */
  compact?: boolean;
}

const { outputs, reference, ticker, compact = false } = Astro.props;

const values = [...outputs.flatMap((output) => [output.low, output.high]), reference.value];
const lo = Math.min(...values);
const hi = Math.max(...values);
const steps = [500, 1000, 2000, 2500, 5000, 10000, 20000, 25000, 50000];
const step = steps.find((candidate) => (hi - lo) / candidate <= 4) ?? 100000;
const domainMin = Math.floor((lo - step * 0.25) / step) * step;
const domainMax = Math.ceil((hi + step * 0.25) / step) * step;
const ticks: number[] = [];
for (let tick = domainMin; tick <= domainMax + 1e-6; tick += step) ticks.push(tick);

const W = 1000;
const x = (value: number) => ((value - domainMin) / (domainMax - domainMin)) * W;
const refX = x(reference.value);
const tickLabel = (tick: number) => (tick % 1000 === 0 ? `${tick / 1000}k` : formatVndK(tick));

const rows = outputs.map((output) => {
  const isPoint = output.low === output.high;
  const move = impliedMovePct(output, reference);
  return {
    label: outputMethodLabel[output.method],
    value: formatOutput(output),
    move,
    isPoint,
    x0: x(output.low),
    width: Math.max(x(output.high) - x(output.low), 0),
    baseX: output.base !== undefined ? x(output.base) : null,
    summary: `${outputMethodLabel[output.method]}: ${
      isPoint ? formatVndK(output.low) : `${formatVndK(output.low)} to ${formatVndK(output.high)}`
    }${output.base !== undefined ? `, base case ${formatVndK(output.base)}` : ''}; ${signedPct(move, 1)} versus the ${formatVndK(reference.value)} price used`,
  };
});
---

<figure class="m-0">
  <figcaption class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
    <span class="t-label">{ticker}, VND per share</span>
    <span class="t-label flex flex-wrap items-center gap-x-5 gap-y-1 text-ink-muted">
      <span class="inline-flex items-center gap-2">
        <svg width="18" height="10" aria-hidden="true"><rect x="0" y="2" width="18" height="6" rx="1" class="fill-action" /></svg>
        Range or estimate
      </span>
      <span class="inline-flex items-center gap-2">
        <svg width="10" height="14" aria-hidden="true"><line x1="5" x2="5" y1="0" y2="14" class="stroke-amber" stroke-width="2" stroke-dasharray="3 2" /></svg>
        Price used {formatVndK(reference.value)}, {formatDate(reference.asOf)}
      </span>
    </span>
  </figcaption>

  <div class="mt-5">
    {rows.map((row) => (
      <div class="grid grid-cols-[7rem_minmax(0,1fr)] items-center gap-x-4 border-b border-line sm:grid-cols-[10rem_minmax(0,1fr)]">
        <div class:list={[compact ? 'py-2' : 'py-3']}>
          <p class="t-label text-ink-muted">{row.label}</p>
          <p class="t-data mt-0.5 font-medium text-ink">{row.value}</p>
          <p class:list={['t-data text-[0.8125rem]', row.move >= 0 ? 'text-up' : 'text-down']}>{signedPct(row.move, 1)}</p>
          <span class="sr-only">{row.summary}</span>
        </div>
        <svg viewBox={`0 0 ${W} 40`} preserveAspectRatio="none" class:list={['block w-full overflow-visible', compact ? 'h-9' : 'h-12']} aria-hidden="true">
          {ticks.map((tick) => (
            <line x1={x(tick)} x2={x(tick)} y1="0" y2="40" class="stroke-line" stroke-width="1" vector-effect="non-scaling-stroke" />
          ))}
          {row.isPoint ? (
            <line x1={row.x0} x2={row.x0} y1="9" y2="31" class="stroke-action" stroke-width="5" vector-effect="non-scaling-stroke" />
          ) : (
            <rect x={row.x0} y="13" width={row.width} height="14" class="fill-action" />
          )}
          {row.baseX !== null && (
            <line x1={row.baseX} x2={row.baseX} y1="11" y2="29" class="stroke-ground-card" stroke-width="2.5" vector-effect="non-scaling-stroke" />
          )}
          <line x1={refX} x2={refX} y1="0" y2="40" class="stroke-amber" stroke-width="2" stroke-dasharray="4 3" vector-effect="non-scaling-stroke" />
        </svg>
      </div>
    ))}

    <div class="grid grid-cols-[7rem_minmax(0,1fr)] gap-x-4 pt-2 sm:grid-cols-[10rem_minmax(0,1fr)]" aria-hidden="true">
      <span></span>
      <div class="t-label flex justify-between font-mono text-ink-muted">
        {ticks.map((tick) => <span>{tickLabel(tick)}</span>)}
      </div>
    </div>
  </div>

  {!compact && (
    <p class="t-small mt-5 text-ink-muted">
      A white gap inside a bar marks the base case; a short heavy bar is a point estimate. Percentages compare each method's
      base case or midpoint with the {formatVndK(reference.value)} price the model used on {formatDate(reference.asOf)}.
    </p>
  )}
</figure>
