---
// Football field: each method's VND range drawn as implied move against the price the model used.
// `models` → one row per company (all methods stacked); `outputs + reference` → one row per method.
import {
  formatOutput,
  impliedMovePct,
  outputMethodLabel,
  type OutputMethod,
  type ReferencePrice,
  type ValuationModel,
  type ValuationOutput,
} from '../../data/valuation-models';
import { signedPct } from '../../lib/format';
import Ticker from './Ticker.astro';

interface Props {
  models?: ValuationModel[];
  outputs?: ValuationOutput[];
  reference?: ReferencePrice;
  ticker?: string;
  legend?: boolean;
}
const { models, outputs, reference, legend = true } = Astro.props;

const laneClass: Record<OutputMethod, string> = {
  DCF: 'dcf',
  Comparable: 'comparable',
  Precedent: 'precedent',
  LBO: 'lbo',
};
const pct = (v: number, ref: ReferencePrice) => (v / ref.value - 1) * 100;

const all: Array<{ o: ValuationOutput; ref: ReferencePrice }> = models
  ? models.flatMap((m) => m.outputs.map((o) => ({ o, ref: m.referencePrice })))
  : (outputs ?? []).map((o) => ({ o, ref: reference! }));
const lows = all.map(({ o, ref }) => pct(Math.min(o.low, o.high), ref));
const highs = all.map(({ o, ref }) => pct(Math.max(o.low, o.high), ref));
const MIN = Math.min(-10, Math.floor((Math.min(...lows, 0) - 4) / 10) * 10);
const MAX = Math.max(10, Math.ceil((Math.max(...highs, 0) + 4) / 10) * 10);
const x = (p: number) => Number((((Math.max(MIN, Math.min(MAX, p)) - MIN) / (MAX - MIN)) * 100).toFixed(2));
const ticks = Array.from({ length: Math.round((MAX - MIN) / 10) + 1 }, (_, i) => MIN + i * 10).filter(
  (t, i, arr) => arr.length <= 9 || i % 2 === 0 || t === 0
);

const bar = (o: ValuationOutput, ref: ReferencePrice) => {
  const a = x(pct(Math.min(o.low, o.high), ref));
  const b = x(pct(Math.max(o.low, o.high), ref));
  return { x: a, w: Math.max(1.4, Number((b - a).toFixed(2))), base: o.base !== undefined ? x(pct(o.base, ref)) : null };
};

const companyRows = (models ?? []).map((m) => {
  const moves = m.outputs.map((o) => impliedMovePct(o, m.referencePrice));
  const n = m.outputs.length;
  const h = 26 / n;
  return {
    m,
    spread: `${signedPct(Math.min(...moves), 0)} to ${signedPct(Math.max(...moves), 0)}`,
    bars: m.outputs.map((o, i) => ({ ...bar(o, m.referencePrice), y: 4 + i * h, h: Math.max(3, h - 2), lane: laneClass[o.method] })),
  };
});
const methodRows = models
  ? []
  : (outputs ?? []).map((o) => ({
      o,
      lane: laneClass[o.method],
      label: outputMethodLabel[o.method],
      text: formatOutput(o),
      move: impliedMovePct(o, reference!),
      ...bar(o, reference!),
    }));
const methodsUsed = [...new Set(all.map(({ o }) => o.method))];
---

<figure class:list={['ff', !models && 'ff--detail']}>
  {models
    ? companyRows.map(({ m, spread, bars }) => (
        <a class="ff-row" href={`/research/${m.slug}`} aria-label={`${m.ticker}: implied move ${spread}`}>
          <span class="ff-row__tick">
            <Ticker label={m.ticker} />
            {m.ticker}
          </span>
          <svg class="ff-svg" viewBox="0 0 100 34" preserveAspectRatio="none" aria-hidden="true">
            {ticks.map((t) => (
              <line class={t === 0 ? 'ff-zero' : 'ff-grid'} x1={x(t)} x2={x(t)} y1="0" y2="34" vector-effect="non-scaling-stroke" />
            ))}
            {bars.map((b) => (
              <rect class={`ff-bar--${b.lane}`} x={b.x} y={b.y} width={b.w} height={b.h} rx="1" />
            ))}
          </svg>
          <span class="ff-row__spread">{spread}</span>
        </a>
      ))
    : methodRows.map((r) => (
        <div class="ff-detail-row">
          <span class="ff-detail-row__label">
            <i class:list={['legend-dot', `l-${r.lane}`]} aria-hidden="true"></i>
            {r.label}
          </span>
          <svg class="ff-svg" viewBox="0 0 100 26" preserveAspectRatio="none" role="img" aria-label={`${r.label}: VND ${r.text} per share, ${signedPct(r.move, 1)} against the price used`}>
            {ticks.map((t) => (
              <line class={t === 0 ? 'ff-zero' : 'ff-grid'} x1={x(t)} x2={x(t)} y1="0" y2="26" vector-effect="non-scaling-stroke" />
            ))}
            <rect class={`ff-bar--${r.lane}`} x={r.x} y="6" width={r.w} height="14" rx="1.2" />
            {r.base !== null && <rect class="ff-base" x={r.base - 0.25} y="3" width="0.5" height="20" />}
          </svg>
          <span class="ff-detail-row__val">
            {r.text} <span class={r.move >= 0 ? 'up' : 'down'}>{signedPct(r.move, 1)}</span>
          </span>
        </div>
      ))}

  <div class:list={[models ? 'ff-axis' : 'ff-detail-row']} aria-hidden="true">
    <span></span>
    <span class="ff-axis__scale mono xsmall muted">
      {[MIN, MAX].map((t) => <span>{t > 0 ? '+' : t < 0 ? '−' : ''}{Math.abs(t)}%</span>)}
    </span>
    <span></span>
  </div>

  {legend && (
    <figcaption class="legend">
      {methodsUsed.map((mth) => (
        <span><i class={`l-${laneClass[mth]}`}></i>{outputMethodLabel[mth]}</span>
      ))}
      <span><i class="l-ref"></i>Price used (0%)</span>
      {!models && <span class="muted">Tick = base case</span>}
    </figcaption>
  )}
</figure>
