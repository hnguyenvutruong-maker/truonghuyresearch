---
import {
  formatOutput,
  impliedMovePct,
  outputMethodLabel,
  type ReferencePrice,
  type ValuationModel,
  type ValuationOutput,
} from '../../data/valuation-models';
import { formatDate, formatVndK, signedPct } from '../../lib/format';

interface Props {
  outputs?: ValuationOutput[];
  reference?: ReferencePrice;
  ticker?: string;
  note?: boolean;
  models?: ValuationModel[];
}

const { outputs, reference, ticker, models } = Astro.props;

const MIN_PCT = -35;
const MAX_PCT = 35;
const SPAN = MAX_PCT - MIN_PCT;
const toX = (pct: number) => {
  const clamped = Math.max(MIN_PCT, Math.min(MAX_PCT, pct));
  return Number((((clamped - MIN_PCT) / SPAN) * 100).toFixed(2));
};
const zeroX = toX(0);

const methodColorMap: Record<string, string> = {
  DCF: 'var(--brand-color-strong)',
  Comparable: 'var(--scheme-aqua-600)',
  Precedent: 'var(--scheme-violet-600)',
  LBO: 'var(--scheme-emerald-600)',
};

const listModels: ValuationModel[] = models
  ? models
  : outputs && reference && ticker
    ? [
        {
          slug: ticker.toLowerCase(),
          ticker,
          company: ticker,
          sector: '',
          methods: [],
          referencePrice: reference,
          outputs,
          summary: '',
          conclusion: '',
          valuationNotes: [],
          report: {
            headline: '',
            stance: '',
            thesis: [],
            assumptions: [],
            valuationResult: [],
            interpretation: [],
            risks: [],
            disclaimer: '',
          },
          downloads: [],
        },
      ]
    : [];

const rows = listModels.map((m) => {
  const moves = m.outputs.map((o) => impliedMovePct(o, m.referencePrice));
  const low = Math.min(...moves);
  const high = Math.max(...moves);
  const bars = m.outputs.map((o, idx) => {
    const lowPct = ((o.low - m.referencePrice.value) / m.referencePrice.value) * 100;
    const highPct = ((o.high - m.referencePrice.value) / m.referencePrice.value) * 100;
    const x1 = toX(Math.min(lowPct, highPct));
    const x2 = toX(Math.max(lowPct, highPct));
    return {
      method: o.method,
      label: outputMethodLabel[o.method],
      formatted: formatOutput(o),
      moveText: signedPct(impliedMovePct(o, m.referencePrice), 1),
      x: x1,
      width: Math.max(2.2, Number((x2 - x1).toFixed(2))),
      y: 4 + idx * 7,
      color: methodColorMap[o.method] ?? 'var(--brand-color-strong)',
    };
  });
  return {
    slug: m.slug,
    ticker: m.ticker,
    refText: `VND ${formatVndK(m.referencePrice.value)} (${formatDate(m.referencePrice.asOf)})`,
    spreadText: `${signedPct(low, 0)} to ${signedPct(high, 0)}`,
    bars,
  };
});
---

<div class="once-val-rows">
  {rows.map((row) => (
    <a href={`/research/${row.slug}`} class="once-val-row">
      <span class="once-val-ticker">{row.ticker}</span>
      <svg class="once-val-svg" viewBox="0 0 100 28" preserveAspectRatio="none" aria-hidden="true">
        <line x1={toX(-20)} y1="0" x2={toX(-20)} y2="28" stroke="var(--neutral-alpha-weak)" stroke-width="0.35" />
        <line x1={zeroX} y1="0" x2={zeroX} y2="28" stroke="var(--scheme-yellow-600)" stroke-width="0.65" />
        <line x1={toX(20)} y1="0" x2={toX(20)} y2="28" stroke="var(--neutral-alpha-weak)" stroke-width="0.35" />
        {row.bars.map((bar) => (
          <rect x={bar.x} y={bar.y} width={bar.width} height="5.5" rx="1.5" fill={bar.color} />
        ))}
      </svg>
      <span class="once-val-spread on-brand-weak">{row.spreadText}</span>
    </a>
  ))}
</div>
