---
// Weekly / monthly note page: header with figures, daily chart, cross-asset row, prose with a
// scroll-spied contents rail, reading progress and newer/earlier navigation.
import type { MarkdownHeading } from 'astro';
import Disclaimer from './Disclaimer.astro';
import Icon from './Icon.astro';
import PageHeader from './PageHeader.astro';
import VnIndexChart from './VnIndexChart.astro';
import { formatDate, formatIndex, formatNumber, signedNumber, signedPct } from '../../lib/format';
import type { NoteSummary } from '../../lib/notes';

interface Props {
  note: NoteSummary;
  headings: MarkdownHeading[];
  prev: NoteSummary | null;
  next: NoteSummary | null;
  listHref: string;
}

const { note, headings, prev, next, listHref } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
const unit = note.kind === 'Weekly' ? 'week' : 'month';
const toneTag = note.tone === 'positive' ? 'tag--up' : note.tone === 'negative' ? 'tag--down' : 'tag--amber';
---

<progress class="progress no-print" data-reading-progress value="0" max="100" aria-hidden="true"></progress>

<PageHeader
  crumbs={[{ href: '/market-views', label: 'Market notes' }, ...(note.kind === 'Monthly' ? [{ href: listHref, label: 'Monthly' }] : []), { label: note.period }]}
  title={note.headline}
>
  <div slot="before" class="row">
    <span class="tag tag--blue">{note.kind} market view</span>
    <span class="tag">{note.period}</span>
    <span class:list={['tag', toneTag]}>Tone: {note.tone}</span>
  </div>
  <div class="lockup">
    <strong>Nguyen Vu Truong Huy</strong><i></i>Published {formatDate(note.date)}<i></i>{note.kind} view · {note.period}
  </div>
  <dl slot="aside" class="facts facts--focus">
    <div><dt>VN-Index close</dt><dd>{formatIndex(note.close)}</dd></div>
    <div><dt>{note.kind === 'Weekly' ? 'Week' : 'Month'} change</dt><dd class={note.change >= 0 ? 'up' : 'down'}>{signedPct(note.change)}</dd></div>
    <div><dt>Avg daily liquidity</dt><dd>{formatNumber(note.liquidity, 0)} bn</dd></div>
    <div><dt>Foreign net</dt><dd class={note.foreignNet != null && note.foreignNet < 0 ? 'down' : 'up'}>{note.foreignNet != null ? `${signedNumber(note.foreignNet)} bn` : '—'}</dd></div>
  </dl>
</PageHeader>

<div class="container report report--two">
  {toc.length > 0 ? (
    <nav class="side-nav report__nav" aria-label="In this note" data-spy>
      <p class="side-nav__label eyebrow">In this note</p>
      {toc.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
    </nav>
  ) : <span class="report__nav"></span>}

  <div class="report__main">
    <div class="stats stats--4">
      <div class="stat">
        <div class="stat__label">Open → close</div>
        <div class="stat__value">{formatIndex(note.close)}</div>
        <div class="stat__sub">from {formatIndex(note.open)} · <span class={note.change >= 0 ? 'up' : 'down'}>{signedPct(note.change)}</span></div>
      </div>
      <div class="stat">
        <div class="stat__label">{unit === 'week' ? 'Weekly' : 'Monthly'} range</div>
        <div class="stat__value">{formatIndex(note.low)}–{formatIndex(note.high)}</div>
        <div class="stat__sub">low – high</div>
      </div>
      <div class="stat">
        <div class="stat__label">Foreign buy / sell</div>
        <div class="stat__value">{note.foreignBuy != null && note.foreignSell != null ? `${formatNumber(note.foreignBuy, 0)} / ${formatNumber(note.foreignSell, 0)}` : '—'}</div>
        <div class="stat__sub">bn VND over the {unit}</div>
      </div>
      {note.extras.length > 0 ? (
        <div class="stat">
          <div class="stat__label">{note.extras[0].label}</div>
          <div class="stat__value">{note.extras[0].value}</div>
          <div class="stat__sub">HOSE sessions</div>
        </div>
      ) : (
        <div class="stat">
          <div class="stat__label">Avg daily liquidity</div>
          <div class="stat__value">{formatNumber(note.liquidity, 0)}</div>
          <div class="stat__sub">bn VND</div>
        </div>
      )}
    </div>

    {note.extras.length > 1 && (
      <dl class="kv">
        {note.extras.slice(1).map((e) => (
          <div><dt class="kv__label">{e.label}</dt><dd class="kv__value">{e.value}</dd></div>
        ))}
      </dl>
    )}

    <div class="assets" aria-label={`Cross-asset change over the ${unit}`}>
      {note.macro.map((m) => (
        <div class="asset">
          <div class="asset__l">{m.label}</div>
          <div class="asset__v">{formatNumber(m.value, m.decimals)}</div>
          <div class:list={['asset__c', m.change == null ? 'dim' : m.change >= 0 ? 'up' : 'down']}>{signedPct(m.change)}</div>
        </div>
      ))}
    </div>

    {note.daily.length > 0 && (
      <section class="panel">
        <div class="panel__head">
          <span class="panel__title"><Icon name="chart" size={13} /> VN-Index daily OHLC</span>
          <span class="panel__meta">{note.daily.length} sessions</span>
        </div>
        <div class="panel__body">
          <VnIndexChart candleData={note.daily} label={`VN-Index daily candles, ${note.period}`} height="md" />
        </div>
      </section>
    )}

    <article class="panel">
      <div class="panel__head">
        <span class="panel__title"><Icon name="book" size={13} /> {note.kind} market view</span>
        <span class="panel__meta">{note.period}</span>
      </div>
      <div class="panel__body">
        <div class="prose" data-note-article>
          <slot />
        </div>
      </div>
    </article>

    <nav class="pager" aria-label="Adjacent notes">
      {prev ? (
        <a href={prev.href}><span class="pager__dir">← Earlier · {prev.period}</span><span class="pager__title">{prev.headline}</span></a>
      ) : <span></span>}
      {next && (
        <a class="is-next" href={next.href}><span class="pager__dir">Newer · {next.period} →</span><span class="pager__title">{next.headline}</span></a>
      )}
    </nav>
    <Disclaimer text="Market notes are drafted with language-model assistance and are not investment advice. VN-Index figures are measured; cross-asset values in notes up to 5 Jun 2026 may not be measured closes. Figures shown as — were unavailable at publication." />
  </div>
</div>

<script>
  const progress = document.querySelector<HTMLProgressElement>('[data-reading-progress]');
  const article = document.querySelector<HTMLElement>('[data-note-article]');
  if (progress && article) {
    const update = () => {
      const rect = article.getBoundingClientRect();
      const total = Math.max(1, article.offsetHeight - window.innerHeight * 0.5);
      progress.value = Math.round((Math.min(total, Math.max(0, -rect.top + window.innerHeight * 0.2)) / total) * 100);
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  // ←/→ jump to the adjacent note when not typing.
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement | null;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
    if (t?.closest?.('.table-scroll, [role="tablist"], [role="grid"], svg, .prose table')) return;
    if (e.metaKey || e.ctrlKey || e.altKey || document.querySelector('dialog[open]')) return;
    const links = document.querySelectorAll<HTMLAnchorElement>('.pager a');
    const prev = Array.from(links).find((a) => !a.classList.contains('is-next'));
    const next = Array.from(links).find((a) => a.classList.contains('is-next'));
    if (e.key === 'ArrowLeft' && prev) window.location.href = prev.href;
    if (e.key === 'ArrowRight' && next) window.location.href = next.href;
  });
</script>
