---
// A weekly or monthly note: the head with the close beside it, a band of figures on the surface ground,
// the daily chart when the note has one, the note body beside its contents, older and newer notes.
import type { MarkdownHeading } from 'astro';
import Disclaimer from './Disclaimer.astro';
import DocHead from './DocHead.astro';
import VnIndexChart from './VnIndexChart.astro';
import { formatIndex, formatNumber, signedNumber, signedPct } from '../../lib/format';
import type { NoteSummary } from '../../lib/notes';
interface Props { note: NoteSummary; headings: MarkdownHeading[]; prev: NoteSummary | null; next: NoteSummary | null; listHref: string }
const { note, headings, prev, next, listHref } = Astro.props;
const unit = note.kind === 'Weekly' ? 'week' : 'month';
const toc = headings.filter((h) => h.depth === 2);
const legacy = note.kind === 'Weekly' && note.date < new Date('2026-10-01T00:00:00Z');
const basis = legacy ? "In notes before October 2026 these changes may be the final session's move rather than week on week (a calculation error since corrected)." : `Changes are ${unit} on ${unit}.`;
const tone = (v: number | null) => (v == null ? 'muted' : v >= 0 ? 'up' : 'down');
const figures = [
  { label: 'Open', value: formatIndex(note.open) }, { label: 'High', value: formatIndex(note.high) }, { label: 'Low', value: formatIndex(note.low) },
  { label: 'Average liquidity, bn VND', value: formatNumber(note.liquidity, 0) },
  { label: 'Foreign net, bn VND', value: signedNumber(note.foreignNet), tone: tone(note.foreignNet) },
  ...note.extras,
];
---
<div class="doc">
  <DocHead label={`${note.kind} market note · ${note.period}`} title={note.headline} back={{ href: listHref, label: 'Market notes' }}>
    <dl slot="aside" class="facts">
      <div><dt>VN-Index close</dt><dd class="num t-h3">{formatIndex(note.close)}</dd></div>
      <div><dt>On the {unit}</dt><dd class:list={['num', tone(note.change)]}>{signedPct(note.change)}</dd></div>
      {note.macro.map((m) => <div><dt>{m.label}</dt><dd class="num">{formatNumber(m.value, m.decimals)} <span class:list={['t-label', tone(m.change)]}>{signedPct(m.change)}</span></dd></div>)}
    </dl>
  </DocHead>

  <section class="ground-surface">
    <div class="wrap stack-6">
      <dl class="grid">
        {figures.map((f) => <div class="span-2"><dt class="t-label muted">{f.label}</dt><dd class:list={['num t-lead', 'tone' in f ? f.tone : '']}>{f.value}</dd></div>)}
      </dl>
      <p class="t-label muted">{basis} A dash means the figure was unavailable when the note was written.</p>
      {note.daily.length > 0 && <div class="sheet"><p class="t-label">VN-Index daily, {note.period}</p><VnIndexChart candleData={note.daily} label={`VN-Index daily candles, ${note.period}`} height="md" /></div>}
    </div>
  </section>

  <section>
    <div class="wrap grid">
      {toc.length > 0 && (
        <nav class="span-3" aria-label="In this note">
          <p class="t-label muted">In this note</p>
          <ol class="rows">{toc.map((h) => <li><a class="t-small" href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      <article class:list={[toc.length > 0 ? 'span-8 start-5' : 'span-8']}><div class="prose"><slot /></div></article>
    </div>
  </section>

  <section class="ground-surface">
    <div class="wrap">
      <nav class="grid" aria-label={`${note.kind} notes`}>
        {prev ? <a class="card span-6" href={prev.href}><span class="t-label muted">← Older note, {prev.period}</span><h3>{prev.headline}</h3></a> : <span class="span-6"></span>}
        {next && <a class="card span-6" href={next.href}><span class="t-label muted">Newer note, {next.period} →</span><h3>{next.headline}</h3></a>}
      </nav>
      <Disclaimer />
    </div>
  </section>
</div>
