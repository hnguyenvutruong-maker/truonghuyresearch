---
import type { MarkdownHeading } from 'astro';
import VnIndexChart from './VnIndexChart.astro';
import { formatDate, formatIndex, formatNumber, signedNumber, signedPct } from '../../lib/format';
import type { NoteSummary } from '../../lib/notes';

interface Props {
  note: NoteSummary;
  headings: MarkdownHeading[];
  prev: NoteSummary | null;
  next: NoteSummary | null;
  listHref: string;
}

const { note, headings, prev, next, listHref } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2);
---

<div class="note-progress-track no-print" aria-hidden="true">
  <progress class="note-progress-bar" data-reading-progress value="0" max="100"></progress>
</div>

<!-- Once UI Blog Post Layout (magic-portfolio/src/app/blog/[slug]/page.tsx) -->
<div class="once-article-layout">
  <header class="once-article-header" data-reveal>
    <a class="once-smart-link" href={listHref}>
      <span class="label-strong-m on-brand-weak">← {note.kind} Market Notes</span>
    </a>
    <span class="body-default-xs on-neutral-weak">
      {formatDate(note.date)} · {note.period}
    </span>
    <h1 class="display-strong-m">{note.headline}</h1>

    <div class="once-post-author-row">
      <div class="once-post-author">
        <span class="once-avatar once-avatar-s" aria-hidden="true">TH</span>
        <span class="label-default-s on-brand-weak">Nguyen Vu Truong Huy · CFA Level II Passed</span>
      </div>
    </div>
  </header>

  <!-- Telemetry & Cross-Asset Scorecard Surface -->
  <section class="once-surface-card" data-reveal>
    <div class="once-Slide-header">
      <span class="once-slide-kicker">{note.kind} Session Telemetry · {note.period}</span>
      <span class="once-slide-meta">VN-Index Close: {formatIndex(note.close)} ({signedPct(note.change)})</span>
    </div>

    <div class="once-kpi-grid">
      <div class="once-kpi-box">
        <span class="once-kpi-label">VN-Index Close</span>
        <span class="once-kpi-value">{formatIndex(note.close)}</span>
        <span class="once-kpi-sub">{signedPct(note.change)} · Open {formatIndex(note.open)}</span>
      </div>
      <div class="once-kpi-box">
        <span class="once-kpi-label">High / Low Range</span>
        <span class="once-kpi-value">{formatIndex(note.high)} / {formatIndex(note.low)}</span>
        <span class="once-kpi-sub">Intoperiod trading range</span>
      </div>
      <div class="once-kpi-box">
        <span class="once-kpi-label">Avg Daily Liquidity</span>
        <span class="once-kpi-value">{formatNumber(note.liquidity, 0)} bn VND</span>
        <span class="once-kpi-sub">HOSE matched value</span>
      </div>
      <div class="once-kpi-box">
        <span class="once-kpi-label">Foreign Net Flow</span>
        <span class="once-kpi-value">
          {note.foreignNet != null ? `${signedNumber(note.foreignNet)} bn VND` : '—'}
        </span>
        <span class="once-kpi-sub">
          {note.foreignBuy != null && note.foreignSell != null
            ? `Buy ${formatNumber(note.foreignBuy, 0)} / Sell ${formatNumber(note.foreignSell, 0)} bn`
            : 'HOSE foreign institutional flow'}
        </span>
      </div>
    </div>

    {note.daily.length > 0 && (
      <div>
        <VnIndexChart
          candleData={note.daily}
          label={`${note.period} daily OHLC candlesticks`}
        />
      </div>
    )}
  </section>

  <!-- Main Article Prose + Sticky HeadingNav (blog/[slug]/page.tsx lines 145-171) -->
  <div class="once-article-grid">
    <article class="once-article-prose" data-note-article>
      <slot />
    </article>

    {tocHeadings.length > 0 && (
      <aside class="once-article-toc" aria-label="On this page">
        <span class="label-strong-s on-neutral-strong">On this page</span>
        {tocHeadings.map((h) => (
          <a class="once-toc-link" href={`#${h.slug}`} data-toc-link={h.slug}>
            <span>{h.text}</span>
          </a>
        ))}
      </aside>
    )}
  </div>

  <!-- Adjacent Posts (blog/[slug]/page.tsx lines 151-157) -->
  <section class="once-blog-section" data-reveal>
    <div class="once-line-h"></div>
    <h2 class="heading-strong-xl">Recent posts</h2>
    <div class="once-posts-grid">
      {next && (
        <a class="once-post-card is-surface" href={next.href}>
          <span class="label-strong-s on-brand-weak">← Newer · {formatDate(next.date)}</span>
          <h3 class="heading-strong-l">{next.headline}</h3>
          <span class="body-default-xs on-neutral-weak">VN-Index {formatIndex(next.close)} ({signedPct(next.change)})</span>
        </a>
      )}
      {prev && (
        <a class="once-post-card is-surface" href={prev.href}>
          <span class="label-strong-s on-neutral-weak">Earlier · {formatDate(prev.date)} →</span>
          <h3 class="heading-strong-l">{prev.headline}</h3>
          <span class="body-default-xs on-neutral-weak">VN-Index {formatIndex(prev.close)} ({signedPct(prev.change)})</span>
        </a>
      )}
    </div>
  </section>
</div>

<script>
  const progress = document.querySelector<HTMLProgressElement>('[data-reading-progress]');
  const article = document.querySelector<HTMLElement>('[data-note-article]');

  if (progress && article) {
    const updateProgress = () => {
      const rect = article.getBoundingClientRect();
      const total = Math.max(1, article.offsetHeight - window.innerHeight * 0.5);
      const scrolled = Math.min(total, Math.max(0, -rect.top));
      progress.value = Math.round((scrolled / total) * 100);
    };
    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  }
</script>
