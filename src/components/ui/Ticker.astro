---
// Coloured ticker square (Folio-style logo chip): first letter at row size, full ticker when large.
interface Props {
  label: string;
  size?: 'md' | 'lg' | 'xl';
  class?: string;
}
const { label, size = 'md', class: className } = Astro.props;
const known = ['hpg', 'bid', 'fpt', 'bmp', 'pnj'];
const key = label.toLowerCase();
---

<span
  class:list={['tick', known.includes(key) ? `tick--${key}` : 'tick--idx', size !== 'md' && `tick--${size}`, className]}
  aria-hidden="true">{size === 'md' ? label.slice(0, 1) : label}</span
>
