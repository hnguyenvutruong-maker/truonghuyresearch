---
// Sub-navigation across the five covered companies, with each one's implied-move band.
import Ticker from './Ticker.astro';
import { impliedMovePct, valuationModels } from '../../data/valuation-models';
import { signedPct } from '../../lib/format';

interface Props {
  current?: string;
}
const { current } = Astro.props;

const items = valuationModels.map((m) => {
  const moves = m.outputs.map((o) => impliedMovePct(o, m.referencePrice));
  return { slug: m.slug, ticker: m.ticker, band: `${signedPct(Math.min(...moves), 0)} / ${signedPct(Math.max(...moves), 0)}` };
});
---

<nav class="subnav no-print" aria-label="Covered companies">
  <div class="container subnav__inner">
    <a href="/research" aria-current={current ? undefined : 'page'}>
      <span class="tick tick--idx" aria-hidden="true">∑</span> All coverage
    </a>
    {items.map((i) => (
      <a href={`/research/${i.slug}`} aria-current={current === i.slug ? 'page' : undefined}>
        <Ticker label={i.ticker} />
        <strong>{i.ticker}</strong>
        <span class="num">{i.band}</span>
      </a>
    ))}
  </div>
</nav>
