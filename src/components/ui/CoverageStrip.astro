---
import { impliedMovePct, valuationModels } from '../../data/valuation-models';
import { signedPct } from '../../lib/format';

interface Props {
  current?: string;
  activeSlug?: string;
}

const { current, activeSlug } = Astro.props;
const active = current ?? activeSlug;

const items = valuationModels.map((model) => {
  const moves = model.outputs.map((o) => impliedMovePct(o, model.referencePrice));
  const low = Math.min(...moves);
  const high = Math.max(...moves);
  return {
    slug: model.slug,
    ticker: model.ticker,
    company: model.company,
    moveText: `${signedPct(low, 0)} / ${signedPct(high, 0)}`,
  };
});
---

<nav class="coverage-subbar no-print" aria-label="Covered companies">
  <div class="coverage-subbar-inner">
    {items.map((item) => (
      <a
        href={`/research/${item.slug}`}
        class:list={['coverage-pill', active === item.slug && 'is-active']}
        aria-current={active === item.slug ? 'page' : undefined}
      >
        <span class="coverage-pill-ticker">{item.ticker}</span>
        <span class="coverage-pill-name">{item.company}</span>
        <span class="coverage-pill-move">{item.moveText}</span>
      </a>
    ))}
  </div>
</nav>
