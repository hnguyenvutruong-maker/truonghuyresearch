---
// VN-Index levels & regime: a ruler of measured levels (latest week and month, from note frontmatter)
// plus the quarterly / monthly narrative and risk list kept by the bots' state files.
import { getCollection } from 'astro:content';
import quarterlyData from '../../content/market-views/_quarterly_summary.json';
import monthlyData from '../../content/monthly-views/_monthly_summary.json';
import Icon from './Icon.astro';
import { formatDate, formatIndex, formatMonth } from '../../lib/format';

const q = quarterlyData.summary;
const m = monthlyData.current_month;

const week = (await getCollection('market-views')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0]?.data;
const month = (await getCollection('monthly-views')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0]?.data;

type Level = { v: number; label: string; kind: 'sup' | 'res' | 'anchor' };
const raw: Level[] = [];
if (week) {
  raw.push({ v: week.vn_index_low, label: 'Week low', kind: 'sup' });
  raw.push({ v: week.vn_index_close, label: 'Week close', kind: 'anchor' });
  raw.push({ v: week.vn_index_high, label: 'Week high', kind: 'res' });
}
if (month) {
  raw.push({ v: month.vn_index_low, label: `${formatMonth(month.month_start).split(' ')[0]} low`, kind: 'sup' });
  raw.push({ v: month.vn_index_high, label: `${formatMonth(month.month_start).split(' ')[0]} high`, kind: 'res' });
}
const levels = raw.sort((a, b) => a.v - b.v);
const lo = Math.min(...levels.map((l) => l.v));
const hi = Math.max(...levels.map((l) => l.v));
const pad = Math.max((hi - lo) * 0.08, 5);
const x = (v: number) => Math.round(((v - (lo - pad)) / (hi - lo + pad * 2)) * 1000);
const anchor = levels.find((l) => l.kind === 'anchor');
---

<div class="window" data-macro-tracker>
  <div class="window__bar">
    <span class="window__title"><Icon name="chart" size={14} /> VN-Index levels &amp; regime</span>
    <span class="window__actions">
      <span class="seg" role="tablist" aria-label="Regime notes">
        <button type="button" role="tab" data-macro-tab="quarterly" aria-selected="true">{quarterlyData.quarter}</button>
        <button type="button" role="tab" data-macro-tab="monthly" aria-selected="false">{monthlyData.last_updated}</button>
        <button type="button" role="tab" data-macro-tab="risks" aria-selected="false">Risks <span class="count">{q.forward_risks.length}</span></button>
      </span>
    </span>
  </div>

  <div class="window__pad stack-6">
    {levels.length > 0 && anchor && (
      <div>
        <svg class="ruler-svg" viewBox="0 0 1000 64" preserveAspectRatio="none" role="img" aria-label={`Measured VN-Index levels from ${formatIndex(lo)} to ${formatIndex(hi)}`}>
          <rect class="r-track" x="0" y="29" width="1000" height="6" rx="3" />
          <rect class="r-band-sup" x={x(lo)} y="22" width={Math.max(x(anchor.v) - x(lo), 1)} height="20" rx="4" />
          <rect class="r-band-res" x={x(anchor.v)} y="22" width={Math.max(x(hi) - x(anchor.v), 1)} height="20" rx="4" />
          {levels.map((l) => (
            <line
              class={l.kind === 'anchor' ? 'r-anchor' : l.kind === 'sup' ? 'r-sup' : 'r-res'}
              x1={x(l.v)}
              x2={x(l.v)}
              y1={l.kind === 'anchor' ? 8 : 16}
              y2={l.kind === 'anchor' ? 56 : 48}
              stroke-width={l.kind === 'anchor' ? 3 : 2}
              vector-effect="non-scaling-stroke"
            />
          ))}
        </svg>
        <div class="levels">
          {levels.map((l) => (
            <div class="level">
              <div class:list={['level__v', l.kind === 'sup' ? 'up' : l.kind === 'res' ? 'down' : 'amber']}>{formatIndex(l.v)}</div>
              <div class="level__l">{l.label}</div>
            </div>
          ))}
        </div>
        <p class="xsmall muted">
          Measured from the latest weekly ({week ? formatDate(week.date) : '—'}) and monthly note frontmatter. Green: below the
          close; red: above it.
        </p>
      </div>
    )}

    <div id="macro-quarterly" data-macro-panel="quarterly" class="grid-2">
      <div class="stack-3">
        <p class="eyebrow">{quarterlyData.quarter} framework · updated {formatDate(quarterlyData.last_updated)}</p>
        <p class="small text-2">{q.macro_environment}</p>
        <dl class="kv">
          <div><dt class="kv__label">Support (framework)</dt><dd class="kv__detail">{q.technical_levels.support}</dd></div>
          <div><dt class="kv__label">Resistance (framework)</dt><dd class="kv__detail">{q.technical_levels.resistance}</dd></div>
        </dl>
      </div>
      <ul class="prose-list small">
        {q.key_themes.slice(0, 6).map((t) => <li>{t}</li>)}
      </ul>
    </div>

    <div data-macro-panel="monthly" class="grid-2" hidden>
      <div class="stack-3">
        <p class="eyebrow">{monthlyData.last_updated} regime</p>
        <p class="small text-2">{m.vn_index_trend}</p>
        <p class="small muted">{m.foreign_flow_direction}</p>
      </div>
      <ul class="prose-list small">
        {m.key_themes.map((t) => <li>{t}</li>)}
      </ul>
    </div>

    <div data-macro-panel="risks" hidden>
      <ul class="prose-list small">
        {q.forward_risks.map((r) => <li>{r}</li>)}
      </ul>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-macro-tracker]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-macro-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-macro-panel]'));
    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        panels.forEach((p) => (p.hidden = p.dataset.macroPanel !== tab.dataset.macroTab));
      })
    );
  });
</script>
