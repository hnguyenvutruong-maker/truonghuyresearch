---
import Seal from './Seal.astro';
import { portfolioDisclaimer } from '../../data/valuation-models';

const currentYear = new Date().getFullYear();

const links = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/trghuyy/', external: true },
  { label: 'CV', href: '/cv.pdf', external: true },
  { label: 'Contact', href: '/contact', external: false },
  { label: 'Disclaimer', href: '/disclaimer', external: false },
  { label: 'RSS', href: '/rss.xml', external: false },
];
---

<footer class="mt-auto w-full border-t-4 border-double border-ink print:hidden">
  <div class="mx-auto grid w-full max-w-container-max grid-cols-1 gap-10 px-margin-mobile py-14 md:grid-cols-12 md:px-margin-desktop">
    <div class="space-y-4 md:col-span-8">
      <div class="flex items-center gap-3">
        <span class="font-news text-[1.75rem] font-semibold tracking-[-0.02em] text-ink">
          Truong Huy <em class="font-normal italic text-oxblood">Research</em>
        </span>
        <Seal label="TH" size="sm" decorative />
      </div>
      <p class="max-w-xl font-news text-news-small italic text-ink-soft">
        Vietnam equity research, valuation models, and market notes by Nguyen Vu Truong Huy.
      </p>
      <p class="max-w-xl font-news text-news-data text-ink-muted">{portfolioDisclaimer}</p>
      <p class="font-news-mono text-news-label uppercase text-ink-muted">&copy; {currentYear} Nguyen Vu Truong Huy · Ho Chi Minh City</p>
    </div>
    <nav class="md:col-span-4 md:justify-self-end" aria-label="Footer">
      <ul class="flex flex-wrap gap-x-6 gap-y-3 md:flex-col md:items-end">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class="news-link font-news-mono text-news-label uppercase text-ink-soft transition-colors hover:text-oxblood"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>
