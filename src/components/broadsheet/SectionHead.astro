---
// Newspaper section front: double rule, section number, and the section title.
interface Props {
  numeral: string;
  label: string;
  title: string;
}

const { numeral, label, title } = Astro.props;
---

<header class="border-t-4 border-double border-ink pt-4" data-reveal>
  <div class="flex items-baseline justify-between gap-4">
    <p class="font-news-mono text-news-label uppercase text-oxblood">Section {numeral} · {label}</p>
    <slot name="aside" />
  </div>
  <h2 class="mt-3 font-news text-news-h2 text-ink">{title}</h2>
</header>
