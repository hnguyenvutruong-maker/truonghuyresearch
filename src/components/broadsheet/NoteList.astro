---
// Market-note index: notes grouped by year, newest first, with an optional
// All / Weekly / Monthly filter (client-side; every note is in the HTML).
import { formatIndex, signedPct, toneClass } from '../../lib/format';
import type { NoteSummary } from '../../lib/notes';

interface Props {
  notes: NoteSummary[];
  filter?: boolean;
}

const { notes, filter = false } = Astro.props;
const sorted = [...notes].sort((a, b) => b.date.valueOf() - a.date.valueOf());
const years = [...new Set(sorted.map((note) => note.date.getUTCFullYear()))];
const counts = {
  all: notes.length,
  weekly: notes.filter((note) => note.kind === 'Weekly').length,
  monthly: notes.filter((note) => note.kind === 'Monthly').length,
};
const filters = [
  { key: 'all', label: 'All notes', count: counts.all },
  { key: 'weekly', label: 'Weekly', count: counts.weekly },
  { key: 'monthly', label: 'Monthly', count: counts.monthly },
];
---

<div data-note-list>
  {filter && (
    <div role="group" aria-label="Filter notes" class="flex flex-wrap gap-2 border-b border-ink/25 pb-4">
      {filters.map((item, index) => (
        <button
          type="button"
          data-filter={item.key}
          aria-pressed={index === 0 ? 'true' : 'false'}
          class="inline-flex min-h-10 items-center gap-2 border border-ink px-4 py-2 font-news-mono text-news-label uppercase text-ink transition-colors hover:bg-paper-deep aria-pressed:bg-ink aria-pressed:text-paper"
        >
          {item.label} <span class="opacity-70">{item.count}</span>
        </button>
      ))}
    </div>
  )}

  {years.map((year) => (
    <section class="mt-10" data-year>
      <h2 class="flex items-baseline justify-between border-t-4 border-double border-ink pt-3">
        <span class="font-news text-news-h3 text-ink">{year}</span>
        <span class="font-news-mono text-news-label uppercase text-ink-muted" data-year-count></span>
      </h2>
      <ol class="mt-2">
        {sorted.filter((note) => note.date.getUTCFullYear() === year).map((note) => (
          <li class="border-b border-ink/20" data-kind={note.kind.toLowerCase()}>
            <a href={note.href} class="group grid grid-cols-1 gap-x-8 gap-y-2 py-5 md:grid-cols-12 md:items-baseline">
              <p class="font-news-mono text-news-label uppercase md:col-span-3">
                <span class={note.kind === 'Monthly' ? 'text-oxblood' : 'text-ink'}>{note.kind}</span>
                <span class="text-ink-muted"> · {note.period}</span>
              </p>
              <p class="font-news text-news-h4 text-ink transition-colors group-hover:text-oxblood md:col-span-7">{note.headline}</p>
              <p class="font-news-mono text-news-data tabular-nums text-ink-muted md:col-span-2 md:text-right">
                {formatIndex(note.close)} <span class={toneClass(note.change)}>{signedPct(note.change)}</span>
              </p>
            </a>
          </li>
        ))}
      </ol>
    </section>
  ))}
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-note-list]');
  const buttons = Array.from(root?.querySelectorAll<HTMLButtonElement>('button[data-filter]') ?? []);

  const apply = (kind: string) => {
    if (!root) return;
    root.querySelectorAll<HTMLElement>('li[data-kind]').forEach((item) => {
      item.hidden = kind !== 'all' && item.dataset.kind !== kind;
    });
    root.querySelectorAll<HTMLElement>('[data-year]').forEach((section) => {
      const visible = section.querySelectorAll('li[data-kind]:not([hidden])').length;
      section.hidden = visible === 0;
      const label = section.querySelector('[data-year-count]');
      if (label) label.textContent = `${visible} note${visible === 1 ? '' : 's'}`;
    });
    buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.filter === kind)));
  };

  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      const kind = button.dataset.filter ?? 'all';
      apply(kind);
      const url = new URL(window.location.href);
      if (kind === 'all') url.searchParams.delete('kind');
      else url.searchParams.set('kind', kind);
      history.replaceState(null, '', url);
    })
  );

  const initial = new URLSearchParams(window.location.search).get('kind');
  apply(initial === 'weekly' || initial === 'monthly' ? initial : 'all');
</script>
