---
import BaseLayout from '../layouts/BaseLayout.astro';
import Disclaimer from './ui/Disclaimer.astro';
import DocHead from './ui/DocHead.astro';
import Ticker from './ui/Ticker.astro';
import { methodPages, valuationGroups, valuationModels, type ValuationGroupId } from '../data/valuation-models';
import { publicFileSize } from '../lib/files';
import { formatDate, formatVndK } from '../lib/format';

interface Props { groupId: ValuationGroupId }
const { groupId } = Astro.props;
const group = valuationGroups.find((g) => g.id === groupId);
if (!group) throw new Error(`Unknown valuation group: ${groupId}`);
const nav = methodPages.map((p) => ({ ...p, title: valuationGroups.find((g) => g.id === p.id)?.title ?? p.id, active: p.id === groupId }));
const reports = valuationModels
  .map((model) => ({ model, notes: model.valuationNotes.filter((n) => n.groups.includes(groupId)), downloads: model.downloads.filter((d) => d.groups.includes(groupId)) }))
  .filter((r) => r.notes.length > 0);
---
<BaseLayout title={`${group.title}: valuation method | Truong Huy Research`} description={`${group.title}: ${group.description} Reports and workbooks for ${reports.map(({ model }) => model.ticker).join(', ')}.`}>
  <div class="doc">
    <DocHead label={`Valuation method · ${reports.length} report${reports.length === 1 ? '' : 's'}`} title={group.title} lead={group.description} back={{ href: '/research', label: 'Research coverage' }} />
    <nav aria-label="Valuation methods" class="wrap toc">{nav.map((n) => <a href={n.href} aria-current={n.active ? 'page' : undefined}>{n.title}</a>)}</nav>
    {reports.map(({ model, notes, downloads }, i) => (
      <section class:list={[i % 2 === 0 && 'ground-surface']} aria-labelledby={`m-${model.slug}`}>
        <div class="wrap grid grid--top">
          <div class="span-4 stack-4">
            <Ticker label={model.ticker} size="lg" />
            <h2 id={`m-${model.slug}`}>{model.company}</h2>
            <p class="t-small muted">{model.sector} · price used {formatVndK(model.referencePrice.value)} on {formatDate(model.referencePrice.asOf)}</p>
            <p>{model.summary}</p>
            <a class="link" href={`/research/${model.slug}`}>Read the {model.ticker} report</a>
          </div>
          <div class="span-7 start-6 stack-4">
            {notes.map((n) => (
              <article class="card">
                <p class="t-label muted">{n.method}</p>
                <h3 class="num">{n.price}</h3>
                <p>{n.assumptions}</p>
                <p class="muted">{n.result}</p>
              </article>
            ))}
            {downloads.length > 0 && <div class="btn-row">{downloads.map((d) => <a class="btn btn--secondary btn--sm" href={d.href} download>Download the {[d.label, d.format].filter(Boolean).join(' ')}{publicFileSize(d.href) ? ` (${publicFileSize(d.href)})` : ''}</a>)}</div>}
          </div>
        </div>
      </section>
    ))}
    <section><div class="wrap"><Disclaimer /></div></section>
  </div>
</BaseLayout>
