---
import Icon from './broadsheet/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import DisclaimerBox from './DisclaimerBox.astro';
import Seal from './broadsheet/Seal.astro';
import { methodPages, valuationGroups, valuationModels, type ValuationGroupId } from '../data/valuation-models';
import { formatDate, formatVndK } from '../lib/format';

interface Props {
  groupId: ValuationGroupId;
}

const { groupId } = Astro.props;
const group = valuationGroups.find((item) => item.id === groupId);
if (!group) {
  throw new Error(`Unknown valuation group: ${groupId}`);
}

const nav = methodPages.map((page) => ({
  ...page,
  title: valuationGroups.find((item) => item.id === page.id)?.title ?? page.id,
  active: page.id === groupId,
}));

const reports = valuationModels
  .map((model) => ({
    model,
    notes: model.valuationNotes.filter((note) => note.groups.includes(groupId)),
    downloads: model.downloads.filter((download) => download.groups.includes(groupId)),
  }))
  .filter((item) => item.notes.length > 0);
---

<BaseLayout
  title={`${group.title} | Valuation Methods | Truong Huy Research`}
  description={`${group.title}: ${group.description} Reports and workbooks for ${reports.map(({ model }) => model.ticker).join(', ')}.`}
>
  <section class="mx-auto w-full max-w-container-max px-margin-mobile pt-8 md:px-margin-desktop md:pt-10">
    <div class="flex animate-rise flex-wrap items-center justify-between gap-x-6 gap-y-1 border-b border-ink pb-2 font-news-mono text-news-label uppercase text-ink-muted">
      <a href="/research" class="news-link transition-colors hover:text-oxblood">← Coverage</a>
      <span>Valuation method · {reports.length} report{reports.length === 1 ? '' : 's'}</span>
    </div>
    <div class="border-b border-ink py-10">
      <p class="animate-rise font-news-mono text-news-label uppercase text-oxblood">{group.eyebrow}</p>
      <h1 class="mt-4 animate-rise text-balance font-news text-news-hero text-ink [animation-delay:80ms]">{group.title}</h1>
      <p class="mt-6 max-w-3xl animate-rise font-news text-news-dek italic text-ink-soft [animation-delay:160ms]">{group.description}</p>
    </div>
    <nav aria-label="Valuation methods" class="flex flex-wrap gap-x-6 gap-y-2 border-b border-ink/25 py-3 font-news-mono text-news-label uppercase">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={item.active ? 'page' : undefined}
          class:list={['news-link transition-colors hover:text-oxblood', item.active ? 'text-oxblood' : 'text-ink-soft']}
        >
          {item.title}
        </a>
      ))}
    </nav>
  </section>

  <section class="mx-auto w-full max-w-container-max px-margin-mobile py-12 md:px-margin-desktop">
    {reports.map(({ model, notes, downloads }) => (
      <article class="grid grid-cols-1 gap-8 border-b border-ink/25 py-10 first:pt-0 lg:grid-cols-12 lg:gap-0" data-reveal>
        <header class="lg:col-span-4 lg:pr-10">
          <a href={`/research/${model.slug}`} class="group flex items-start gap-4">
            <Seal label={model.ticker} size="md" motion="hover" />
            <span>
              <span class="block font-news text-news-h3 text-ink transition-colors group-hover:text-oxblood">{model.company}</span>
              <span class="mt-1 block font-news-mono text-news-label uppercase text-ink-muted">{model.sector}</span>
            </span>
          </a>
          <p class="mt-4 font-news text-news-small text-ink-soft">{model.summary}</p>
          <p class="mt-3 font-news-mono text-news-label uppercase text-ink-muted">
            Price used {formatVndK(model.referencePrice.value)} · {formatDate(model.referencePrice.asOf)}
          </p>
        </header>

        <div class="lg:col-span-8 lg:border-l lg:border-ink/25 lg:pl-10">
          {notes.map((note) => (
            <div class="border-b border-ink/15 pb-5 [&+&]:pt-5">
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                <p class="font-news-mono text-news-label uppercase text-ink-muted">{note.method}</p>
                <p class="font-news text-news-h4 lining-nums tabular-nums text-ink">{note.price}</p>
              </div>
              <p class="mt-3 font-news text-news-small text-ink">{note.assumptions}</p>
              <p class="mt-2 font-news text-news-small italic text-ink-soft">{note.result}</p>
            </div>
          ))}
          <div class="mt-5 flex flex-wrap items-center gap-3">
            <a href={`/research/${model.slug}`} class="inline-flex min-h-11 items-center gap-2 bg-ink px-4 py-2 font-news-mono text-news-label uppercase text-paper transition-colors hover:bg-oxblood hover:text-paper">
              Read the {model.ticker} report <Icon name="arrow_forward" size={16} />
            </a>
            {downloads.map((download) => (
              <a href={download.href} download class="inline-flex min-h-11 items-center gap-2 border border-ink px-4 py-2 font-news-mono text-news-label uppercase text-ink transition-colors hover:bg-ink hover:text-paper">
                <Icon name="download" size={18} /> {download.label} · {download.format}
              </a>
            ))}
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="mx-auto w-full max-w-container-max px-margin-mobile pb-16 md:px-margin-desktop">
    <DisclaimerBox />
  </section>
</BaseLayout>
