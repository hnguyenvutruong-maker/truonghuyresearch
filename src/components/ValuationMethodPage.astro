---
import BaseLayout from '../layouts/BaseLayout.astro';
import FootballField from './ui/FootballField.astro';
import { methodPages, valuationGroups, valuationModels, type ValuationGroupId } from '../data/valuation-models';
import { publicFileSize } from '../lib/files';
import { formatDate, formatVndK } from '../lib/format';

interface Props {
  groupId: ValuationGroupId;
}
const { groupId } = Astro.props;
const group = valuationGroups.find((g) => g.id === groupId);
if (!group) throw new Error(`Unknown valuation group: ${groupId}`);

const nav = methodPages.map((p) => {
  const g = valuationGroups.find((item) => item.id === p.id);
  const count = valuationModels.filter((m) => m.valuationNotes.some((n) => n.groups.includes(p.id))).length;
  return {
    ...p,
    title: g?.title ?? p.id,
    eyebrow: g?.eyebrow ?? '',
    count,
    active: p.id === groupId,
  };
});

const reports = valuationModels
  .map((model) => ({
    model,
    notes: model.valuationNotes.filter((n) => n.groups.includes(groupId)),
    downloads: model.downloads.filter((d) => d.groups.includes(groupId)),
  }))
  .filter((r) => r.notes.length > 0);
---

<BaseLayout
  title={`${group.title}: valuation methodology | Truong Huy Research`}
  description={`${group.title}: ${group.description} Reports and open Excel workbooks for ${reports.map(({ model }) => model.ticker).join(', ')}.`}
>
  <div class="once-col-m">
    <section class="once-hero" data-reveal>
      <a class="once-smart-link" href="/research">
        <span class="label-strong-m on-brand-weak">← Projects &amp; Research</span>
      </a>
      <div class="once-hero-badge-wrap">
        <span class="once-badge">
          <strong>{group.eyebrow}</strong>
          <span class="once-badge-divider" aria-hidden="true"></span>
          <span class="on-brand-medium">{reports.map((r) => r.model.ticker).join(' · ')}</span>
        </span>
      </div>
      <div class="once-hero-title-wrap">
        <h1 class="display-strong-m">{group.title}</h1>
      </div>
      <p class="heading-default-xl on-neutral-weak">{group.description}</p>

      <div class="filter-pills" role="navigation" aria-label="Valuation methods">
        {nav.map((n) => (
          <a
            href={n.href}
            class:list={['filter-pill', n.active && 'is-active']}
            aria-current={n.active ? 'page' : undefined}
          >
            {n.title} ({n.count})
          </a>
        ))}
      </div>
    </section>

    <section class="once-projects-list">
      {reports.map(({ model, notes, downloads }) => (
        <article class="once-surface-card" data-reveal>
          <div class="once-Slide-header">
            <h2 class="heading-strong-xl">{model.ticker} — {model.company}</h2>
            <span class="once-slide-meta">
              Price used: VND {formatVndK(model.referencePrice.value)} ({formatDate(model.referencePrice.asOf)})
            </span>
          </div>

          <FootballField outputs={model.outputs} reference={model.referencePrice} ticker={model.ticker} />

          <div class="once-kpi-grid">
            {notes.map((n) => (
              <div class="once-kpi-box">
                <span class="once-kpi-label">{n.method}</span>
                <span class="once-kpi-value">{n.price}</span>
                <span class="once-kpi-sub">{n.assumptions} · {n.result}</span>
              </div>
            ))}
          </div>

          <div class="once-project-links">
            <a class="once-smart-link" href={`/research/${model.slug}`}>
              <span>Read {model.ticker} case study</span>
              <span class="once-arrow-icon" aria-hidden="true">→</span>
            </a>
            <a class="once-smart-link" href={`/research/${model.slug}/tear-sheet`}>
              <span>A4 Tear Sheet</span>
              <span class="once-arrow-icon" aria-hidden="true">↗</span>
            </a>
            {downloads.map((d) => (
              <a class="once-smart-link" href={d.href} download>
                <span>
                  Download {[d.label, d.format].filter(Boolean).join(' ')}
                  {publicFileSize(d.href) ? ` (${publicFileSize(d.href)})` : ''}
                </span>
                <span class="once-arrow-icon" aria-hidden="true">↓</span>
              </a>
            ))}
          </div>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>
