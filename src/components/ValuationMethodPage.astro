---
import BaseLayout from '../layouts/BaseLayout.astro';
import Disclaimer from './ui/Disclaimer.astro';
import FootballField from './ui/FootballField.astro';
import Icon from './ui/Icon.astro';
import PageHeader from './ui/PageHeader.astro';
import Ticker from './ui/Ticker.astro';
import { methodPages, valuationGroups, valuationModels, type ValuationGroupId } from '../data/valuation-models';
import { publicFileSize } from '../lib/files';
import { formatDate, formatVndK } from '../lib/format';

interface Props {
  groupId: ValuationGroupId;
}
const { groupId } = Astro.props;
const group = valuationGroups.find((g) => g.id === groupId);
if (!group) throw new Error(`Unknown valuation group: ${groupId}`);

const nav = methodPages.map((p) => {
  const g = valuationGroups.find((item) => item.id === p.id);
  return {
    ...p,
    title: g?.title ?? p.id,
    count: valuationModels.filter((m) => m.valuationNotes.some((n) => n.groups.includes(p.id))).length,
    active: p.id === groupId,
  };
});

const reports = valuationModels
  .map((model) => ({
    model,
    notes: model.valuationNotes.filter((n) => n.groups.includes(groupId)),
    downloads: model.downloads.filter((d) => d.groups.includes(groupId)),
  }))
  .filter((r) => r.notes.length > 0);
---

<BaseLayout
  title={`${group.title}: valuation methodology | Truong Huy Research`}
  description={`${group.title}: ${group.description} Reports and open Excel workbooks for ${reports.map(({ model }) => model.ticker).join(', ')}.`}
>
  <PageHeader
    crumbs={[{ href: '/research', label: 'Coverage' }, { label: 'Methods' }, { label: group.title }]}
    eyebrow={group.eyebrow}
    title={group.title}
    lead={group.description}
  >
    <nav class="seg" aria-label="Valuation methods">
      {nav.map((n) => (
        <a href={n.href} aria-current={n.active ? 'page' : undefined}>
          {n.title} <span class="count">{n.count}</span>
        </a>
      ))}
    </nav>
    <dl slot="aside" class="facts facts--focus">
      <div><dt>Prices used as of</dt><dd>{formatDate(valuationModels[0].referencePrice.asOf)}</dd></div>
      <div><dt>Companies</dt><dd>{reports.length}</dd></div>
      <div><dt>Workbooks</dt><dd>{reports.reduce((t, r) => t + r.downloads.length, 0)}</dd></div>
      <div><dt>Tickers</dt><dd>{reports.map((r) => r.model.ticker).join(' · ')}</dd></div>
    </dl>
  </PageHeader>

  <div class="container ws">
    {reports.map(({ model, notes, downloads }) => (
      <article class="panel col-12">
        <div class="panel__head">
          <span class="panel__title"><Ticker label={model.ticker} /> {model.company}</span>
          <span class="panel__actions"><span class="tag">Price used {formatVndK(model.referencePrice.value)}</span></span>
        </div>
        <div class="panel__body stack-3">
          <FootballField outputs={model.outputs} reference={model.referencePrice} ticker={model.ticker} legend={false} />
          <dl class="kv">
            {notes.map((n) => (
              <div>
                <dt class="kv__label">{n.method}</dt>
                <dd class="kv__value">{n.price}</dd>
                <dd class="kv__detail">{n.assumptions}</dd>
                <dd class="kv__detail">{n.result}</dd>
              </div>
            ))}
          </dl>
          <div class="btn-row">
            <a class="btn btn--primary btn--sm" href={`/research/${model.slug}`}>{model.ticker} report <Icon name="arrow_right" size={12} /></a>
            <a class="btn btn--ghost btn--sm" href={`/research/${model.slug}/tear-sheet`}><Icon name="printer" size={12} /> A4</a>
            {downloads.map((d) => {
              const size = publicFileSize(d.href);
              return (
                <a class="btn btn--ghost btn--sm" href={d.href} download>
                  <Icon name="download" size={12} /> {d.label} {d.format}{size ? ` · ${size}` : ''}
                </a>
              );
            })}
          </div>
        </div>
      </article>
    ))}
    <div class="col-24"><Disclaimer /></div>
  </div>
</BaseLayout>
