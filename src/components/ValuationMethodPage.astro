---
// ValuationMethodPage: renders each methodology hub (/research/dcf, /comparable-analysis, /precedent-transactions-lbo)
import BaseLayout from '../layouts/BaseLayout.astro';
import Disclaimer from './ui/Disclaimer.astro';
import DocHead from './ui/DocHead.astro';
import FootballField from './ui/FootballField.astro';
import Ticker from './ui/Ticker.astro';
import { methodPages, valuationGroups, valuationModels, type ValuationGroupId } from '../data/valuation-models';
import { publicFileSize } from '../lib/files';
import { formatDate, formatVndK } from '../lib/format';

interface Props {
  groupId: ValuationGroupId;
}
const { groupId } = Astro.props;
const group = valuationGroups.find((g) => g.id === groupId);
if (!group) throw new Error(`Unknown valuation group: ${groupId}`);

const nav = methodPages.map((p) => {
  const g = valuationGroups.find((item) => item.id === p.id);
  const count = valuationModels.filter((m) => m.valuationNotes.some((n) => n.groups.includes(p.id))).length;
  return {
    ...p,
    title: g?.title ?? p.id,
    eyebrow: g?.eyebrow ?? '',
    count,
    active: p.id === groupId,
  };
});

const reports = valuationModels
  .map((model) => ({
    model,
    notes: model.valuationNotes.filter((n) => n.groups.includes(groupId)),
    downloads: model.downloads.filter((d) => d.groups.includes(groupId)),
  }))
  .filter((r) => r.notes.length > 0);
---

<BaseLayout
  title={`${group.title}: valuation methodology | Truong Huy Research`}
  description={`${group.title}: ${group.description} Reports and open Excel workbooks for ${reports.map(({ model }) => model.ticker).join(', ')}.`}
>
  <div class="doc">
    <DocHead
      label={`Valuation Methodology · ${group.eyebrow} · ${reports.length} Covered Issuers`}
      title={group.title}
      lead={group.description}
      back={{ href: '/research', label: 'Research Coverage' }}
    >
      <div slot="aside" class="facts">
        <div>
          <dt>Framework</dt>
          <dd>{group.title} ({group.eyebrow})</dd>
        </div>
        <div>
          <dt>Issuers Applied</dt>
          <dd class="mono">{reports.map((r) => r.model.ticker).join(' · ')}</dd>
        </div>
        <div>
          <dt>Open Workbooks</dt>
          <dd class="mono">{reports.reduce((acc, r) => acc + r.downloads.length, 0)} downloadable files</dd>
        </div>
      </div>
    </DocHead>

    <div class="toc-bar no-print">
      <nav aria-label="Valuation methods" class="wrap toc">
        {nav.map((n) => (
          <a href={n.href} aria-current={n.active ? 'page' : undefined}>
            {n.title} ({n.count})
          </a>
        ))}
      </nav>
    </div>

    {reports.map(({ model, notes, downloads }, i) => (
      <section class:list={[i % 2 === 0 && 'ground-surface']} aria-labelledby={`m-${model.slug}`}>
        <div class="wrap grid grid--top">
          <div class="span-5 stack-4">
            <div class="desk-selector__title">
              <Ticker label={model.ticker} size="lg" />
              <div>
                <span class="eyebrow">{model.sector}</span>
                <h2 id={`m-${model.slug}`}>{model.company}</h2>
              </div>
            </div>
            <p class="mono t-label muted">
              Price used: VND {formatVndK(model.referencePrice.value)} ({formatDate(model.referencePrice.asOf)})
            </p>
            <p class="secondary">{model.summary}</p>
            <FootballField outputs={model.outputs} reference={model.referencePrice} ticker={model.ticker} />
            <div class="btn-row">
              <a class="btn btn--primary btn--sm" href={`/research/${model.slug}`}>
                Read Full {model.ticker} Report
              </a>
              <a class="btn btn--secondary btn--sm" href={`/research/${model.slug}/tear-sheet`}>
                A4 Tear Sheet
              </a>
            </div>
          </div>

          <div class="span-7 stack-4">
            {notes.map((n) => (
              <article class="sheet sheet--accent stack-3">
                <div class="sheet__head">
                  <span class="eyebrow">{n.method} Output</span>
                  <span class="badge badge--navy num">{n.price}</span>
                </div>
                <p class="t-small"><strong>Calibration &amp; Inputs:</strong> {n.assumptions}</p>
                <p class="t-small muted"><strong>Analytical Read:</strong> {n.result}</p>
              </article>
            ))}

            {downloads.length > 0 && (
              <div class="sheet stack-3">
                <span class="eyebrow">Open Excel Workbooks ({group.title})</span>
                <div class="btn-row">
                  {downloads.map((d) => (
                    <a class="btn btn--secondary btn--sm" href={d.href} download>
                      Download {[d.label, d.format].filter(Boolean).join(' ')}
                      {publicFileSize(d.href) ? ` (${publicFileSize(d.href)})` : ''}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </section>
    ))}

    <section>
      <div class="wrap">
        <Disclaimer />
      </div>
    </section>
  </div>
</BaseLayout>
