---
import BaseLayout from '../layouts/BaseLayout.astro';
import Disclaimer from './ui/Disclaimer.astro';
import Icon from './ui/Icon.astro';
import PageHeader from './ui/PageHeader.astro';
import Panel from './ui/Panel.astro';
import Tick from './ui/Tick.astro';
import { methodPages, valuationGroups, valuationModels, type ValuationGroupId } from '../data/valuation-models';
import { publicFileSize } from '../lib/files';
import { formatDate, formatVndK } from '../lib/format';

interface Props {
  groupId: ValuationGroupId;
}

const { groupId } = Astro.props;
const group = valuationGroups.find((item) => item.id === groupId);
if (!group) {
  throw new Error(`Unknown valuation group: ${groupId}`);
}

const nav = methodPages.map((page) => ({
  ...page,
  title: valuationGroups.find((item) => item.id === page.id)?.title ?? page.id,
  active: page.id === groupId,
}));

const reports = valuationModels
  .map((model) => ({
    model,
    notes: model.valuationNotes.filter((note) => note.groups.includes(groupId)),
    downloads: model.downloads.filter((download) => download.groups.includes(groupId)),
  }))
  .filter((item) => item.notes.length > 0);
---

<BaseLayout
  title={`${group.title} | Valuation Methods | Truong Huy Research`}
  description={`${group.title}: ${group.description} Reports and workbooks for ${reports.map(({ model }) => model.ticker).join(', ')}.`}
>
  <div class="mx-auto w-full max-w-container-max space-y-4 px-margin-mobile py-6 md:px-margin-desktop md:py-8">
    <PageHeader
      tone="value"
      kicker={group.eyebrow}
      title={group.title}
      lead={group.description}
      back={{ href: '/research', label: 'Coverage' }}
      context={`Valuation method · ${reports.length} report${reports.length === 1 ? '' : 's'}`}
    />

    <nav aria-label="Valuation methods" class="flex flex-wrap gap-2">
      {nav.map((item) => (
        <a
          href={item.href}
          aria-current={item.active ? 'page' : undefined}
          class:list={[
            'border px-3 py-1.5 font-mono text-[0.8125rem] font-semibold shadow-panel transition-colors',
            item.active ? 'border-value bg-value text-white hover:text-white' : 'border-line bg-panel text-fg hover:border-value hover:text-link',
          ]}
        >
          {item.title}
        </a>
      ))}
    </nav>

    {reports.map(({ model, notes, downloads }) => (
      <Panel title={`${model.ticker} · ${model.company}`} meta={`Price used ${formatVndK(model.referencePrice.value)} · ${formatDate(model.referencePrice.asOf)}`} tone="value" reveal>
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <a href={`/research/${model.slug}`} class="group flex items-start gap-3">
              <Tick label={model.ticker} />
              <span>
                <span class="block font-display text-h3 text-fg transition-colors group-hover:text-link">{model.company}</span>
                <span class="mt-0.5 block font-mono text-[0.75rem] text-fg-muted">{model.sector}</span>
              </span>
            </a>
            <p class="mt-3 text-small text-fg">{model.summary}</p>
          </div>
          <div class="space-y-4 lg:col-span-8">
            {notes.map((note) => (
              <div class="border border-line">
                <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 bg-panel-alt px-4 py-2">
                  <p class="font-mono text-label uppercase text-value-ink">{note.method}</p>
                  <p class="font-mono text-[0.9375rem] font-semibold tabular-nums text-fg">{note.price}</p>
                </div>
                <div class="space-y-2 px-4 py-3">
                  <p class="text-small text-fg">{note.assumptions}</p>
                  <p class="text-small text-fg-muted">{note.result}</p>
                </div>
              </div>
            ))}
            <div class="flex flex-wrap items-center gap-2">
              <a href={`/research/${model.slug}`} class="inline-flex min-h-11 items-center gap-2 bg-value px-4 py-2 font-mono text-[0.8125rem] font-semibold text-white transition-colors hover:bg-[#0A858D] hover:text-white">
                Read the {model.ticker} report <Icon name="arrow_forward" size={16} />
              </a>
              {downloads.map((download) => (
                <a href={download.href} download class="inline-flex min-h-11 items-center gap-2 border border-line-strong px-4 py-2 font-mono text-[0.8125rem] font-semibold text-fg transition-colors hover:border-fg hover:bg-panel-alt">
                  <Icon name="download" size={18} /> {[download.label, download.format, publicFileSize(download.href)].filter(Boolean).join(' · ')}
                </a>
              ))}
            </div>
          </div>
        </div>
      </Panel>
    ))}

    <Disclaimer />
  </div>
</BaseLayout>
