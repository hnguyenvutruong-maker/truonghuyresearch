---
// One-page A4 tear sheet per company, the printable summary behind /research/<slug>; exported to
// public/research/tear-sheets/<slug>.pdf by `npm run tear-sheets`.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FootballField from '../../../components/ui/FootballField.astro';
import { formatOutput, impliedMovePct, outputMethodLabel, portfolioDisclaimer, valuationModels } from '../../../data/valuation-models';
import { publicFileSize } from '../../../lib/files';
import { formatDate, formatVndK, signedPct } from '../../../lib/format';

export function getStaticPaths() {
  return valuationModels.map((model) => ({ params: { slug: model.slug }, props: { model } }));
}
const { model } = Astro.props;
const reference = model.referencePrice;
const modelDate = model.lastUpdated ?? reference.asOf;
const assumptions = (model.keyAssumptions ?? model.report.assumptions).slice(0, 5);
const risks = model.report.risks.slice(0, 3);
const pdfHref = `/research/tear-sheets/${model.slug}.pdf`;
const pdfSize = publicFileSize(pdfHref);
const moves = model.outputs.map((o) => impliedMovePct(o, reference));
const lowMove = Math.min(...moves);
const highMove = Math.max(...moves);
const lowVnd = Math.min(...model.outputs.map((o) => Math.min(o.low, o.high)));
const highVnd = Math.max(...model.outputs.map((o) => Math.max(o.low, o.high)));
---

<BaseLayout
  title={`${model.company} (${model.ticker}) tear sheet | Truong Huy Research`}
  description={`One-page summary of the ${model.company} (${model.ticker}) valuation: methods, outputs against the price used, key assumptions and risks.`}
  image={`/og/research/${model.slug}.png`}
>
  <div class="tear">
    <div class="no-print tear__bar">
      <a class="btn btn--ghost btn--sm" href={`/research/${model.slug}`}>← Full {model.ticker} report</a>
      <div class="btn-row">
        {pdfSize && (
          <a class="btn btn--primary btn--sm" href={pdfHref} download>
            Download PDF ({pdfSize})
          </a>
        )}
        <button type="button" class="btn btn--ghost btn--sm" data-print>
          Print / save as PDF
        </button>
      </div>
    </div>

    <article class="ts">
      <header class="ts__top">
        <div>
          <p class="ts__brand">Truong Huy Research · Equity tear sheet</p>
          <p class="ts__cred">Nguyen Vu Truong Huy · UEH Finance &amp; Banking · Passed Level II of the CFA Program</p>
        </div>
        <p class="ts__cred">{model.ticker} · HOSE · Model of {formatDate(modelDate)}</p>
      </header>

      <div class="ts__title">
        <div>
          <p class="eyebrow">{model.sector} · {model.methods.join(' · ')}</p>
          <h1>{model.company} ({model.ticker})</h1>
          <p class="small text-2">{model.report.headline}</p>
        </div>
        <dl class="ts__box">
          <div><dt>Price used</dt><dd>VND {formatVndK(reference.value)}</dd></div>
          <div><dt>Price date</dt><dd>{formatDate(reference.asOf)}</dd></div>
          <div><dt>Range</dt><dd>{formatVndK(lowVnd)}–{formatVndK(highVnd)}</dd></div>
          <div><dt>Implied move</dt><dd>{signedPct(lowMove, 0)} / {signedPct(highMove, 0)}</dd></div>
        </dl>
      </div>

      <FootballField outputs={model.outputs} reference={reference} ticker={model.ticker} />

      <div class="ts__cols">
        <section>
          <h2 class="ts__h">Outputs, VND per share</h2>
          <table class="ts__table">
            <tbody>
              {model.outputs.map((o) => {
                const mv = impliedMovePct(o, reference);
                return (
                  <tr>
                    <th scope="row">{outputMethodLabel[o.method]}</th>
                    <td class="num">{formatOutput(o)}</td>
                    <td class:list={['num', mv >= 0 ? 'up' : 'down']}>{signedPct(mv, 1)}</td>
                  </tr>
                );
              })}
              <tr>
                <th scope="row" class="muted">Price used</th>
                <td class="num ts__price">{formatVndK(reference.value)}</td>
                <td class="mono muted">{formatDate(reference.asOf)}</td>
              </tr>
            </tbody>
          </table>
          {model.investmentQuestion && <p class="ts__q">{model.investmentQuestion}</p>}
        </section>

        <section>
          <h2 class="ts__h">Key assumptions</h2>
          <dl class="ts__dl">
            {assumptions.map((a) => (
              <div>
                <dt class="muted">{a.label}</dt>
                <dd>{a.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      </div>

      <section>
        <h2 class="ts__h">Conclusion</h2>
        <p class="small">{model.conclusion}</p>
      </section>

      <section>
        <h2 class="ts__h">Key risks</h2>
        <ol class="ts__risks">
          {risks.map((r, i) => (
            <li>
              <span class="mono muted">0{i + 1}</span>
              <span>{r}</span>
            </li>
          ))}
        </ol>
      </section>

      <footer class="ts__foot">
        <p>{portfolioDisclaimer} Figures are as of the model date and are not refreshed automatically.</p>
        <p class="mono">Nguyen Vu Truong Huy · truonghuyresearch.xyz/research/{model.slug}</p>
      </footer>
    </article>
  </div>
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
