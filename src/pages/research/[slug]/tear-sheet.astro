---
// One-page A4 tear sheet per company, the printable summary behind /research/<slug>; exported to
// public/research/tear-sheets/<slug>.pdf by `npm run tear-sheets`.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FootballField from '../../../components/ui/FootballField.astro';
import Ticker from '../../../components/ui/Ticker.astro';
import { formatOutput, impliedMovePct, outputMethodLabel, portfolioDisclaimer, valuationModels } from '../../../data/valuation-models';
import { formatDate, formatVndK, signedPct } from '../../../lib/format';

export function getStaticPaths() {
  return valuationModels.map((model) => ({ params: { slug: model.slug }, props: { model } }));
}
const { model } = Astro.props;
const reference = model.referencePrice;
const modelDate = model.lastUpdated ?? reference.asOf;
const assumptions = (model.keyAssumptions ?? model.report.assumptions).slice(0, 5);
const risks = model.report.risks.slice(0, 3);
---
<BaseLayout title={`${model.company} (${model.ticker}) tear sheet | Truong Huy Research`} description={`One-page summary of the ${model.company} (${model.ticker}) valuation: methods, outputs against the price used, key assumptions and risks.`} image={`/og/research/${model.slug}.png`}>
  <div class="tear">
    <div class="no-print tear__bar">
      <a class="back" href={`/research/${model.slug}`}>← Full report</a>
      <button type="button" class="btn btn--secondary btn--sm" data-print>Print or save as PDF</button>
    </div>
    <article class="ts">
      <header class="ts__top"><span class="ts__brand">Truong Huy <span class="muted">Research</span></span><span class="t-label muted">Tear sheet, model of {formatDate(modelDate)}</span></header>
      <div class="ts__title">
        <Ticker label={model.ticker} size="lg" />
        <div>
          <p class="t-label muted">{model.sector} · {model.methods.join(', ')}</p>
          <h1>{model.company}</h1>
          <p class="t-small muted">{model.report.headline}</p>
        </div>
      </div>
      <FootballField outputs={model.outputs} reference={reference} ticker={model.ticker} />
      <div class="ts__cols">
        <section>
          <h2 class="ts__h">Outputs, VND per share</h2>
          <table class="ts__table">
            <tbody>
              {model.outputs.map((o) => { const mv = impliedMovePct(o, reference); return <tr><th scope="row">{outputMethodLabel[o.method]}</th><td class="num">{formatOutput(o)}</td><td class:list={['num', mv >= 0 ? 'up' : 'down']}>{signedPct(mv, 1)}</td></tr>; })}
              <tr><th scope="row" class="muted">Price used</th><td class="num ts__price">{formatVndK(reference.value)}</td><td class="muted">{formatDate(reference.asOf)}</td></tr>
            </tbody>
          </table>
          {model.investmentQuestion && <p class="ts__q">{model.investmentQuestion}</p>}
        </section>
        <section>
          <h2 class="ts__h">Key assumptions</h2>
          <dl class="ts__dl">{assumptions.map((a) => <div><dt class="muted">{a.label}</dt><dd>{a.value}</dd></div>)}</dl>
        </section>
      </div>
      <section><h2 class="ts__h">Conclusion</h2><p class="t-small">{model.conclusion}</p></section>
      <section><h2 class="ts__h">Key risks</h2><ol class="ts__risks">{risks.map((r, i) => <li><span class="muted">{i + 1}</span><span>{r}</span></li>)}</ol></section>
      <footer class="ts__foot"><p>{portfolioDisclaimer} Figures are as of the model date and are not refreshed automatically.</p><p>Nguyen Vu Truong Huy · truonghuyresearch.xyz/research/{model.slug}</p></footer>
    </article>
  </div>
</BaseLayout>
<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
