---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CoverageStrip from '../../../components/ui/CoverageStrip.astro';
import FootballField from '../../../components/ui/FootballField.astro';
import SensitivityTable from '../../../components/ui/SensitivityTable.astro';
import { formatOutput, impliedMovePct, outputMethodLabel, valuationModels } from '../../../data/valuation-models';
import { publicFileSize } from '../../../lib/files';
import { formatDate, formatVndK, signedPct } from '../../../lib/format';

export function getStaticPaths() {
  return valuationModels.map((model, i) => ({
    params: { slug: model.slug },
    props: { model, prev: valuationModels[i - 1] ?? null, next: valuationModels[i + 1] ?? null },
  }));
}

const { model } = Astro.props;
const reference = model.referencePrice;
const modelDate = model.lastUpdated ?? reference.asOf;
const tearHref = `/research/tear-sheets/${model.slug}.pdf`;
const tearSize = publicFileSize(tearHref);
const assumptions = model.keyAssumptions ?? model.report.assumptions;
const upgrades = model.futureUpgrade ?? model.modelImprovementNotes ?? [];
const moves = model.outputs.map((o) => impliedMovePct(o, reference));
const low = Math.min(...moves);
const high = Math.max(...moves);
const relatedModels = valuationModels.filter((m) => m.slug !== model.slug).slice(0, 2);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Report',
  name: `${model.company} (${model.ticker}) valuation report`,
  headline: model.report.headline,
  dateModified: modelDate,
  author: { '@type': 'Person', name: 'Nguyen Vu Truong Huy', url: 'https://truonghuyresearch.xyz' },
  about: { '@type': 'Corporation', name: model.company, tickerSymbol: model.ticker },
};
---

<BaseLayout
  title={`${model.company} (${model.ticker}) valuation report | Truong Huy Research`}
  image={`/og/research/${model.slug}.png`}
  description={`${model.company} (${model.ticker}) valuation: ${model.report.stance}`}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <div class="once-col-m">
    <CoverageStrip current={model.slug} />

    <!-- Once UI Case Study Header (magic-portfolio/src/app/work/[slug]/page.tsx) -->
    <section class="once-hero" data-reveal>
      <a class="once-smart-link" href="/research">
        <span class="label-strong-m on-brand-weak">← Projects</span>
      </a>
      <p class="body-default-xs on-neutral-weak">
        Model of {formatDate(modelDate)} · Price used: VND {formatVndK(reference.value)} ({formatDate(reference.asOf)})
      </p>
      <div class="once-hero-title-wrap">
        <h1 class="display-strong-m">{model.company} ({model.ticker})</h1>
      </div>
      <p class="heading-default-xl on-neutral-weak">{model.report.headline}</p>

      <div class="once-post-author-row">
        <div class="once-post-author">
          <span class="once-avatar once-avatar-s" aria-hidden="true">TH</span>
          <span class="label-default-s on-brand-weak">Nguyen Vu Truong Huy · CFA Level II Passed</span>
        </div>
      </div>

      <div class="once-hero-actions">
        <a class="once-btn once-btn-primary" href={tearHref}>
          <span>Download Tear Sheet (PDF, {tearSize})</span>
        </a>
        <a class="once-btn once-btn-secondary" href={`/research/${model.slug}/tear-sheet`}>
          <span>Printable A4 View</span>
        </a>
        {model.downloads.map((d) => (
          <a class="once-btn once-btn-secondary" href={d.href} download>
            <span>{d.label} ({d.format})</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Primary Valuation Preview Surface -->
    <section class="once-surface-card" id="range" data-reveal>
      <div class="once-Slide-header">
        <span class="once-slide-kicker">{model.ticker} · Valuation Spread vs. VND {formatVndK(reference.value)}</span>
        <span class="once-slide-meta">Implied Move: {signedPct(low, 0)} to {signedPct(high, 0)}</span>
      </div>

      <FootballField models={[model]} />

      <div class="once-kpi-grid">
        <div class="once-kpi-box">
          <span class="once-kpi-label">Price Used</span>
          <span class="once-kpi-value">VND {formatVndK(reference.value)}</span>
          <span class="once-kpi-sub">As of {formatDate(reference.asOf)}</span>
        </div>
        {model.outputs.map((o) => {
          const move = impliedMovePct(o, reference);
          return (
            <div class="once-kpi-box">
              <span class="once-kpi-label">{outputMethodLabel[o.method]}</span>
              <span class="once-kpi-value">{formatOutput(o)}</span>
              <span class="once-kpi-sub">{signedPct(move, 1)} · {o.basis}</span>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Core Analytical Question & Executive View -->
    <section class="once-col-s" id="thesis" data-reveal>
      <div class="once-surface-card">
        <span class="once-slide-kicker">Core Valuation Question</span>
        <h2 class="heading-strong-xl">{model.investmentQuestion ?? model.report.headline}</h2>
        <p class="body-default-m on-neutral-medium">{model.conclusion}</p>
        <div class="once-kpi-grid">
          {model.report.thesis.map((point, idx) => (
            <div class="once-kpi-box">
              <span class="once-kpi-label">Thesis Point 0{idx + 1}</span>
              <span class="body-default-s on-neutral-medium">{point}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Key Numbers & Assumptions -->
    <section class="once-surface-card" id="assumptions" data-reveal>
      <div class="once-Slide-header">
        <h2 class="heading-strong-xl">Key Model Assumptions &amp; Drivers</h2>
        <span class="once-slide-meta">Auditable in Excel ({model.downloads.length} files)</span>
      </div>
      <div class="once-kpi-grid">
        {assumptions.map((kn) => (
          <div class="once-kpi-box">
            <span class="once-kpi-label">{kn.label}</span>
            <span class="once-kpi-value">{kn.value}</span>
            <span class="once-kpi-sub">{kn.detail}</span>
          </div>
        ))}
      </div>
    </section>

    <!-- Interactive 5x5 DCF Sensitivity Matrix (if present) -->
    {model.sensitivity && (
      <section class="container" id="sensitivity" data-reveal>
        <SensitivityTable
          grid={model.sensitivity}
          reference={reference}
        />
      </section>
    )}

    <!-- Risks & Model Upgrades -->
    <section class="once-posts-grid" id="risks" data-reveal>
      <div class="once-surface-card">
        <span class="once-slide-kicker">Downside &amp; Execution Risks</span>
        <h2 class="heading-strong-l">Key Risks to the Thesis</h2>
        <ul class="body-default-s on-neutral-medium">
          {model.report.risks.map((risk) => (
            <li>{risk}</li>
          ))}
        </ul>
      </div>

      <div class="once-surface-card">
        <span class="once-slide-kicker">Model Checkpoints</span>
        <h2 class="heading-strong-l">Next Model Upgrades &amp; Checks</h2>
        <ul class="body-default-s on-neutral-medium">
          {upgrades.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Downloadable Model Files -->
    <section class="once-surface-card" id="files" data-reveal>
      <div class="once-Slide-header">
        <h2 class="heading-strong-xl">Open Excel Workbooks &amp; Tear Sheet</h2>
        <span class="once-slide-meta">{model.downloads.length} Unprotected Excel Files</span>
      </div>
      <div class="once-posts-grid">
        {model.downloads.map((d) => (
          <div class="once-kpi-box">
            <span class="once-kpi-label">{d.modelType ?? d.label} · {d.format}</span>
            <span class="heading-strong-l">{d.sourceTemplate}</span>
            <span class="body-default-xs on-neutral-weak">Sheets: {d.sheets.join(' · ')}</span>
            <div class="once-project-links">
              <a class="once-smart-link" href={d.href} download>
                <span>Download {d.sourceTemplate}</span>
                <span class="once-arrow-icon" aria-hidden="true">↓</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Related Projects (magic-portfolio/src/app/work/[slug]/page.tsx lines 137-143) -->
    <section class="once-blog-section" data-reveal>
      <div class="once-line-h"></div>
      <h2 class="heading-strong-xl">Related projects</h2>
      <div class="once-posts-grid">
        {relatedModels.map((rel) => (
          <a class="once-post-card is-surface" href={`/research/${rel.slug}`}>
            <span class="label-strong-s on-brand-weak">{rel.ticker} · {rel.methods.join(' + ')}</span>
            <h3 class="heading-strong-l">{rel.company}</h3>
            <p class="body-default-s on-neutral-weak">{rel.report.headline}</p>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
