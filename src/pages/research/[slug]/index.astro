---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DatedNote from '../../../components/ui/DatedNote.astro';
import Disclaimer from '../../../components/ui/Disclaimer.astro';
import FootballField from '../../../components/ui/FootballField.astro';
import Icon from '../../../components/ui/Icon.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import Panel from '../../../components/ui/Panel.astro';
import SensitivityTable from '../../../components/ui/SensitivityTable.astro';
import Tick from '../../../components/ui/Tick.astro';
import {
  STALE_AFTER_DAYS,
  formatOutput,
  impliedMovePct,
  methodPages,
  outputMethodLabel,
  valuationGroups,
  valuationModels,
} from '../../../data/valuation-models';
import { publicFileSize } from '../../../lib/files';
import { daysBetween, formatDate, formatVndK, signedPct } from '../../../lib/format';

export function getStaticPaths() {
  return valuationModels.map((model, index) => ({
    params: { slug: model.slug },
    props: {
      model,
      prev: valuationModels[index - 1] ?? null,
      next: valuationModels[index + 1] ?? null,
    },
  }));
}

const { model, prev, next } = Astro.props;

const groups = valuationGroups
  .filter((group) => model.valuationNotes.some((note) => note.groups.includes(group.id)))
  .map((group) => ({ ...group, href: methodPages.find((page) => page.id === group.id)?.href ?? '/research' }));
const assumptionItems = model.keyAssumptions ?? model.report.assumptions;
const upgradeItems = model.futureUpgrade ?? model.modelImprovementNotes;
const reference = model.referencePrice;
const tearSheetHref = `/research/tear-sheets/${model.slug}.pdf`;
// Exported by `npm run tear-sheets`; the link only appears once the PDF exists
const tearSheetSize = publicFileSize(tearSheetHref);
const modelDate = model.lastUpdated ?? reference.asOf;
const ageDays = daysBetween(modelDate, new Date());
const isStale = ageDays > STALE_AFTER_DAYS;

const outputRows = model.outputs.map((output) => ({
  output,
  move: impliedMovePct(output, reference),
}));

const facts = [
  { label: 'Price used', value: `VND ${formatVndK(reference.value)}` },
  { label: 'Price date', value: formatDate(reference.asOf) },
  { label: 'Model date', value: formatDate(modelDate) },
  { label: 'Methods', value: model.methods.join(' · ') },
  { label: 'Files', value: `${model.downloads.length} workbook${model.downloads.length === 1 ? '' : 's'}` },
];

const sections = [
  { id: 'range', label: 'Valuation range' },
  { id: 'thesis', label: 'Executive view' },
  { id: 'assumptions', label: 'Assumptions' },
  ...(model.sensitivity ? [{ id: 'sensitivity', label: 'Sensitivity' }] : []),
  { id: 'conclusion', label: 'Conclusion' },
  { id: 'risks', label: 'Risks' },
  { id: 'files', label: 'Model files' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Report',
  name: `${model.company} (${model.ticker}) valuation report`,
  headline: model.report.headline,
  dateModified: modelDate,
  author: { '@type': 'Person', name: 'Nguyen Vu Truong Huy', url: 'https://truonghuyresearch.xyz' },
  about: { '@type': 'Corporation', name: model.company, tickerSymbol: model.ticker },
};
---

<BaseLayout
  title={`${model.ticker} Valuation Report | Truong Huy Research`}
  image={`/og/research/${model.slug}.png`}
  description={`${model.company} (${model.ticker}) valuation: ${model.report.stance}`}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <div class="mx-auto w-full max-w-container-max space-y-4 px-margin-mobile py-6 md:px-margin-desktop md:py-8">
    <PageHeader
      tone="value"
      kicker={`Valuation report · ${model.sector}`}
      title={model.company}
      lead={model.report.headline}
      back={{ href: '/research', label: 'Coverage' }}
      context={`Model ${formatDate(modelDate)}`}
    >
      <Tick slot="before" label={model.ticker} size="lg" class="mb-4" />
      <div slot="aside" class="space-y-3">
        <div class="border border-line">
          <p class="bg-panel-alt px-4 py-2 font-mono text-label uppercase text-value-ink">Fact file</p>
          <dl class="divide-y divide-line px-4">
            {facts.map((fact) => (
              <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] gap-4 py-2.5">
                <dt class="pt-0.5 font-mono text-label uppercase text-fg-muted">{fact.label}</dt>
                <dd class="text-small font-semibold text-fg">{fact.value}</dd>
              </div>
            ))}
          </dl>
        </div>
        {tearSheetSize && (
          <a href={tearSheetHref} download class="flex min-h-11 w-full items-center justify-between gap-3 bg-value px-4 py-2 font-mono text-[0.8125rem] font-semibold text-white transition-colors hover:bg-[#0A858D] hover:text-white">
            <span class="inline-flex items-center gap-2"><Icon name="download" size={18} /> One-page tear sheet</span>
            <span class="opacity-90">PDF · {tearSheetSize}</span>
          </a>
        )}
      </div>
    </PageHeader>

    {isStale && (
      <DatedNote>
        This model was last updated on {formatDate(modelDate)}, {ageDays} days before this page was built. Prices, estimates
        and peer multiples have not been refreshed since, so the implied moves below compare against the
        {' '}{formatDate(reference.asOf)} price, not today's.
      </DatedNote>
    )}

    <nav aria-label="Report sections" class="flex flex-wrap gap-2">
      {sections.map((section) => (
        <a href={`#${section.id}`} class="border border-line bg-panel px-3 py-1.5 font-mono text-[0.8125rem] font-medium text-fg shadow-panel transition-colors hover:border-value hover:text-link">{section.label}</a>
      ))}
    </nav>

    {model.investmentQuestion && (
      <Panel title="The question" tone="value" reveal>
        <p class="max-w-4xl text-balance font-display text-h2 text-fg">{model.investmentQuestion}</p>
      </Panel>
    )}

    <Panel id="range" title="Valuation range" meta={model.report.stance} tone="value" reveal>
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
        <div class="min-w-0 lg:col-span-7">
          <FootballField outputs={model.outputs} reference={reference} ticker={model.ticker} />
        </div>
        <div class="min-w-0 lg:col-span-5">
          <table class="w-full border-collapse border border-line">
            <caption class="pb-2 text-left font-mono text-label uppercase text-fg">Outputs, VND per share</caption>
            <thead>
              <tr class="bg-panel-alt font-mono text-label uppercase text-fg-muted">
                <th scope="col" class="border-b border-line-strong px-3 py-2 text-left">Method</th>
                <th scope="col" class="border-b border-line-strong px-3 py-2 text-right">Value</th>
                <th scope="col" class="border-b border-line-strong px-3 py-2 text-right">vs price</th>
              </tr>
            </thead>
            <tbody>
              {outputRows.map(({ output, move }) => (
                <tr class="border-b border-line align-top">
                  <th scope="row" class="px-3 py-3 text-left font-normal">
                    <span class="block text-small font-semibold text-fg">{outputMethodLabel[output.method]}</span>
                    <span class="mt-0.5 block text-[0.8125rem] text-fg-muted">{output.basis}</span>
                  </th>
                  <td class="whitespace-nowrap px-3 py-3 text-right font-mono text-[0.9375rem] font-semibold tabular-nums text-fg">{formatOutput(output)}</td>
                  <td class="whitespace-nowrap px-3 py-3 text-right">
                    <span class:list={['inline-block px-1.5 py-0.5 font-mono text-[0.8125rem] font-semibold tabular-nums', move >= 0 ? 'bg-up-soft text-up' : 'bg-down-soft text-down']}>{signedPct(move, 1)}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <dl class="mt-5 space-y-4">
            {model.report.valuationResult.map((point) => (
              <div class="border-l-4 border-value pl-3">
                <dt class="font-mono text-label uppercase text-fg-muted">{point.label} · <span class="text-fg">{point.value}</span></dt>
                <dd class="mt-1 text-small text-fg">{point.detail}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </Panel>

    <Panel id="thesis" title="Executive view" tone="value" reveal>
      <div class="grid grid-cols-1 gap-x-10 gap-y-4 text-body text-fg md:grid-cols-2">
        {model.report.thesis.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </Panel>

    <Panel id="assumptions" title="Key assumptions" tone="value" flush reveal>
      <dl>
        {assumptionItems.map((item) => (
          <div class="grid grid-cols-1 gap-x-6 gap-y-1 border-b border-line px-4 py-3.5 last:border-b-0 md:grid-cols-12 md:px-5">
            <dt class="text-small font-semibold text-fg md:col-span-3">{item.label}</dt>
            <dd class="font-mono text-[0.9375rem] font-semibold tabular-nums text-value-ink md:col-span-3">{item.value}</dd>
            <dd class="text-small text-fg-muted md:col-span-6">{item.detail}</dd>
          </div>
        ))}
      </dl>
      {model.limitation && (
        <div class="border-t border-line bg-panel-alt px-4 py-4 md:px-5">
          <p class="font-mono text-label uppercase text-market-ink">Method limitation</p>
          <p class="mt-1 text-small text-fg">{model.limitation}</p>
        </div>
      )}
    </Panel>

    {model.sensitivity && (
      <Panel id="sensitivity" title="DCF sensitivity" meta="WACC × exit EV/EBITDA" tone="value" reveal>
        <p class="mb-4 font-display text-h3 text-fg">How the DCF value moves with the discount rate and the exit multiple</p>
        <div class="max-w-3xl">
          <SensitivityTable grid={model.sensitivity} reference={reference} />
        </div>
      </Panel>
    )}

    <Panel id="conclusion" title="Conclusion" tone="value" reveal>
      <p class="max-w-4xl text-lead font-semibold text-fg">{model.conclusion}</p>
      <div class="mt-4 max-w-4xl space-y-3 text-body text-fg">
        {model.report.interpretation.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </Panel>

    <Panel id="risks" title="Risks and checks" tone="market" flush reveal>
      <ol class="grid grid-cols-1 md:grid-cols-2">
        {model.report.risks.map((risk, index) => (
          <li class="flex gap-3 border-b border-line px-4 py-3.5 md:odd:border-r">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center bg-market font-mono text-[0.75rem] font-semibold text-white">{index + 1}</span>
            <span class="text-small text-fg">{risk}</span>
          </li>
        ))}
      </ol>
    </Panel>

    <Panel id="files" title="Model files" tone="value" flush reveal>
      <ul>
        {tearSheetSize && (
          <li class="grid grid-cols-1 gap-x-6 gap-y-3 border-b border-line px-4 py-4 md:grid-cols-12 md:items-center md:px-5">
            <div class="md:col-span-4">
              <p class="font-display text-h3 text-fg">One-page tear sheet</p>
              <p class="mt-1 font-mono text-[0.8125rem] text-fg-muted">PDF · {tearSheetSize} · A4</p>
            </div>
            <p class="text-small text-fg md:col-span-5">
              Outputs against the price used, key assumptions, conclusion and risks on one page.
              {' '}<a href={`/research/${model.slug}/tear-sheet`} class="u-link text-link transition-colors hover:text-fg">Printable web version</a>.
            </p>
            <div class="md:col-span-3 md:text-right">
              <a href={tearSheetHref} download class="inline-flex min-h-11 items-center gap-2 bg-value px-4 py-2 font-mono text-[0.8125rem] font-semibold text-white transition-colors hover:bg-[#0A858D] hover:text-white">
                <Icon name="download" size={18} /> Download PDF
              </a>
            </div>
          </li>
        )}
        {model.downloads.map((download) => (
          <li class="grid grid-cols-1 gap-x-6 gap-y-3 border-b border-line px-4 py-4 last:border-b-0 md:grid-cols-12 md:items-center md:px-5">
            <div class="md:col-span-4">
              <p class="font-display text-h3 text-fg">{download.modelType ?? download.label}</p>
              <p class="mt-1 font-mono text-[0.8125rem] text-fg-muted">{[download.format, publicFileSize(download.href), formatDate(download.lastUpdated ?? modelDate)].filter(Boolean).join(' · ')}</p>
            </div>
            <p class="text-small text-fg md:col-span-5">{download.description ?? `Sheets: ${download.sheets.join(', ')}.`}</p>
            <div class="md:col-span-3 md:text-right">
              <a href={download.href} download class="inline-flex min-h-11 items-center gap-2 border border-line-strong px-4 py-2 font-mono text-[0.8125rem] font-semibold text-fg transition-colors hover:border-fg hover:bg-panel-alt">
                <Icon name="download" size={18} /> Download {download.format}
              </a>
            </div>
          </li>
        ))}
      </ul>
    </Panel>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      <Panel title="Method pages" tone="neutral" level={3} flush>
        <ul>
          {groups.map((group) => (
            <li class="border-b border-line last:border-b-0">
              <a href={group.href} class="group flex items-baseline justify-between gap-4 px-4 py-3 transition-colors hover:bg-panel-alt">
                <span class="text-small font-semibold text-fg transition-colors group-hover:text-link">{group.title}</span>
                <span class="font-mono text-[0.75rem] text-fg-muted">{group.eyebrow}</span>
              </a>
            </li>
          ))}
        </ul>
      </Panel>
      {upgradeItems && (
        <Panel title="Next model upgrades" tone="neutral" level={3} flush>
          <ul>
            {upgradeItems.map((item) => <li class="border-b border-line px-4 py-2.5 text-small text-fg last:border-b-0">{item}</li>)}
          </ul>
        </Panel>
      )}
    </div>

    <nav aria-label="Other reports" class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {prev ? (
        <a href={`/research/${prev.slug}`} class="group flex items-center gap-3 border border-line bg-panel p-4 shadow-panel transition-colors hover:border-value">
          <Tick label={prev.ticker} />
          <span>
            <span class="block font-mono text-label uppercase text-value-ink">← Previous report</span>
            <span class="block font-display text-h3 text-fg transition-colors group-hover:text-link">{prev.company}</span>
          </span>
        </a>
      ) : <span class="hidden sm:block"></span>}
      {next ? (
        <a href={`/research/${next.slug}`} class="group flex items-center justify-end gap-3 border border-line bg-panel p-4 text-right shadow-panel transition-colors hover:border-value">
          <span>
            <span class="block font-mono text-label uppercase text-value-ink">Next report →</span>
            <span class="block font-display text-h3 text-fg transition-colors group-hover:text-link">{next.company}</span>
          </span>
          <Tick label={next.ticker} />
        </a>
      ) : <span class="hidden sm:block"></span>}
    </nav>

    <Disclaimer label={model.disclaimerLabel} text={model.report.disclaimer} />
  </div>
</BaseLayout>
