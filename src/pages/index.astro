---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverageTable from '../components/ui/CoverageTable.astro';
import FootballField from '../components/ui/FootballField.astro';
import ForeignFlowMonitor from '../components/ui/ForeignFlowMonitor.astro';
import Icon from '../components/ui/Icon.astro';
import Ticker from '../components/ui/Ticker.astro';
import VnIndexChart from '../components/ui/VnIndexChart.astro';
import flowCache from '../content/market-views/_foreign_flow_cache.json';
import { methodPages, STALE_AFTER_DAYS, valuationGroups, valuationModels } from '../data/valuation-models';
import { publicFileSize } from '../lib/files';
import { formatDate, formatIndex, signedPct } from '../lib/format';
import { monthlySummary, weeklySummary } from '../lib/notes';

const weekly = (await getCollection('market-views')).map(weeklySummary).sort((a, b) => b.date.valueOf() - a.date.valueOf());
const monthly = (await getCollection('monthly-views')).map(monthlySummary).sort((a, b) => b.date.valueOf() - a.date.valueOf());
const notes = [...weekly, ...monthly].sort((a, b) => b.date.valueOf() - a.date.valueOf());
const latestWeekly = weekly[0];
const trend = [...weekly].reverse().map((n) => ({ time: n.date.toISOString().slice(0, 10), value: n.close }));
const files = valuationModels.flatMap((m) => m.downloads.map((d) => ({ m, d, size: publicFileSize(d.href) })));
const priceDate = formatDate(valuationModels[0].referencePrice.asOf);
const flowSessions = Object.keys(flowCache).length;

const methods = methodPages.map((p) => ({
  ...p,
  group: valuationGroups.find((g) => g.id === p.id)!,
  tickers: valuationModels.filter((m) => m.valuationNotes.some((n) => n.groups.includes(p.id))).map((m) => m.ticker),
}));
---

<BaseLayout
  title="Truong Huy Research — Vietnam equity research desk"
  description="Valuation ranges, open Excel workbooks and weekly VN-Index notes on Vietnam-listed companies by Nguyen Vu Truong Huy, who has passed Level II of the CFA Program."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Nguyen Vu Truong Huy',
    alternateName: 'Nguyễn Vũ Trường Huy',
    url: 'https://truonghuyresearch.xyz',
    email: 'mailto:hnguyenvutruong@gmail.com',
    sameAs: ['https://www.linkedin.com/in/trghuyy/'],
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Economics Ho Chi Minh City (UEH)' },
    knowsAbout: ['Equity Research', 'DCF Valuation', 'Comparable Company Analysis', 'LBO Modeling', 'Vietnam Equities'],
  })} />

  <header class="doc-head">
    <div class="container doc-head__grid doc-head__grid--aside">
      <div>
        <p class="eyebrow">Equity research desk · Vietnam · HOSE</p>
        <h1 class="display">Vietnam equities, valued as ranges across methods</h1>
        <p class="lead">
          Five HOSE-listed companies valued with DCF, trading comparables, precedent transactions and LBO, each shipped with
          its Excel workbook, plus weekly and monthly notes on the VN-Index, liquidity and foreign flow.
        </p>
        <div class="lockup">
          <strong>Nguyen Vu Truong Huy</strong><i></i>UEH Finance &amp; Banking<i></i>Passed Level II of the CFA Program<i></i>Ho Chi Minh City
        </div>
        <div class="btn-row">
          <a class="btn btn--primary" href="/research">Open coverage</a>
          <a class="btn btn--ghost" href={notes[0]?.href ?? '/market-views'}>Latest note · {notes[0]?.period}</a>
          <a class="btn btn--ghost" href="/cv.pdf" target="_blank" rel="noopener"><Icon name="download" size={12} /> CV</a>
        </div>
      </div>
      <dl class="facts facts--focus">
        <div><dt>Prices used as of</dt><dd>{priceDate}</dd></div>
        <div><dt>Companies</dt><dd>{valuationModels.length}</dd></div>
        <div><dt>Excel workbooks</dt><dd>{files.length}</dd></div>
        <div><dt>Market notes</dt><dd>{weekly.length} W · {monthly.length} M</dd></div>
        <div><dt>Foreign-flow record</dt><dd>{flowSessions} sessions</dd></div>
        <div><dt>Latest note</dt><dd>{notes[0] ? formatDate(notes[0].date) : '—'}</dd></div>
      </dl>
    </div>
  </header>

  <div class="container ws">
    <section class="panel col-24" aria-labelledby="mon-title">
      <div class="panel__head">
        <h2 class="panel__title" id="mon-title"><Icon name="table" size={13} /> Coverage monitor</h2>
        <span class="panel__meta">VND/share · implied move vs. price used</span>
        <span class="panel__actions"><a class="btn btn--ghost btn--sm" href="/research">Full coverage <Icon name="arrow_right" size={12} /></a></span>
      </div>
      <CoverageTable />
      <div class="panel__foot">
        <span>{valuationModels.length} companies · sort any column</span>
        <span>Prices used {priceDate}; not live quotes</span>
      </div>
    </section>

    <section class="panel col-8" aria-labelledby="rng-title">
      <div class="panel__head">
        <h2 class="panel__title" id="rng-title"><Icon name="chart" size={13} /> Valuation ranges</h2>
        <span class="panel__meta">% vs. price used</span>
      </div>
      <div class="panel__body"><FootballField models={valuationModels} /></div>
    </section>

    <section class="panel col-8" aria-labelledby="vni-title">
      <div class="panel__head">
        <h2 class="panel__title" id="vni-title"><Icon name="flow" size={13} /> VN-Index · weekly close</h2>
        {latestWeekly && (
          <span class="panel__actions">
            <span class:list={['tag', latestWeekly.change >= 0 ? 'tag--up' : 'tag--down']}>{formatIndex(latestWeekly.close)} {signedPct(latestWeekly.change)}</span>
          </span>
        )}
      </div>
      <div class="panel__body">
        <VnIndexChart trendData={trend} label={`VN-Index weekly close across ${trend.length} weekly notes`} height="md" />
      </div>
    </section>

    <div class="col-8">
      <ForeignFlowMonitor compact />
    </div>

    <section class="panel col-10" aria-labelledby="notes-title">
      <div class="panel__head">
        <h2 class="panel__title" id="notes-title"><Icon name="book" size={13} /> Latest market notes</h2>
        <span class="panel__actions"><a class="btn btn--ghost btn--sm" href="/market-views#archive">Archive · {notes.length}</a></span>
      </div>
      <ol class="notelist notelist--compact">
        {notes.slice(0, 6).map((n) => (
          <li>
            <a href={n.href}>
              <span class="notelist__when"><span class="tag tag--blue">{n.kind}</span>{n.period}</span>
              <span class="notelist__title">{n.headline}</span>
              <span class="notelist__fig">{formatIndex(n.close)} <span class:list={['tag', n.change >= 0 ? 'tag--up' : 'tag--down']}>{signedPct(n.change)}</span></span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="panel col-7" aria-labelledby="meth-title">
      <div class="panel__head">
        <h2 class="panel__title" id="meth-title"><Icon name="layers" size={13} /> Methods</h2>
      </div>
      <dl class="defs">
        {methods.map((p) => (
          <div>
            <dt><a class="link" href={p.href}>{p.group.title}</a> <span class="dim">· {p.group.eyebrow}</span></dt>
            <dd>{p.group.description}</dd>
            <dd class="row">{p.tickers.map((t) => <Ticker label={t} />)}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="panel col-7" aria-labelledby="files-title">
      <div class="panel__head">
        <h2 class="panel__title" id="files-title"><Icon name="file" size={13} /> Model files</h2>
        <span class="panel__actions"><a class="btn btn--ghost btn--sm" href="/research#files">All {files.length}</a></span>
      </div>
      <div class="files">
        {files.slice(0, 5).map(({ m, d, size }) => (
          <div class="file">
            <span class:list={['file-ico', d.format === 'ZIP' && 'file-ico--zip']}>{d.format}</span>
            <div>
              <p class="file__name">{m.ticker} · {d.modelType ?? d.label}</p>
              <p class="file__meta">{d.sheets.slice(0, 4).join(', ')}{size ? ` · ${size}` : ''}</p>
            </div>
            <a class="btn btn--ghost btn--sm" href={d.href} download aria-label={`Download ${m.ticker} ${d.label} (${d.format})`}><Icon name="download" size={12} /></a>
          </div>
        ))}
      </div>
    </section>

    <section class="panel col-24" aria-labelledby="read-title">
      <div class="panel__head">
        <h2 class="panel__title" id="read-title"><Icon name="check" size={13} /> How to read the numbers</h2>
      </div>
      <dl class="defs grid-defs">
        <div>
          <dt>Price used</dt>
          <dd>The share price each model pack used as its market input ({priceDate}). It is not a live quote; every implied move is measured against it, and figures are flagged once a model is more than {STALE_AFTER_DAYS} days old.</dd>
        </div>
        <div>
          <dt>Range, not a target</dt>
          <dd>Each method's output is a VND range. DCF bars span the corners of the WACC × exit EV/EBITDA grid; the amber diamond marks the base case. Where methods disagree, the spread is the finding.</dd>
        </div>
        <div>
          <dt>Measured market data</dt>
          <dd>VN-Index prices come from VNDirect (Yahoo Finance as fallback) and no note is published without them. Unavailable figures show as “—”. Cross-asset values in notes up to 5 Jun 2026 may not be measured closes.</dd>
        </div>
        <div>
          <dt>Not investment advice</dt>
          <dd>Academic portfolio work. Verify every assumption in the workbooks before relying on it. <a class="link" href="/disclaimer">Disclaimer</a></dd>
        </div>
      </dl>
    </section>
  </div>
</BaseLayout>
