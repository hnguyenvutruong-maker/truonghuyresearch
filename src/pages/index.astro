---
/*
  Taste plan (references/sections.md), the home page as screens:
  1 kind: service (an analyst's equity research; site-kind other)
  2 deal: hero split (the only service hero for UI material), nav-split, footer-columns, close-word,
    rhythm surface-pairs (#notes on the surface ground), buttons tonal, mark stack, radius sharp.
    Palette Frost and slate with institutional navy: fintech and law trades, the owner's chosen colours.
    Type source-serif (Source Serif 4 at 400, Libre Franklin). Moment: word-highlight (no photographs).
  hero      the h1, a lead, the CV and the research, three facts; picture: every model's range (the work)
  #research peek-list: five reports; the frame shows the row's football field (1 screen)
  #approach word-highlight statement: how a company is valued (1 screen)
  #notes    ground-surface: the VN-Index chart and the latest notes (1 screen)
  #about    the record beside a real tear-sheet page (1 screen)
  closing   close-word: Download the CV, then the name across the wrap; footer-columns
*/
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverageStrip from '../components/ui/CoverageStrip.astro';
import FootballField from '../components/ui/FootballField.astro';
import VnIndexChart from '../components/ui/VnIndexChart.astro';
import { getCollection } from 'astro:content';
import { impliedMovePct, valuationModels } from '../data/valuation-models';
import { formatDate, signedPct } from '../lib/format';
import { monthlySummary, weeklySummary } from '../lib/notes';

const weekly = (await getCollection('market-views')).map(weeklySummary).sort((a, b) => b.date.valueOf() - a.date.valueOf());
const monthly = (await getCollection('monthly-views')).map(monthlySummary).sort((a, b) => b.date.valueOf() - a.date.valueOf());
const trend = [...weekly].reverse().map((n) => ({ time: n.date.toISOString().slice(0, 10), value: n.close }));
const latest = [...(monthly[0] ? [monthly[0]] : []), ...weekly.slice(0, 3)];
const workbooks = valuationModels.reduce((t, m) => t + m.downloads.length, 0);
const priceDate = formatDate(valuationModels[0].referencePrice.asOf);
const reports = valuationModels.map((m) => {
  const moves = m.outputs.map((o) => impliedMovePct(o, m.referencePrice));
  return { m, low: Math.min(...moves), high: Math.max(...moves) };
});
---

<BaseLayout
  title="Truong Huy Research: equity research on Vietnam-listed companies"
  description="Valuation models, open Excel workbooks and weekly VN-Index notes on Vietnam-listed companies by Nguyen Vu Truong Huy, who has passed Level II of the CFA Program."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org', '@type': 'Person', name: 'Nguyen Vu Truong Huy', alternateName: 'Nguyễn Vũ Trường Huy',
    url: 'https://truonghuyresearch.xyz', jobTitle: 'Finance & Banking Student',
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Economics Ho Chi Minh City', alternateName: 'UEH' },
    hasCredential: { '@type': 'EducationalOccupationalCredential', name: 'CFA Program Level II (passed)', recognizedBy: { '@type': 'Organization', name: 'CFA Institute' } },
    knowsAbout: ['Equity Research', 'Valuation Modeling', 'Vietnam Capital Markets', 'DCF Analysis'],
    sameAs: ['https://www.linkedin.com/in/trghuyy/'],
  })} />

  <section class="hero hero--split" data-enter aria-labelledby="hero-h">
    <div class="wrap">
      <div class="hero-text grid hero-split">
        <div class="hero-copy span-6">
          <p class="hero-notice">Passed Level II of the CFA Program</p>
          <h1 id="hero-h">Equity research on Vietnam-listed companies</h1>
          <p class="t-lead">Valuation models with the Excel workbooks open, and a weekly read on the VN-Index. Each company is shown as a range against the price its model used.</p>
          <div class="btn-row">
            <a class="btn btn--primary" href="/cv.pdf" target="_blank" rel="noopener">Download the CV<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"/><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"/></svg></a>
            <a class="btn btn--secondary" href="#research">See the five reports</a>
          </div>
          <dl class="hero-facts">
            <div><dt>Companies covered</dt><dd>{valuationModels.length}</dd></div>
            <div><dt>Excel workbooks</dt><dd>{workbooks}</dd></div>
            <div><dt>Prices as of</dt><dd>{priceDate}</dd></div>
          </dl>
        </div>
        <div class="hero-visual span-6 start-7"><CoverageStrip /></div>
      </div>
    </div>
  </section>

  <section class="section" id="research" aria-labelledby="research-h">
    <div class="wrap">
      <div class="section-head--split">
        <div><h2 id="research-h">Five company reports</h2><p class="t-lead muted">Point at a company to see its methods against the price used.</p></div>
        <a class="link" href="/research">See the full coverage</a>
      </div>
      <div class="grid grid--top fill" data-peek>
        <ul class="rows span-5">
          {reports.map(({ m, low, high }) => (
            <li data-peek-to={m.slug} tabindex="0">
              <span class="rows__name"><a href={`/research/${m.slug}`}>{m.company}</a></span>
              <span class="rows__value num"><span class:list={[low >= 0 ? 'up' : 'down']}>{signedPct(low, 0)}</span> <span class="muted">to</span> <span class:list={[high >= 0 ? 'up' : 'down']}>{signedPct(high, 0)}</span></span>
              <p class="t-small muted">{m.ticker} · {m.sector} · {m.methods.join(', ')}</p>
            </li>
          ))}
        </ul>
        <div class="peek-frame span-6 start-7">
          {reports.map(({ m }, i) => (
            <div data-peek-for={m.slug} hidden={i > 0}>
              <FootballField outputs={m.outputs} reference={m.referencePrice} ticker={m.ticker} />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section statement" id="approach" data-moment="word-highlight" aria-label="How a company is valued">
    <div class="wrap">
      <p class="t-label muted">How a company is valued</p>
      <p class="mo-wh__text">Each company gets the methods that fit its business: a DCF, peer multiples, a bank's price to book, a deal or a buyout. The results stay apart, set against the price the model used. Where the methods disagree, <strong>the spread is the finding</strong>, and every workbook is open so the reader can check it.</p>
    </div>
  </section>

  <section class="section ground-surface" id="notes" aria-labelledby="notes-h">
    <div class="wrap">
      <div class="section-head--split">
        <div><h2 id="notes-h">Market notes on the VN-Index</h2><p class="t-lead muted">Index levels, liquidity, foreign flow and sectors, every week and every month.</p></div>
        <a class="link" href="/market-views">Read every note</a>
      </div>
      <div class="grid grid--top">
        <div class="sheet span-7">
          <p class="t-label">VN-Index weekly close, {formatDate(trend[0].time)} to {formatDate(trend[trend.length - 1].time)}</p>
          <VnIndexChart trendData={trend} label="VN-Index weekly closes taken from the weekly market notes" height="md" />
        </div>
        <ul class="rows span-4 start-9">
          {latest.map((n) => (
            <li>
              <span class="rows__name"><a href={n.href}>{n.headline}</a></span>
              <span class:list={['rows__value num', n.change >= 0 ? 'up' : 'down']}>{signedPct(n.change)}</span>
              <p class="t-small muted">{n.kind} · {n.period}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="about" aria-labelledby="about-h">
    <div class="wrap grid grid--top">
      <div class="span-5 stack-5">
        <h2 id="about-h">About Huy</h2>
        <p class="t-lead">Finance and Banking student at the University of Economics Ho Chi Minh City (UEH), GPA 3.64 out of 4.00, who has passed Level II of the CFA Program.</p>
        <p class="muted">At Hoan Loc Viet I worked with financial data, reporting and analysis workflows. The reports here are built in Excel, Power BI and Stata, and every model ends in a one-page tear sheet.</p>
        <a class="link" href="/contact">Contact Huy</a>
      </div>
      <figure class="paper span-6 start-7">
        <a href="/research/hpg/tear-sheet"><img src="/research/tear-sheets/hpg-page.png" width="794" height="1123" alt="The one-page tear sheet for Hoa Phat Group: football field, outputs, assumptions, conclusion and risks" loading="lazy" /></a>
      </figure>
    </div>
  </section>
</BaseLayout>
