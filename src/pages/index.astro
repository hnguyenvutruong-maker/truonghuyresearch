---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverageTable from '../components/ui/CoverageTable.astro';
import Disclaimer from '../components/ui/Disclaimer.astro';
import FootballField from '../components/ui/FootballField.astro';
import Icon from '../components/ui/Icon.astro';
import Panel from '../components/ui/Panel.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import Tick from '../components/ui/Tick.astro';
import VnIndexChart from '../components/ui/VnIndexChart.astro';
import { getCollection } from 'astro:content';
import { valuationModels } from '../data/valuation-models';
import { formatDate, formatIndex, formatNumber, signedNumber, signedPct, toneClass } from '../lib/format';
import { monthlySummary, weeklySummary } from '../lib/notes';

const weekly = (await getCollection('market-views')).map(weeklySummary).sort((a, b) => b.date.valueOf() - a.date.valueOf());
const monthly = (await getCollection('monthly-views')).map(monthlySummary).sort((a, b) => b.date.valueOf() - a.date.valueOf());
const latestWeekly = weekly[0];
const latestMonthly = monthly[0];
const noteCount = weekly.length + monthly.length;
const downloadCount = valuationModels.reduce((total, model) => total + model.downloads.length, 0);
const trendData = [...weekly].reverse().map((note) => ({ time: note.date.toISOString().slice(0, 10), value: note.close }));
const briefs = [...(latestMonthly ? [latestMonthly] : []), ...weekly.slice(0, 2)];

const lead = valuationModels.find((model) => model.investmentQuestion) ?? valuationModels[0];
const priceDate = formatDate(valuationModels[0].referencePrice.asOf);

const chips = ['UEH · GPA 3.64', `${valuationModels.length} issuers`, `${downloadCount} workbooks`, `${noteCount} notes`];

const capabilities = [
  { title: 'Financial modeling', detail: 'FCFF DCF, LBO, and precedent-transaction workbooks built from scratch and shared for review.' },
  { title: 'Equity valuation', detail: 'Peer multiples, bank P/B checks, and method cross-checks that explain why outputs differ.' },
  { title: 'Market research', detail: 'Weekly and monthly VN-Index notes covering liquidity, foreign flow, sectors, and macro.' },
];

const credentials = [
  { label: 'Education', value: 'University of Economics Ho Chi Minh City (UEH), Finance and Banking · GPA 3.64/4.00' },
  { label: 'CFA Program', value: 'Passed Level II' },
  { label: 'Experience', value: 'Hoan Loc Viet: financial data, reporting, and analysis workflows' },
  { label: 'Toolkit', value: 'Excel · Power BI · Stata' },
];

const marketRows = latestWeekly
  ? [
      { label: 'VN-Index close', value: formatIndex(latestWeekly.close), change: null },
      { label: 'Weekly change', value: signedPct(latestWeekly.change), change: latestWeekly.change },
      { label: 'Foreign net, bn VND', value: latestWeekly.foreignNet != null ? signedNumber(latestWeekly.foreignNet) : '—', change: latestWeekly.foreignNet },
      { label: 'Avg liquidity, bn VND', value: formatNumber(latestWeekly.liquidity, 0), change: null },
    ]
  : [];
---

<BaseLayout
  title="Nguyen Vu Truong Huy | Vietnam Equity Research Portfolio"
  description="Vietnam equity research, valuation modeling, capital markets notes, and downloadable Excel models by Nguyen Vu Truong Huy, who has passed Level II of the CFA Program."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Nguyen Vu Truong Huy",
    "alternateName": "Nguyễn Vũ Trường Huy",
    "url": "https://truonghuyresearch.xyz",
    "image": "https://truonghuyresearch.xyz/og-image.png",
    "jobTitle": "Finance & Banking Student",
    "alumniOf": {
      "@type": "CollegeOrUniversity",
      "name": "University of Economics Ho Chi Minh City",
      "alternateName": "UEH"
    },
    "hasCredential": {
      "@type": "EducationalOccupationalCredential",
      "name": "CFA Program Level II (passed)",
      "recognizedBy": { "@type": "Organization", "name": "CFA Institute" }
    },
    "knowsAbout": ["Equity Research", "Valuation Modeling", "Vietnam Capital Markets", "DCF Analysis", "Financial Modeling"],
    "sameAs": ["https://www.linkedin.com/in/trghuyy/"]
  })} />

  <div class="mx-auto w-full max-w-container-max space-y-10 px-margin-mobile py-6 md:px-margin-desktop md:py-8">
    <!-- Front: analyst + markets -->
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-12">
      <Panel title="Analyst" meta="Ho Chi Minh City" tone="profile" class="animate-rise lg:col-span-7">
        <p class="font-mono text-label uppercase text-profile-ink">Passed Level II, CFA Program</p>
        <h1 class="mt-2 text-balance font-display text-display text-fg">Nguyễn Vũ Trường Huy</h1>
        <p class="mt-4 max-w-2xl text-lead text-fg">
          Finance and Banking student at UEH who has passed Level II of the CFA Program. I build valuation models and write
          market notes on Vietnam-listed companies, showing the assumptions, not just the answer.
        </p>
        <p class="mt-4 max-w-2xl border-l-4 border-profile bg-panel-alt px-3 py-2 text-small font-semibold text-fg">
          Open to Equity Research, Capital Markets, and Investment Banking internships.
        </p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {chips.map((chip) => <li class="border border-line bg-panel-alt px-2 py-1 font-mono text-[0.8125rem] text-fg">{chip}</li>)}
        </ul>
        <div class="mt-5 flex flex-wrap items-center gap-2">
          <a href="#valuation" class="inline-flex min-h-11 items-center gap-2 bg-value px-4 py-2 font-mono text-[0.8125rem] font-semibold text-white transition-colors hover:bg-[#0A858D] hover:text-white">
            Read the coverage <Icon name="arrow_downward" size={16} />
          </a>
          <a href="/cv.pdf" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2 border border-line-strong px-4 py-2 font-mono text-[0.8125rem] font-semibold text-fg transition-colors hover:border-fg hover:bg-panel-alt">
            Download CV <Icon name="download" size={16} />
          </a>
          <a href="https://www.linkedin.com/in/trghuyy/" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-1 px-2 font-mono text-[0.8125rem] font-semibold text-link transition-colors hover:text-fg">
            LinkedIn <Icon name="north_east" size={16} />
          </a>
        </div>
      </Panel>

      {latestWeekly && (
        <Panel title="Markets" meta={latestWeekly.period} tone="market" class="animate-rise [animation-delay:80ms] lg:col-span-5">
          <dl class="divide-y divide-line">
            {marketRows.map((row) => (
              <div class="flex items-baseline justify-between gap-4 py-2.5">
                <dt class="text-small text-fg-muted">{row.label}</dt>
                <dd class:list={['font-mono text-data font-semibold tabular-nums', row.change == null ? 'text-fg' : toneClass(row.change)]}>{row.value}</dd>
              </div>
            ))}
          </dl>
          {latestMonthly && (
            <p class="mt-3 border-t border-line pt-3 text-small text-fg-muted">
              {latestMonthly.period}: <span class="font-mono font-semibold text-fg">{formatIndex(latestMonthly.close)}</span>
              {' '}<span class:list={['font-mono font-semibold', toneClass(latestMonthly.change)]}>{signedPct(latestMonthly.change)}</span> on the month
            </p>
          )}
          <a href={latestWeekly.href} class="mt-4 inline-flex items-center gap-1 font-mono text-[0.8125rem] font-semibold text-link transition-colors hover:text-fg">
            Read the weekly note <Icon name="arrow_forward" size={16} />
          </a>
        </Panel>
      )}
    </div>

    <!-- Section I · Profile -->
    <section class="space-y-4">
      <SectionTitle id="about" kicker="Section I · Profile" title="Background" tone="profile" />
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-12">
        <Panel title="About" tone="profile" class="lg:col-span-7" reveal>
          <div class="space-y-4 text-body text-fg">
            <p>
              I study Finance and Banking at the University of Economics Ho Chi Minh City (UEH), have passed Level II of the
              CFA Program, and hold a GPA of 3.64/4.00.
            </p>
            <p>
              My work focuses on Vietnam equity research, valuation modeling, and capital markets analysis. I use Excel,
              Power BI, and Stata to organize data, test assumptions, and present valuation ranges clearly.
            </p>
            <p>
              At Hoan Loc Viet, I worked with financial data, reporting, and analysis workflows. This portfolio collects the
              research notes and model files I am using to build a clearer analyst track record.
            </p>
          </div>
        </Panel>
        <Panel title="Fact file" tone="profile" class="lg:col-span-5" reveal flush>
          <dl class="divide-y divide-line">
            {credentials.map((row) => (
              <div class="grid grid-cols-[7.5rem_minmax(0,1fr)] gap-4 px-4 py-3">
                <dt class="pt-0.5 font-mono text-label uppercase text-fg-muted">{row.label}</dt>
                <dd class="text-small text-fg">{row.value}</dd>
              </div>
            ))}
          </dl>
        </Panel>
      </div>
      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        {capabilities.map((item) => (
          <Panel title={item.title} tone="neutral" level={3} reveal>
            <p class="text-small text-fg">{item.detail}</p>
          </Panel>
        ))}
      </div>
    </section>

    <!-- Section II · Coverage -->
    <section class="space-y-4">
      <SectionTitle id="valuation" kicker="Section II · Valuation" title="Coverage" tone="value">
        <a slot="aside" href="/research" class="inline-flex items-center gap-1 font-mono text-[0.8125rem] font-semibold text-link transition-colors hover:text-fg">
          All valuation work <Icon name="arrow_forward" size={16} />
        </a>
      </SectionTitle>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-12">
        <Panel title={`Lead note · ${lead.ticker}`} meta={lead.sector} tone="value" class="lg:col-span-5" reveal>
          <div class="flex items-start gap-3">
            <Tick label={lead.ticker} size="lg" />
            <p class="font-display text-h3 text-fg">{lead.company}</p>
          </div>
          <p class="mt-4 text-lead font-semibold text-fg">{lead.investmentQuestion ?? lead.report.headline}</p>
          <p class="mt-3 text-small text-fg-muted">{lead.report.headline}</p>
          <a href={`/research/${lead.slug}`} class="mt-4 inline-flex items-center gap-1 font-mono text-[0.8125rem] font-semibold text-link transition-colors hover:text-fg">
            Read the {lead.ticker} report <Icon name="arrow_forward" size={16} />
          </a>
        </Panel>
        <Panel title={`${lead.ticker} · valuation range`} meta={`Price used ${priceDate}`} tone="value" class="lg:col-span-7" reveal>
          <FootballField outputs={lead.outputs} reference={lead.referencePrice} ticker={lead.ticker} compact />
        </Panel>
      </div>
      <Panel title="Coverage table · VND per share" meta={`Prices as of ${priceDate}`} tone="value" flush reveal>
        <CoverageTable />
        <p class="border-t border-line px-4 py-3 text-[0.875rem] text-fg-muted">
          Implied moves compare each method's base case or midpoint with the price the model used. ≈ marks approximate
          precedent-transaction outputs. Academic work, not investment advice.
        </p>
      </Panel>
    </section>

    <!-- Section III · Market notes -->
    <section class="space-y-4">
      <SectionTitle id="market-views" kicker="Section III · Market views" title="Market notes" tone="market">
        <a slot="aside" href="/market-views" class="inline-flex items-center gap-1 font-mono text-[0.8125rem] font-semibold text-link transition-colors hover:text-fg">
          All notes <Icon name="arrow_forward" size={16} />
        </a>
      </SectionTitle>
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-12">
        {trendData.length > 0 && (
          <Panel title="VN-Index · weekly close" meta={`${trendData[0].time} → ${trendData[trendData.length - 1].time}`} tone="market" class="lg:col-span-7" reveal>
            <VnIndexChart trendData={trendData} label="VN-Index weekly closes taken from the weekly market notes" />
          </Panel>
        )}
        <Panel title="Latest notes" tone="market" class="lg:col-span-5" flush reveal>
          <ul>
            {briefs.map((brief) => (
              <li class="border-b border-line">
                <a href={brief.href} class="group block px-4 py-3.5 transition-colors hover:bg-panel-alt">
                  <p class="font-mono text-label uppercase">
                    <span class:list={['mr-2 inline-block px-1.5 py-0.5 text-white', brief.kind === 'Monthly' ? 'bg-market' : 'bg-chrome']}>{brief.kind}</span>
                    <span class="text-fg-muted">{brief.period}</span>
                  </p>
                  <p class="mt-1.5 font-display text-h3 text-fg transition-colors group-hover:text-link">{brief.headline}</p>
                  <p class="mt-1 font-mono text-[0.8125rem] tabular-nums text-fg-muted">
                    VN-Index <span class="font-semibold text-fg">{formatIndex(brief.close)}</span>
                    {' '}<span class:list={['font-semibold', toneClass(brief.change)]}>{signedPct(brief.change)}</span>
                  </p>
                </a>
              </li>
            ))}
          </ul>
          <div class="flex flex-wrap gap-2 p-4">
            <a href="/market-views?kind=weekly" class="inline-flex min-h-10 items-center gap-2 border border-line-strong px-3 py-2 font-mono text-[0.8125rem] font-semibold text-fg transition-colors hover:border-fg hover:bg-panel-alt">
              <Icon name="view_week" size={16} /> Weekly notes
            </a>
            <a href="/monthly-views" class="inline-flex min-h-10 items-center gap-2 bg-market px-3 py-2 font-mono text-[0.8125rem] font-semibold text-white transition-colors hover:bg-[#B05A05] hover:text-white">
              <Icon name="calendar_month" size={16} /> Monthly notes
            </a>
          </div>
        </Panel>
      </div>
    </section>

    <Disclaimer />
  </div>
</BaseLayout>
