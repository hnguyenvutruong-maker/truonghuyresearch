---
// Home Page — Fey × Mercury Financial Research Portal
// Smooth cross-blur panel morphing (.panel-stack) + unslop-ui clean hierarchy
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverageStrip from '../components/ui/CoverageStrip.astro';
import FootballField from '../components/ui/FootballField.astro';
import ForeignFlowMonitor from '../components/ui/ForeignFlowMonitor.astro';
import Ticker from '../components/ui/Ticker.astro';
import VnIndexChart from '../components/ui/VnIndexChart.astro';
import { getCollection } from 'astro:content';
import { impliedMovePct, methodPages, valuationGroups, valuationModels } from '../data/valuation-models';
import { publicFileSize } from '../lib/files';
import { formatDate, formatIndex, formatVndK, signedPct } from '../lib/format';
import { monthlySummary, weeklySummary } from '../lib/notes';

const weekly = (await getCollection('market-views')).map(weeklySummary).sort((a, b) => b.date.valueOf() - a.date.valueOf());
const monthly = (await getCollection('monthly-views')).map(monthlySummary).sort((a, b) => b.date.valueOf() - a.date.valueOf());
const trend = [...weekly].reverse().map((n) => ({ time: n.date.toISOString().slice(0, 10), value: n.close }));
const latestNotes = [...(monthly[0] ? [monthly[0]] : []), ...weekly.slice(0, 4)];
const workbooks = valuationModels.reduce((t, m) => t + m.downloads.length, 0);
const priceDate = formatDate(valuationModels[0].referencePrice.asOf);

const reports = valuationModels.map((m) => {
  const moves = m.outputs.map((o) => impliedMovePct(o, m.referencePrice));
  const assumptions = (m.keyAssumptions ?? m.report.assumptions).slice(0, 4);
  const tearHref = `/research/tear-sheets/${m.slug}.pdf`;
  const tearSize = publicFileSize(tearHref);
  return {
    m,
    low: Math.min(...moves),
    high: Math.max(...moves),
    assumptions,
    tearHref,
    tearSize,
  };
});

const methodCards = methodPages.map((p) => {
  const group = valuationGroups.find((g) => g.id === p.id)!;
  const tickers = valuationModels
    .filter((m) => m.valuationNotes.some((n) => n.groups.includes(p.id)))
    .map((m) => m.ticker);
  return { ...p, group, tickers };
});
---

<BaseLayout
  title="Truong Huy Research: equity research on Vietnam-listed companies"
  description="Valuation models, open Excel workbooks and weekly VN-Index notes on Vietnam-listed companies by Nguyen Vu Truong Huy, who has passed Level II of the CFA Program."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Nguyen Vu Truong Huy',
    alternateName: 'Nguyễn Vũ Trường Huy',
    url: 'https://truonghuyresearch.xyz',
    jobTitle: 'Finance & Banking Student',
    alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of Economics Ho Chi Minh City', alternateName: 'UEH' },
    hasCredential: { '@type': 'EducationalOccupationalCredential', name: 'CFA Program Level II (passed)', recognizedBy: { '@type': 'Organization', name: 'CFA Institute' } },
    knowsAbout: ['Equity Research', 'Valuation Modeling', 'Vietnam Capital Markets', 'DCF Analysis'],
    sameAs: ['https://www.linkedin.com/in/trghuyy/'],
  })} />

  <!-- 1. Hero & Coverage Distribution -->
  <section class="hero-dossier" aria-labelledby="hero-h">
    <div class="wrap grid grid--center">
      <div class="span-5 stack-5">
        <div>
          <span class="hero-credential">Passed Level II of the CFA Program · UEH Finance</span>
        </div>
        <h1 id="hero-h">Equity research on Vietnam-listed companies</h1>
        <p class="t-lead">
          FCFF DCF, public comparables, precedent transactions, and sponsor LBO models with every Excel workbook open for review, alongside weekly VN-Index notes.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/research">
            Explore Research
            <svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 6h9M6 2.5 9.5 6 6 9.5"/></svg>
          </a>
          <a class="btn btn--secondary" href="/cv.pdf" target="_blank" rel="noopener">
            Download CV (PDF)
          </a>
        </div>
        <dl class="hero-kpi-grid">
          <div class="hero-kpi">
            <dt>Coverage</dt>
            <dd>{valuationModels.length} Companies</dd>
          </div>
          <div class="hero-kpi">
            <dt>Open Models</dt>
            <dd>{workbooks} Workbooks</dd>
          </div>
          <div class="hero-kpi">
            <dt>Prices As Of</dt>
            <dd>{priceDate}</dd>
          </div>
        </dl>
      </div>

      <div class="span-7">
        <CoverageStrip />
      </div>
    </div>
  </section>

  <!-- 2. Interactive Company Valuation Desk (Cross-Blur Panel Morphing) -->
  <section class="section ground-surface" id="research" aria-labelledby="research-h" data-valuation-desk>
    <div class="wrap stack-5">
      <div class="section-head--split">
        <div>
          <h2 id="research-h">Five company valuations</h2>
          <p class="t-lead">Valuation ranges and core assumptions against the reference price each workbook used.</p>
        </div>
        <div class="desk-tabs" role="tablist" aria-label="Select company valuation">
          {reports.map(({ m }, idx) => (
            <button
              type="button"
              role="tab"
              class="desk-tab"
              data-desk-tab={m.slug}
              aria-selected={idx === 0 ? 'true' : 'false'}
            >
              <strong>{m.ticker}</strong>
              <span>{m.company}</span>
            </button>
          ))}
        </div>
      </div>

      <div class="grid grid--top">
        <!-- Left Selector Directory -->
        <div class="span-5 desk-selector">
          {reports.map(({ m, low, high }, idx) => (
            <div
              class:list={['desk-selector__item', idx === 0 && 'is-active']}
              data-desk-row={m.slug}
              tabindex="0"
              role="button"
              aria-label={`${m.company} (${m.ticker})`}
            >
              <div class="desk-selector__top">
                <span class="desk-selector__title">
                  <Ticker label={m.ticker} />
                  <span>{m.company}</span>
                </span>
                <span class="num t-small">
                  <span class:list={['badge', low >= 0 ? 'badge--up' : 'badge--down']}>{signedPct(low, 0)}</span>
                  <span class="muted"> to </span>
                  <span class:list={['badge', high >= 0 ? 'badge--up' : 'badge--down']}>{signedPct(high, 0)}</span>
                </span>
              </div>
              <p class="mono t-label muted">
                {m.sector} · Ref {formatVndK(m.referencePrice.value)} · {m.methods.join(' + ')}
              </p>
              <p class="t-small secondary">{m.report.stance}</p>
            </div>
          ))}
        </div>

        <!-- Right Morphing Panel Stack -->
        <div class="span-7 panel-stack">
          {reports.map(({ m, assumptions, tearHref, tearSize }, idx) => (
            <div
              data-desk-panel={m.slug}
              class:list={['panel-item stack-4', idx === 0 && 'is-active']}
              aria-hidden={idx === 0 ? 'false' : 'true'}
            >
              <FootballField outputs={m.outputs} reference={m.referencePrice} ticker={m.ticker} note />

              <div class="sheet stack-4">
                <div class="sheet__head">
                  <h3 class="t-h3">{m.report.headline}</h3>
                  <span class="badge badge--navy">{m.downloads.length} Excel Models</span>
                </div>

                {m.investmentQuestion && (
                  <p class="t-small secondary">{m.investmentQuestion}</p>
                )}

                <dl class="desk-assumptions">
                  {assumptions.map((a) => (
                    <div>
                      <dt>{a.label}</dt>
                      <dd>{a.value}</dd>
                    </div>
                  ))}
                </dl>

                <div class="btn-row">
                  <a class="btn btn--primary btn--sm" href={`/research/${m.slug}`}>
                    Read {m.ticker} Report
                  </a>
                  <a class="btn btn--secondary btn--sm" href={`/research/${m.slug}/tear-sheet`}>
                    A4 Tear Sheet
                  </a>
                  {tearSize && (
                    <a class="btn btn--ghost btn--sm" href={tearHref} download>
                      PDF ({tearSize})
                    </a>
                  )}
                  {m.downloads.map((d) => (
                    <a class="btn btn--ghost btn--sm" href={d.href} download>
                      {d.label} ({d.format})
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Valuation Frameworks -->
  <section class="section" id="approach" aria-labelledby="approach-h">
    <div class="wrap stack-6">
      <div class="grid grid--top">
        <div class="span-5">
          <h2 id="approach-h">Where methods disagree, the spread is the finding</h2>
        </div>
        <div class="span-7 stack-3">
          <p class="t-lead">
            Each company is valued with the methods that fit its business: an FCFF DCF, peer multiples, precedent transactions, or a sponsor LBO.
          </p>
          <p class="muted">
            Outputs stay separate against the reference share price so the gap between intrinsic cash-flow value, public peer pricing, and control affordability remains visible.
          </p>
        </div>
      </div>

      <div class="grid">
        {methodCards.map((mc) => (
          <a class="card span-4" href={mc.href}>
            <div class="sheet__head">
              <span class="t-label muted">{mc.group.eyebrow}</span>
              <span class="badge badge--navy">{mc.tickers.length} Companies</span>
            </div>
            <h3>{mc.group.title}</h3>
            <p class="t-small secondary">{mc.group.description}</p>
            <div class="tickers">
              {mc.tickers.map((t) => <Ticker label={t} />)}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Vietnam Market Intelligence & Live HOSE Foreign Flow -->
  <section class="section ground-surface" id="notes" aria-labelledby="notes-h">
    <div class="wrap stack-6">
      <div class="section-head--split">
        <div>
          <h2 id="notes-h">VN-Index &amp; HOSE foreign flow</h2>
          <p class="t-lead">Weekly and monthly notes on index structure, liquidity, foreign trading, and cross-asset macro.</p>
        </div>
        <div class="btn-row">
          <a class="btn btn--secondary btn--sm" href="/market-views">
            All {weekly.length + monthly.length} Notes →
          </a>
          <a class="btn btn--ghost btn--sm" href="/monthly-views">
            Monthly ({monthly.length})
          </a>
        </div>
      </div>

      <div class="grid grid--top">
        <div class="span-7 stack-5">
          <div class="sheet">
            <div class="sheet__head">
              <h3 class="t-h3">VN-Index weekly close</h3>
              <span class="mono t-label muted">
                {formatDate(trend[0].time)} – {formatDate(trend[trend.length - 1].time)}
              </span>
            </div>
            <VnIndexChart trendData={trend} label="VN-Index weekly closes" height="md" />
          </div>

          <ForeignFlowMonitor compact />
        </div>

        <div class="span-5 sheet stack-4">
          <div class="sheet__head">
            <h3 class="t-h3">Latest market notes</h3>
            <a class="link t-label" href="/rss.xml">RSS</a>
          </div>
          <ul class="rows">
            {latestNotes.map((n) => (
              <li>
                <div>
                  <span class="mono t-label muted">
                    <span class:list={['badge', n.kind === 'Monthly' ? 'badge--navy' : '']}>{n.kind}</span>{' '}
                    {n.period}
                  </span>
                  <p class="rows__name">
                    <a class="link" href={n.href}>{n.headline}</a>
                  </p>
                </div>
                <div class="rows__value">
                  <span class="num t-small">{formatIndex(n.close)}</span>
                  <br />
                  <span class:list={['badge', n.change >= 0 ? 'badge--up' : 'badge--down']}>
                    {signedPct(n.change)}
                  </span>
                </div>
              </li>
            ))}
          </ul>
          <a class="btn btn--secondary btn--sm" href="/market-views">
            View Full Archive ({weekly.length} Weekly · {monthly.length} Monthly)
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Analyst Profile & A4 Tear-Sheet Specimen -->
  <section class="section" id="about" aria-labelledby="about-h">
    <div class="wrap grid grid--center">
      <div class="span-6 stack-5">
        <h2 id="about-h">Nguyen Vu Truong Huy</h2>
        <p class="t-lead">
          Finance and Banking student at the University of Economics Ho Chi Minh City (UEH), GPA 3.64 / 4.00, who has passed Level II of the CFA Program.
        </p>
        <p class="muted">
          At Hoan Loc Viet I worked with financial data, reporting, and analytical workflows. The models here are built in Excel, Power BI, and Stata, and every report distills into a printable one-page A4 tear sheet.
        </p>

        <dl class="facts">
          <div>
            <dt>CFA Program</dt>
            <dd>Passed Level II of the CFA Program</dd>
          </div>
          <div>
            <dt>Education</dt>
            <dd>UEH — B.A. in Finance &amp; Banking (GPA 3.64 / 4.00)</dd>
          </div>
          <div>
            <dt>Toolchain</dt>
            <dd class="mono">Excel · Power BI · Stata · Python</dd>
          </div>
          <div>
            <dt>Focus</dt>
            <dd>Equity Research · Investment Banking · Capital Markets</dd>
          </div>
        </dl>

        <div class="btn-row">
          <a class="btn btn--primary" href="/cv.pdf" target="_blank" rel="noopener">
            Download CV (PDF)
          </a>
          <a class="btn btn--secondary" href="/contact">
            Contact Huy
          </a>
        </div>
      </div>

      <figure class="paper span-6">
        <div class="stack-3">
          <a href="/research/hpg/tear-sheet">
            <img
              src="/research/tear-sheets/hpg-page.png"
              width="794"
              height="1123"
              alt="One-page A4 tear sheet for Hoa Phat Group (HPG)"
              loading="lazy"
            />
          </a>
          <figcaption class="sheet__head t-label muted">
            <span>Hoa Phat Group (HPG) one-page A4 tear sheet</span>
            <a class="link" href="/research/hpg/tear-sheet">Open printable view →</a>
          </figcaption>
        </div>
      </figure>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-valuation-desk]').forEach((desk) => {
    const tabs = Array.from(desk.querySelectorAll<HTMLButtonElement>('[data-desk-tab]'));
    const rows = Array.from(desk.querySelectorAll<HTMLElement>('[data-desk-row]'));
    const panels = Array.from(desk.querySelectorAll<HTMLElement>('[data-desk-panel]'));

    const activate = (slug: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.deskTab === slug)));
      rows.forEach((r) => r.classList.toggle('is-active', r.dataset.deskRow === slug));
      panels.forEach((p) => {
        const active = p.dataset.deskPanel === slug;
        p.classList.toggle('is-active', active);
        p.setAttribute('aria-hidden', String(!active));
      });
    };

    tabs.forEach((t) => {
      t.addEventListener('click', () => {
        if (t.dataset.deskTab) activate(t.dataset.deskTab);
      });
    });

    rows.forEach((r) => {
      const slug = r.dataset.deskRow;
      if (!slug) return;
      r.addEventListener('click', () => activate(slug));
      r.addEventListener('pointerenter', () => activate(slug));
      r.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          activate(slug);
        }
      });
    });
  });
</script>
