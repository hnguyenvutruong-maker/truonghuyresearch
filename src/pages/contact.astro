---
import BaseLayout from '../layouts/BaseLayout.astro';
import { impliedMovePct, valuationModels } from '../data/valuation-models';
import { formatDate, formatVndK, signedPct } from '../lib/format';
---

<BaseLayout
  title="About – Nguyen Vu Truong Huy | Truong Huy Research"
  description="Meet Nguyen Vu Truong Huy, Equity Research Analyst (Passed CFA Level II, B.A. in Corporate Finance at UEH) based in Ho Chi Minh City."
>
  <!-- Fixed Left Table of Contents (magic-portfolio/src/components/about/TableOfContents.tsx) -->
  <nav class="once-about-toc" aria-label="About page sections">
    <a class="once-toc-link" href="#Introduction">
      <span class="once-toc-dash" aria-hidden="true"></span>
      <span>Introduction</span>
    </a>
    <a class="once-toc-link" href="#Research-Coverage">
      <span class="once-toc-dash" aria-hidden="true"></span>
      <span>Work Experience</span>
    </a>
    <a class="once-toc-link" href="#Studies">
      <span class="once-toc-dash" aria-hidden="true"></span>
      <span>Studies</span>
    </a>
    <a class="once-toc-link" href="#Technical-Skills">
      <span class="once-toc-dash" aria-hidden="true"></span>
      <span>Technical skills</span>
    </a>
  </nav>

  <div class="once-col-m">
    <div class="once-about-row">
      <!-- Left Sticky Avatar Column (magic-portfolio/src/app/about/page.tsx lines 84-112) -->
      <aside class="once-about-avatar-col" data-reveal>
        <div class="once-avatar once-avatar-xl" aria-label="Nguyen Vu Truong Huy">TH</div>

        <div class="once-post-author body-default-s">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--brand-on-background-weak)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10" />
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" />
            <path d="M2 12h20" />
          </svg>
          <span>Asia/Ho_Chi_Minh</span>
        </div>

        <div class="once-project-tags">
          <span class="once-tag">English</span>
          <span class="once-tag">Vietnamese</span>
          <span class="once-tag once-tag-brand">CFA Level II</span>
        </div>
      </aside>

      <!-- Right Content Column (magic-portfolio/src/app/about/page.tsx lines 114-342) -->
      <div class="once-about-main-col">
        <section id="Introduction" data-reveal>
          <a class="once-schedule-pill" href="/cv.pdf" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--brand-on-background-weak)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="18" height="18" x="3" y="4" rx="2" ry="2" />
              <line x1="16" x2="16" y1="2" y2="6" />
              <line x1="8" x2="8" y1="2" y2="6" />
              <line x1="3" x2="21" y1="10" y2="10" />
            </svg>
            <span>Schedule a call / Download CV</span>
            <span class="once-schedule-icon-btn" aria-hidden="true">→</span>
          </a>

          <h1 class="display-strong-xl">Nguyen Vu Truong Huy</h1>
          <p class="display-default-xs on-neutral-weak">
            Equity Research Analyst · Passed CFA Level II
          </p>

          <div class="once-project-tags">
            <a class="once-btn once-btn-s once-btn-secondary" href="https://github.com/hnguyenvutruong-maker/truonghuyresearch" target="_blank" rel="noopener">
              <span>GitHub</span>
            </a>
            <a class="once-btn once-btn-s once-btn-secondary" href="https://www.linkedin.com/in/trghuyy/" target="_blank" rel="noopener">
              <span>LinkedIn</span>
            </a>
            <a class="once-btn once-btn-s once-btn-secondary" href="mailto:hnguyenvutruong@gmail.com">
              <span>Email</span>
            </a>
            <a class="once-btn once-btn-s once-btn-secondary" href="/cv.pdf" target="_blank" rel="noopener">
              <span>CV (PDF)</span>
            </a>
            <a class="once-btn once-btn-s once-btn-secondary" href="tel:0962220094">
              <span>0962220094</span>
            </a>
          </div>

          <p class="body-default-l on-neutral-medium">
            Truong Huy is a Ho Chi Minh City-based finance graduate from the University of Economics Ho Chi Minh City (UEH) who has passed Level II of the CFA Program. His work transforms complex Vietnamese corporate disclosures and macro data into transparent, cell-by-cell auditable valuation models across FCFF DCF, trading comparables, precedent transactions, and sponsor LBOs.
          </p>
        </section>

        <!-- Work Experience / Research Coverage -->
        <section id="Research-Coverage" data-reveal>
          <h2 class="display-strong-s">Work Experience &amp; Coverage</h2>

          <div class="once-val-rows">
            {valuationModels.map((m) => {
              const moves = m.outputs.map((o) => impliedMovePct(o, m.referencePrice));
              const low = Math.min(...moves);
              const high = Math.max(...moves);
              return (
                <div class="once-surface-card">
                  <div class="once-Slide-header">
                    <a href={`/research/${m.slug}`} class="heading-strong-l">
                      {m.ticker} — {m.company}
                    </a>
                    <span class="heading-default-xs on-neutral-weak">
                      Ref {formatDate(m.referencePrice.asOf)} · VND {formatVndK(m.referencePrice.value)}
                    </span>
                  </div>
                  <p class="body-default-s on-brand-weak">
                    {m.sector} · {m.methods.join(' + ')} · Implied Move: {signedPct(low, 0)} to {signedPct(high, 0)}
                  </p>
                  <p class="body-default-m on-neutral-medium">
                    {m.report.headline} {m.summary}
                  </p>
                  <div class="once-project-links">
                    <a class="once-smart-link" href={`/research/${m.slug}`}>
                      <span>Read case study</span>
                      <span class="once-arrow-icon" aria-hidden="true">→</span>
                    </a>
                    <a class="once-smart-link" href={`/research/${m.slug}/tear-sheet`}>
                      <span>Printable A4 Tear Sheet</span>
                      <span class="once-arrow-icon" aria-hidden="true">↗</span>
                    </a>
                    {m.downloads.map((d) => (
                      <a class="once-smart-link" href={d.href} download>
                        <span>{d.label} ({d.format})</span>
                        <span class="once-arrow-icon" aria-hidden="true">↓</span>
                      </a>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        </section>

        <!-- Studies -->
        <section id="Studies" data-reveal>
          <h2 class="display-strong-s">Studies</h2>

          <div class="once-val-rows">
            <div class="once-surface-card">
              <div class="once-Slide-header">
                <h3 class="heading-strong-l">CFA Institute</h3>
                <span class="heading-default-xs on-brand-weak">Passed Level II</span>
              </div>
              <p class="body-default-m on-neutral-weak">
                Passed Level I and Level II of the CFA Program covering equity valuation, financial reporting and analysis, corporate issuers, fixed income, derivatives, and portfolio management.
              </p>
            </div>

            <div class="once-surface-card">
              <div class="once-Slide-header">
                <h3 class="heading-strong-l">University of Economics Ho Chi Minh City (UEH)</h3>
                <span class="heading-default-xs on-neutral-weak">B.A. in Corporate Finance</span>
              </div>
              <p class="body-default-m on-neutral-weak">
                Studied corporate finance, capital budgeting, financial statement analysis, and Vietnamese capital markets.
              </p>
            </div>
          </div>
        </section>

        <!-- Technical Skills -->
        <section id="Technical-Skills" data-reveal>
          <h2 class="display-strong-s">Technical skills</h2>

          <div class="once-val-rows">
            <div class="once-surface-card">
              <h3 class="heading-strong-l">Intrinsic FCFF Discounted Cash Flow</h3>
              <p class="body-default-m on-neutral-weak">
                5-year explicit revenue, margin, working-capital, and capex schedules with WACC build-up, terminal value cross-checks, and 5×5 sensitivity matrices.
              </p>
              <div class="once-project-tags">
                <span class="once-tag once-tag-brand">FCFF DCF</span>
                <span class="once-tag">WACC Build</span>
                <span class="once-tag">HPG</span>
                <span class="once-tag">FPT</span>
              </div>
            </div>

            <div class="once-surface-card">
              <h3 class="heading-strong-l">Public Comparables &amp; Precedent Transactions</h3>
              <p class="body-default-m on-neutral-weak">
                Normalized peer P/E, EV/EBITDA, and P/B multiple distributions alongside historical M&amp;A control transaction benchmarks.
              </p>
              <div class="once-project-tags">
                <span class="once-tag once-tag-brand">Trading Multiples</span>
                <span class="once-tag">M&amp;A Precedents</span>
                <span class="once-tag">BID</span>
                <span class="once-tag">PNJ</span>
                <span class="once-tag">BMP</span>
              </div>
            </div>

            <div class="once-surface-card">
              <h3 class="heading-strong-l">Sponsor LBO &amp; VN-Index Market Telemetry</h3>
              <p class="body-default-m on-neutral-weak">
                5-year debt sweep and IRR floor modeling paired with weekly VN-Index technical structure and 109-session HOSE foreign flow tracking.
              </p>
              <div class="once-project-tags">
                <span class="once-tag once-tag-brand">Sponsor LBO</span>
                <span class="once-tag">HOSE Foreign Flow</span>
                <span class="once-tag">27 Market Notes</span>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
