---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Panel from '../components/ui/Panel.astro';

const contactRows = [
  { label: 'Email', value: 'hnguyenvutruong@gmail.com', href: 'mailto:hnguyenvutruong@gmail.com', external: false },
  { label: 'Phone', value: '0962220094', href: 'tel:0962220094', external: false },
  { label: 'LinkedIn', value: 'linkedin.com/in/trghuyy', href: 'https://www.linkedin.com/in/trghuyy/', external: true },
  { label: 'CV', value: 'Download the CV (PDF)', href: '/cv.pdf', external: true },
];
---

<BaseLayout title="Contact | Truong Huy Research" description="Contact Nguyen Vu Truong Huy about equity research, capital markets and investment banking internships.">
  <div class="mx-auto grid w-full max-w-container-max grid-cols-1 gap-4 px-margin-mobile py-6 md:px-margin-desktop md:py-8 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <PageHeader
        tone="profile"
        kicker="Get in touch"
        title="Contact"
        lead="Nguyễn Vũ Trường Huy is open to Equity Research, Capital Markets, and Investment Banking internships. Questions about a model or a note are welcome too."
        back={{ href: '/', label: 'Front page' }}
        context="Ho Chi Minh City"
      />
    </div>
    <Panel title="Direct lines" tone="profile" class="lg:col-span-7" flush>
      <dl>
        {contactRows.map((row) => (
          <div class="grid grid-cols-1 gap-1 border-b border-line px-4 py-4 last:border-b-0 sm:grid-cols-[7rem_minmax(0,1fr)] sm:items-baseline sm:gap-6 md:px-5">
            <dt class="font-mono text-label uppercase text-fg-muted">{row.label}</dt>
            <dd>
              <a
                href={row.href}
                target={row.external ? '_blank' : undefined}
                rel={row.external ? 'noopener noreferrer' : undefined}
                class="u-link break-all font-display text-h3 text-link transition-colors hover:text-fg md:text-[1.375rem]"
              >
                {row.value}
              </a>
            </dd>
          </div>
        ))}
      </dl>
    </Panel>
  </div>
</BaseLayout>
