---
import BaseLayout from '../layouts/BaseLayout.astro';
import DocHead from '../components/ui/DocHead.astro';
const rows = [
  { label: 'Email', value: 'hnguyenvutruong@gmail.com', href: 'mailto:hnguyenvutruong@gmail.com' },
  { label: 'Phone', value: '0962220094', href: 'tel:0962220094' },
  { label: 'LinkedIn', value: 'linkedin.com/in/trghuyy', href: 'https://www.linkedin.com/in/trghuyy/' },
];
---
<BaseLayout title="Contact Nguyen Vu Truong Huy | Truong Huy Research" description="Contact Nguyen Vu Truong Huy about equity research, capital markets and investment banking internships in Ho Chi Minh City.">
  <div class="doc">
    <DocHead label="Ho Chi Minh City" title="Contact Huy" lead="Open to equity research, capital markets and investment banking internships. Questions about a model or a note are welcome too.">
      <dl slot="aside" class="facts contact">
        {rows.map((r) => <div><dt>{r.label}</dt><dd><a class="link" href={r.href}>{r.value}</a></dd></div>)}
      </dl>
    </DocHead>
  </div>
</BaseLayout>
