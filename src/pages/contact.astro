---
import BaseLayout from '../layouts/BaseLayout.astro';

const contactRows = [
  { label: 'Email', value: 'hnguyenvutruong@gmail.com', href: 'mailto:hnguyenvutruong@gmail.com', external: false },
  { label: 'Phone', value: '0962220094', href: 'tel:0962220094', external: false },
  { label: 'LinkedIn', value: 'linkedin.com/in/trghuyy', href: 'https://www.linkedin.com/in/trghuyy/', external: true },
  { label: 'CV', value: 'Download the CV (PDF)', href: '/cv.pdf', external: true },
];
---

<BaseLayout title="Contact | Truong Huy Research" description="Contact Nguyen Vu Truong Huy about equity research, capital markets and investment banking internships.">
  <section class="mx-auto w-full max-w-container-max px-margin-mobile pb-16 pt-8 md:px-margin-desktop md:pt-10">
    <div class="flex animate-rise flex-wrap items-center justify-between gap-x-6 gap-y-1 border-b border-ink pb-2 font-news-mono text-news-label uppercase text-ink-muted">
      <a href="/" class="news-link transition-colors hover:text-oxblood">← Front page</a>
      <span>Ho Chi Minh City</span>
    </div>

    <div class="grid grid-cols-1 gap-10 py-10 lg:grid-cols-12 lg:gap-0">
      <header class="lg:col-span-5 lg:pr-10">
        <p class="animate-rise font-news-mono text-news-label uppercase text-oxblood">Letters to the analyst</p>
        <h1 class="mt-4 animate-rise font-news text-news-hero text-ink [animation-delay:80ms]">Contact</h1>
        <p class="mt-6 animate-rise font-news text-news-dek italic text-ink-soft [animation-delay:160ms]">
          Nguyễn Vũ Trường Huy is open to Equity Research, Capital Markets, and Investment Banking internships. Questions about
          a model or a note are welcome too.
        </p>
      </header>

      <div class="animate-rise [animation-delay:240ms] lg:col-span-7 lg:border-l lg:border-ink/25 lg:pl-10">
        <dl class="border-t-2 border-ink">
          {contactRows.map((row) => (
            <div class="grid grid-cols-1 gap-1 border-b border-ink/20 py-5 sm:grid-cols-[8rem_minmax(0,1fr)] sm:items-baseline sm:gap-6">
              <dt class="font-news-mono text-news-label uppercase text-ink-muted">{row.label}</dt>
              <dd>
                <a
                  href={row.href}
                  target={row.external ? '_blank' : undefined}
                  rel={row.external ? 'noopener noreferrer' : undefined}
                  class="news-link break-all font-news text-[1.375rem] leading-tight text-ink transition-colors hover:text-oxblood md:text-[1.625rem]"
                >
                  {row.value}
                </a>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>
