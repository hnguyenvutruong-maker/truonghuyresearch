---
import BaseLayout from '../layouts/BaseLayout.astro';
import Seal from '../components/broadsheet/Seal.astro';

const links = [
  { label: 'Front page', href: '/' },
  { label: 'Coverage', href: '/research' },
  { label: 'Market notes', href: '/market-views' },
];
---

<BaseLayout title="Page Not Found | Truong Huy Research" description="The page you are looking for does not exist.">
  <section class="mx-auto flex min-h-[60vh] w-full max-w-container-max flex-col items-center justify-center px-margin-mobile py-16 text-center md:px-margin-desktop">
    <Seal label="404" size="lg" motion="load" decorative />
    <p class="mt-8 font-news-mono text-news-label uppercase text-oxblood">Correction</p>
    <h1 class="mt-4 font-news text-news-h2 text-ink">This page did not go to print</h1>
    <p class="mt-5 max-w-xl font-news text-news-dek italic text-ink-soft">
      The address may have changed, or the page never existed. Try one of the sections below.
    </p>
    <nav aria-label="Sections" class="mt-10 flex flex-wrap justify-center gap-3">
      {links.map((link, index) => (
        <a
          href={link.href}
          class:list={[
            'inline-flex min-h-12 items-center px-6 py-3 font-news-mono text-news-label uppercase transition-colors',
            index === 0 ? 'bg-ink text-paper hover:bg-oxblood hover:text-paper' : 'border border-ink text-ink hover:bg-ink hover:text-paper',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </section>
</BaseLayout>
