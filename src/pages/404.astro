---
import BaseLayout from '../layouts/BaseLayout.astro';
import DocHead from '../components/ui/DocHead.astro';
---

<BaseLayout title="Page not found | Truong Huy Research" description="The page you are looking for does not exist.">
  <div class="doc">
    <DocHead
      label="HTTP 404 · Document Not Found"
      title="This page does not exist"
      lead="The address may have changed, or the report you requested is located under another ticker or archive date."
      back={{ href: '/', label: 'Return to Home' }}
    >
      <div class="btn-row">
        <a class="btn btn--primary" href="/research">Explore Research Coverage</a>
        <a class="btn btn--secondary" href="/market-views">Browse Market Notes</a>
        <button type="button" class="btn btn--ghost" data-cmd-open>Search All Reports (⌘K)</button>
      </div>
    </DocHead>
  </div>
</BaseLayout>
