---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import PageHeader from '../components/ui/PageHeader.astro';
---

<BaseLayout title="Page not found | Truong Huy Research" description="The page you are looking for does not exist.">
  <PageHeader
    eyebrow="404 · Not found"
    title="This page does not exist"
    lead="The address may have changed, or the report lives under another ticker or note date."
  >
    <div class="btn-row">
      <a class="btn btn--primary" href="/research">Research coverage</a>
      <a class="btn btn--secondary" href="/market-views">Market notes</a>
      <button type="button" class="btn btn--ghost" data-cmd-open><Icon name="search" size={14} /> Search <kbd>⌘K</kbd></button>
    </div>
  </PageHeader>
</BaseLayout>
