---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { portfolioDisclaimer } from '../data/valuation-models';

const terms = [
  {
    title: 'Personal academic work',
    text: 'All financial models, valuation reports, tear sheets and market notes on truonghuyresearch.xyz are personal academic and portfolio work by Nguyen Vu Truong Huy. They do not represent the views, positions or strategies of any current or past employer, university or institution.',
  },
  {
    title: 'Point-in-time valuation figures',
    text: 'Valuation outputs and reference share prices are as of the model date shown on each report and workbook (11 June 2026) and are not refreshed with live quotes. Implied upside or downside compares only against those model-date prices.',
  },
  {
    title: 'Automated data and language-model assistance',
    text: 'Weekly and monthly notes are drafted with automated Python data collection and a language model; frontmatter figures are enforced against measured market data. A dash (—) means the figure was unavailable from primary sources at publication.',
  },
  {
    title: 'No investment advice',
    text: 'Nothing here is financial, legal, tax or investment advice, or a recommendation or solicitation to buy, hold or sell any security. Verify every assumption, date, figure and formula independently before relying on it.',
  },
];
---

<BaseLayout title="Disclaimer | Truong Huy Research" description="Academic portfolio disclaimer for the valuation models and market notes on truonghuyresearch.xyz.">
  <PageHeader crumbs={[{ label: 'Disclaimer' }]} eyebrow="Important disclosures" title="Disclaimer" lead={portfolioDisclaimer} />
  <section class="section--tight">
    <div class="container container--narrow">
      {terms.map((t, i) => (
        <div class="cv-item">
          <span class="cv-item__when">0{i + 1}</span>
          <div>
            <h2 class="h3">{t.title}</h2>
            <p class="text-2">{t.text}</p>
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
