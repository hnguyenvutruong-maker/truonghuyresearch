---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Panel from '../components/ui/Panel.astro';
import { portfolioDisclaimer } from '../data/valuation-models';
---

<BaseLayout title="Disclaimer | Truong Huy Research" description="Academic portfolio disclaimer for the valuation models and market notes on truonghuyresearch.xyz.">
  <div class="mx-auto w-full max-w-container-max space-y-4 px-margin-mobile py-6 md:px-margin-desktop md:py-8">
    <PageHeader tone="neutral" kicker="Disclosure" title="Disclaimer" back={{ href: '/', label: 'Front page' }} context="Academic portfolio" />
    <Panel title="Read before using any figure" tone="neutral">
      <div class="max-w-3xl space-y-4 text-body text-fg">
        <p class="border-l-4 border-market bg-panel-alt px-4 py-3 text-lead font-semibold">{portfolioDisclaimer}</p>
        <p>
          All models, market views, and equity research notes reflect personal academic work. They do not represent the views,
          official positions, or investment strategies of any current or past employer.
        </p>
        <p>
          Valuation figures are as of the model date shown on each report and are not refreshed automatically. Market notes are
          drafted with the help of automated data collection and a language model, then checked against the recorded market
          data; figures marked with a dash were unavailable.
        </p>
        <p>
          Readers should verify all assumptions, dates, market data, and workbook formulas independently before using any
          material for analysis or decision-making.
        </p>
      </div>
    </Panel>
  </div>
</BaseLayout>
