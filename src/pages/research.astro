---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverageStrip from '../components/ui/CoverageStrip.astro';
import CoverageTable from '../components/ui/CoverageTable.astro';
import DatedNote from '../components/ui/DatedNote.astro';
import Disclaimer from '../components/ui/Disclaimer.astro';
import DocHead from '../components/ui/DocHead.astro';
import Ticker from '../components/ui/Ticker.astro';
import { STALE_AFTER_DAYS, methodPages, valuationGroups, valuationModels } from '../data/valuation-models';
import { daysBetween, formatDate } from '../lib/format';

const workbooks = valuationModels.reduce((t, m) => t + m.downloads.length, 0);
const oldest = [...new Set(valuationModels.map((m) => m.lastUpdated ?? m.referencePrice.asOf))].sort()[0];
const stale = daysBetween(oldest, new Date()) > STALE_AFTER_DAYS;
const methods = methodPages.map((p) => ({
  ...p,
  group: valuationGroups.find((g) => g.id === p.id),
  tickers: valuationModels.filter((m) => m.valuationNotes.some((n) => n.groups.includes(p.id))).map((m) => m.ticker),
}));
---
<BaseLayout title="Research coverage: five Vietnam-listed companies | Truong Huy Research" description="Valuation coverage of HPG, BID, FPT, BMP and PNJ: DCF, comparable, precedent-transaction and LBO outputs against the price each model used, with downloadable workbooks.">
  <div class="doc">
    <DocHead label={`${valuationModels.length} companies · ${workbooks} workbooks`} title="Research coverage" lead="Each company valued with the methods that fit its business, every workbook open for review. Ranges, not single targets.">
      <div slot="aside"><CoverageStrip /></div>
    </DocHead>
    <section class="ground-surface" aria-labelledby="table-h">
      <div class="wrap stack-6">
        <div class="section-head--split"><div><h2 id="table-h">Outputs by method</h2><p class="t-lead muted">VND per share. Sort by any column.</p></div></div>
        {stale && <DatedNote>All models and prices are as of {formatDate(oldest)} and have not been refreshed since. Implied moves are against those prices, not today's.</DatedNote>}
        <div class="sheet"><CoverageTable sortable /></div>
        <p class="t-label muted">≈ marks an approximate precedent-transaction output. Low and high move are the weakest and strongest method against the price used.</p>
      </div>
    </section>
    <section aria-labelledby="methods-h">
      <div class="wrap">
        <div class="section-head"><h2 id="methods-h">Three valuation methods</h2><p class="t-lead muted">Each method page gathers the notes and workbooks for every company it was used on.</p></div>
        <div class="grid">
          {methods.map((m) => m.group && (
            <a class="card span-4" href={m.href}>
              <p class="t-label muted">{m.group.eyebrow}</p>
              <h3>{m.group.title}</h3>
              <p>{m.group.description}</p>
              <p class="tickers">{m.tickers.map((t) => <Ticker label={t} />)}</p>
            </a>
          ))}
        </div>
        <Disclaimer />
      </div>
    </section>
  </div>
</BaseLayout>
