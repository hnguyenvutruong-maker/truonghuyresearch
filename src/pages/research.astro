---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverageTable from '../components/ui/CoverageTable.astro';
import DatedNote from '../components/ui/DatedNote.astro';
import Disclaimer from '../components/ui/Disclaimer.astro';
import Icon from '../components/ui/Icon.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Panel from '../components/ui/Panel.astro';
import Tick from '../components/ui/Tick.astro';
import { STALE_AFTER_DAYS, methodPages, valuationGroups, valuationModels } from '../data/valuation-models';
import { daysBetween, formatDate } from '../lib/format';

const downloadCount = valuationModels.reduce((total, model) => total + model.downloads.length, 0);
const modelDates = [...new Set(valuationModels.map((model) => model.lastUpdated ?? model.referencePrice.asOf))].sort();
const oldestDate = modelDates[0];
const isStale = daysBetween(oldestDate, new Date()) > STALE_AFTER_DAYS;

const methods = methodPages.map((page) => {
  const group = valuationGroups.find((item) => item.id === page.id);
  const models = valuationModels.filter((model) => model.valuationNotes.some((note) => note.groups.includes(page.id)));
  return { ...page, group, tickers: models.map((model) => model.ticker) };
});
---

<BaseLayout
  title="Coverage | Truong Huy Research"
  description="Vietnam equity valuation coverage: DCF, comparable, precedent-transaction and LBO outputs for HPG, BID, FPT, BMP and PNJ, with downloadable workbooks."
>
  <div class="mx-auto w-full max-w-container-max space-y-4 px-margin-mobile py-6 md:px-margin-desktop md:py-8">
    <PageHeader
      tone="value"
      kicker="Section II · Valuation"
      title="Coverage"
      lead="Five Vietnam-listed issuers, each valued with the methods that fit the business, and every workbook open for review. Ranges, not single targets: where methods disagree, the spread is the finding."
      context={`${valuationModels.length} issuers · ${downloadCount} workbooks`}
    >
      <div slot="aside" class="border border-line bg-panel-alt p-4">
        <p class="font-mono text-label uppercase text-value-ink">How to read the table</p>
        <p class="mt-2 text-small text-fg">
          Values are VND per share. The implied move compares each method's base case or midpoint with the share price the
          model used. Click a column heading to sort.
        </p>
      </div>
    </PageHeader>

    {isStale && (
      <DatedNote>
        All models and prices are as of {formatDate(oldestDate)} and have not been refreshed since. Implied moves are against
        those prices, not today's.
      </DatedNote>
    )}

    <Panel title="Coverage table · VND per share" meta="Sortable" tone="value" flush>
      <p class="border-b border-line bg-panel-alt px-4 py-2 font-mono text-[0.75rem] text-fg-muted sm:hidden">Scroll sideways for every method.</p>
      <CoverageTable sortable />
      <p class="border-t border-line px-4 py-3 text-[0.875rem] text-fg-muted">
        ≈ marks approximate precedent-transaction outputs. Low and high move are the weakest and strongest method versus the
        price used; methods are not blended into one target. Academic work, not investment advice.
      </p>
    </Panel>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      {methods.map((method) => method.group && (
        <Panel title={method.group.title} meta={method.group.eyebrow} tone="value" level={3} reveal>
          <p class="text-small text-fg">{method.group.description}</p>
          <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-3">
            <span class="flex flex-wrap gap-1.5">{method.tickers.map((ticker) => <Tick label={ticker} size="sm" />)}</span>
            <a href={method.href} class="inline-flex items-center gap-1 font-mono text-[0.8125rem] font-semibold text-link transition-colors hover:text-fg">
              Open <Icon name="arrow_forward" size={16} />
            </a>
          </div>
        </Panel>
      ))}
    </div>

    <Disclaimer />
  </div>
</BaseLayout>
