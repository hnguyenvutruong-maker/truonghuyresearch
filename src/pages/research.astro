---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverageStrip from '../components/ui/CoverageStrip.astro';
import Disclaimer from '../components/ui/Disclaimer.astro';
import FootballField from '../components/ui/FootballField.astro';
import Icon from '../components/ui/Icon.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import ResearchTerminal from '../components/ui/ResearchTerminal.astro';
import Ticker from '../components/ui/Ticker.astro';
import ValuationComparator from '../components/ui/ValuationComparator.astro';
import WorkbookVault from '../components/ui/WorkbookVault.astro';
import { impliedMovePct, methodPages, valuationGroups, valuationModels } from '../data/valuation-models';
import { formatDate, signedPct } from '../lib/format';

const workbooks = valuationModels.reduce((t, m) => t + m.downloads.length, 0);
const priceDate = formatDate(valuationModels[0].referencePrice.asOf);
const methods = methodPages.map((p) => ({
  ...p,
  group: valuationGroups.find((g) => g.id === p.id)!,
  tickers: valuationModels.filter((m) => m.valuationNotes.some((n) => n.groups.includes(p.id))).map((m) => m.ticker),
}));
const reports = valuationModels.map((m) => {
  const moves = m.outputs.map((o) => impliedMovePct(o, m.referencePrice));
  return { m, low: Math.min(...moves), high: Math.max(...moves) };
});
---

<BaseLayout
  title="Research coverage | Truong Huy Research"
  description="Valuation coverage of HPG, BID, FPT, BMP and PNJ: DCF, comparable, precedent-transaction and LBO outputs against the price each model used, with downloadable Excel workbooks and A4 tear sheets."
>
  <PageHeader
    crumbs={[{ label: 'Research' }]}
    eyebrow="Equity research · Vietnam"
    title="Coverage"
    lead="Five Vietnam-listed companies, valued with two or three methods each. Every range is measured against the share price the model used, and every model is a download away."
  >
    <div class="btn-row">
      <a class="btn btn--primary" href="#monitor">Open the monitor</a>
      <a class="btn btn--secondary" href="#files"><Icon name="download" size={14} /> Model files</a>
      <button type="button" class="btn btn--ghost" data-cmd-open><Icon name="search" size={14} /> Search <kbd>/</kbd></button>
    </div>
    <dl slot="aside" class="facts">
      <div><dt>Companies</dt><dd>{valuationModels.length}</dd></div>
      <div><dt>Excel workbooks</dt><dd>{workbooks}</dd></div>
      <div><dt>Methods</dt><dd>4 frameworks</dd></div>
      <div><dt>Prices as of</dt><dd>{priceDate}</dd></div>
    </dl>
  </PageHeader>
  <CoverageStrip />

  <section class="section--tight" id="monitor" aria-labelledby="monitor-title">
    <div class="container stack-6">
      <div class="sec-head">
        <h2 id="monitor-title">Valuation monitor</h2>
        <span class="small muted">Sort any column · filter by method</span>
      </div>
      <ResearchTerminal title="Coverage monitor" />
    </div>
  </section>

  <section class="section--tight" aria-labelledby="reports-title">
    <div class="container">
      <div class="sec-head">
        <h2 id="reports-title">Company reports</h2>
        <span class="small muted">Implied move range across methods</span>
      </div>
      <div class="grid-3">
        {reports.map(({ m, low, high }) => (
          <a class="card card--link stack-4" href={`/research/${m.slug}`} data-reveal>
            <div class="row row--between">
              <span class="cell-co">
                <Ticker label={m.ticker} size="lg" />
                <span>{m.ticker}<span class="cell-co__sub">{m.company}</span></span>
              </span>
              <span class="tag tag--mono">{signedPct(low, 0)} / {signedPct(high, 0)}</span>
            </div>
            <p class="small text-2">{m.report.headline}</p>
            <FootballField outputs={m.outputs} reference={m.referencePrice} ticker={m.ticker} legend={false} />
            <div class="row">
              {m.methods.map((x) => <span class="tag">{x}</span>)}
            </div>
            <span class="arrow-link">Read report <Icon name="arrow_right" size={14} /></span>
          </a>
        ))}
        <div class="card stack-4" data-reveal>
          <p class="eyebrow">Overview</p>
          <FootballField models={valuationModels} />
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight" id="comparator" aria-labelledby="spread-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Method spread</p>
          <h2 id="spread-title" class="display display-s">Where the methods disagree, the spread is the finding</h2>
        </div>
        <p class="section-head__aside">Each card lists every method's output against the price used, and why the methods land apart.</p>
      </div>
      <ValuationComparator />
    </div>
  </section>

  <section class="section--tight" id="methods" aria-labelledby="methods-title">
    <div class="container">
      <div class="sec-head">
        <h2 id="methods-title">Valuation frameworks</h2>
      </div>
      <div class="grid-3">
        {methods.map((p, i) => (
          <a class="card card--link stack-3" href={p.href}>
            <span class:list={['qlist__dot', ['qlist__dot--dcf', 'qlist__dot--comp', 'qlist__dot--lbo'][i]]}>{p.group.title.slice(0, 1)}</span>
            <p class="eyebrow">{p.group.eyebrow}</p>
            <h3 class="card__title">{p.group.title}</h3>
            <p class="small text-2">{p.group.description}</p>
            <div class="row">{p.tickers.map((t) => <span class="tag tag--mono">{t}</span>)}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section--tight" id="files" aria-labelledby="files-title">
    <div class="container stack-6">
      <div class="sec-head">
        <h2 id="files-title">Model files</h2>
        <span class="small muted">Unprotected workbooks and printable A4 tear sheets</span>
      </div>
      <WorkbookVault />
      <Disclaimer />
    </div>
  </section>
</BaseLayout>
