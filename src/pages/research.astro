---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverageTable from '../components/ui/CoverageTable.astro';
import Disclaimer from '../components/ui/Disclaimer.astro';
import FootballField from '../components/ui/FootballField.astro';
import Icon from '../components/ui/Icon.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import Ticker from '../components/ui/Ticker.astro';
import ValuationComparator from '../components/ui/ValuationComparator.astro';
import WorkbookVault from '../components/ui/WorkbookVault.astro';
import { impliedMovePct, methodPages, valuationGroups, valuationModels } from '../data/valuation-models';
import { formatDate, formatVndK, signedPct } from '../lib/format';

const workbooks = valuationModels.reduce((t, m) => t + m.downloads.length, 0);
const priceDate = formatDate(valuationModels[0].referencePrice.asOf);
const methods = methodPages.map((p) => ({
  ...p,
  group: valuationGroups.find((g) => g.id === p.id)!,
  tickers: valuationModels.filter((m) => m.valuationNotes.some((n) => n.groups.includes(p.id))).map((m) => m.ticker),
}));
const reports = valuationModels.map((m) => {
  const moves = m.outputs.map((o) => impliedMovePct(o, m.referencePrice));
  return { m, low: Math.min(...moves), high: Math.max(...moves) };
});
---

<BaseLayout
  title="Coverage | Truong Huy Research"
  description="Valuation coverage of HPG, BID, FPT, BMP and PNJ: DCF, comparable, precedent-transaction and LBO outputs against the price each model used, with downloadable Excel workbooks and A4 tear sheets."
>
  <PageHeader
    crumbs={[{ label: 'Coverage' }]}
    eyebrow="Coverage · 5 companies · HOSE"
    title="Coverage"
    lead="Every company is valued with two or three methods. Each range is measured against the share price the model used, and every workbook is a download away."
  >
    <div class="btn-row">
      <a class="btn btn--primary" href="#files"><Icon name="download" size={12} /> Model files</a>
      <a class="btn btn--ghost" href="#spread">Method spread</a>
      <a class="btn btn--ghost" href="#methods">Methods</a>
    </div>
    <dl slot="aside" class="facts facts--focus">
      <div><dt>Prices used as of</dt><dd>{priceDate}</dd></div>
      <div><dt>Companies</dt><dd>{valuationModels.length}</dd></div>
      <div><dt>Excel workbooks</dt><dd>{workbooks}</dd></div>
      <div><dt>Frameworks</dt><dd>DCF · Comps · Prec · LBO</dd></div>
    </dl>
  </PageHeader>

  <div class="container ws">
    <section class="panel col-24" id="monitor" aria-labelledby="mon-title">
      <div class="panel__head">
        <h2 class="panel__title" id="mon-title"><Icon name="table" size={13} /> Coverage monitor</h2>
        <span class="panel__meta">VND/share · implied move vs. price used</span>
      </div>
      <CoverageTable />
      <div class="panel__foot">
        <span>Low / high move = lowest and highest method centre vs. price used</span>
        <span>Prices used {priceDate}</span>
      </div>
    </section>

    <section class="panel col-24" aria-labelledby="rng-title">
      <div class="panel__head">
        <h2 class="panel__title" id="rng-title"><Icon name="chart" size={13} /> Valuation ranges</h2>
      </div>
      <div class="panel__body"><FootballField models={valuationModels} /></div>
    </section>

    <section class="col-24" aria-labelledby="rep-title">
      <h2 class="sr-only" id="rep-title">Company reports</h2>
      <div class="grid-3">
        {reports.map(({ m, low, high }) => (
          <a class="panel" href={`/research/${m.slug}`}>
            <div class="panel__head">
              <span class="panel__title"><Ticker label={m.ticker} /> {m.company}</span>
              <span class="panel__actions"><span class:list={['tag', low >= 0 ? 'tag--up' : high < 0 ? 'tag--down' : 'tag--amber']}>{signedPct(low, 0)} / {signedPct(high, 0)}</span></span>
            </div>
            <div class="panel__body stack-3">
              <p class="h-sm">{m.report.headline}</p>
              <FootballField outputs={m.outputs} reference={m.referencePrice} ticker={m.ticker} legend={false} compact />
              <div class="row">
                <span class="tag">{m.sector}</span>
                <span class="tag">Price used {formatVndK(m.referencePrice.value)}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="col-24" id="spread" aria-labelledby="spread-title">
      <div class="panel">
        <div class="panel__head">
          <h2 class="panel__title" id="spread-title"><Icon name="layers" size={13} /> Method spread</h2>
          <span class="panel__meta">Where methods disagree, the spread is the finding</span>
        </div>
        <div class="panel__body"><ValuationComparator /></div>
      </div>
    </section>

    <section class="panel col-24" id="methods" aria-labelledby="methods-title">
      <div class="panel__head">
        <h2 class="panel__title" id="methods-title"><Icon name="grid" size={13} /> Valuation frameworks</h2>
      </div>
      <dl class="defs grid-defs grid-defs--3">
        {methods.map((p) => (
          <div>
            <dt><a class="link" href={p.href}>{p.group.title}</a> <span class="dim">· {p.group.eyebrow}</span></dt>
            <dd>{p.group.description}</dd>
            <dd class="row">{p.tickers.map((t) => <Ticker label={t} />)}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="col-24 stack-3" id="files" aria-labelledby="files-title">
      <h2 class="sr-only" id="files-title">Model files</h2>
      <WorkbookVault />
      <Disclaimer />
    </section>
  </div>
</BaseLayout>
