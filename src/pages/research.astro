---
// Research Coverage Hub (/research) — Fey × Mercury × Koyfin clean hierarchy
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverageStrip from '../components/ui/CoverageStrip.astro';
import CoverageTable from '../components/ui/CoverageTable.astro';
import DatedNote from '../components/ui/DatedNote.astro';
import Disclaimer from '../components/ui/Disclaimer.astro';
import DocHead from '../components/ui/DocHead.astro';
import Ticker from '../components/ui/Ticker.astro';
import ValuationComparator from '../components/ui/ValuationComparator.astro';
import WorkbookVault from '../components/ui/WorkbookVault.astro';
import { STALE_AFTER_DAYS, methodPages, valuationGroups, valuationModels } from '../data/valuation-models';
import { daysBetween, formatDate } from '../lib/format';

const workbooks = valuationModels.reduce((t, m) => t + m.downloads.length, 0);
const oldest = [...new Set(valuationModels.map((m) => m.lastUpdated ?? m.referencePrice.asOf))].sort()[0];
const stale = daysBetween(oldest, new Date()) > STALE_AFTER_DAYS;
const methods = methodPages.map((p) => ({
  ...p,
  group: valuationGroups.find((g) => g.id === p.id),
  tickers: valuationModels.filter((m) => m.valuationNotes.some((n) => n.groups.includes(p.id))).map((m) => m.ticker),
}));
---

<BaseLayout
  title="Research coverage: five Vietnam-listed companies | Truong Huy Research"
  description="Valuation coverage of HPG, BID, FPT, BMP and PNJ: DCF, comparable, precedent-transaction and LBO outputs against the price each model used, with downloadable Excel workbooks and A4 tear sheets."
>
  <div class="doc">
    <DocHead
      label={`${valuationModels.length} companies · ${workbooks} Excel workbooks`}
      title="Vietnam equity coverage"
      lead="Each company is valued with the methods that fit its sector and cash-flow structure. Outputs stay separate as ranges against the model reference price, with every workbook open for audit."
    >
      <div class="toc">
        <a href="#matrix">Coverage Matrix</a>
        <a href="#comparator">Method Spread</a>
        <a href="#vault">Workbook Vault</a>
        <a href="#methods">Frameworks</a>
      </div>
      <div slot="aside">
        <CoverageStrip />
      </div>
    </DocHead>

    <section id="matrix" class="ground-surface" aria-labelledby="table-h">
      <div class="wrap stack-5">
        <div class="section-head--split">
          <div>
            <h2 id="table-h">Valuation outputs by method</h2>
            <p class="t-lead">VND per share against the reference price each workbook used.</p>
          </div>
        </div>
        {stale && (
          <DatedNote>
            All models and reference share prices are as of {formatDate(oldest)} and have not been refreshed since. Implied moves are measured against those model-date prices, not live quotes.
          </DatedNote>
        )}
        <div class="sheet">
          <CoverageTable sortable filterable />
        </div>
        <p class="mono t-label muted">
          ≈ marks an approximate precedent-transaction control value. Low Move and High Move compare the lowest and highest method against the price used.
        </p>
      </div>
    </section>

    <section id="comparator" aria-labelledby="comparator-h">
      <div class="wrap stack-5">
        <div class="section-head">
          <h2 id="comparator-h">Method spread &amp; valuation ladder</h2>
          <p class="t-lead">
            Why intrinsic DCF, public peer multiples, precedent transactions, and sponsor LBO models diverge for each company.
          </p>
        </div>
        <ValuationComparator />
      </div>
    </section>

    <section id="vault" class="ground-surface" aria-labelledby="vault-h">
      <div class="wrap stack-5">
        <div class="section-head">
          <h2 id="vault-h">Open Excel workbooks &amp; A4 tear sheets</h2>
          <p class="t-lead">
            Download the unedited Excel valuation templates and printable one-page A4 tear sheets across all five companies.
          </p>
        </div>
        <WorkbookVault />
      </div>
    </section>

    <section id="methods" aria-labelledby="methods-h">
      <div class="wrap stack-5">
        <div class="section-head">
          <h2 id="methods-h">Three valuation frameworks</h2>
          <p class="t-lead">Each method page gathers the assumptions, outputs, and workbooks for every company it was used on.</p>
        </div>
        <div class="grid">
          {methods.map((m) => m.group && (
            <a class="card span-4" href={m.href}>
              <div class="sheet__head">
                <span class="t-label muted">{m.group.eyebrow}</span>
                <span class="badge badge--navy">{m.tickers.length} Companies</span>
              </div>
              <h3>{m.group.title}</h3>
              <p class="t-small secondary">{m.group.description}</p>
              <p class="tickers">{m.tickers.map((t) => <Ticker label={t} />)}</p>
            </a>
          ))}
        </div>
        <Disclaimer />
      </div>
    </section>
  </div>
</BaseLayout>
