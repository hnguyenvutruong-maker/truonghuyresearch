---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DisclaimerBox from '../../components/DisclaimerBox.astro';
import NoteList from '../../components/broadsheet/NoteList.astro';
import { getCollection } from 'astro:content';
import { monthlySummary } from '../../lib/notes';

const notes = (await getCollection('monthly-views')).map(monthlySummary);
---

<BaseLayout
  title="Monthly Market Views | Truong Huy Research"
  description="Monthly Vietnam market notes: VN-Index monthly range, liquidity, foreign flow, best and worst sectors, and cross-asset context."
>
  <section class="mx-auto w-full max-w-container-max px-margin-mobile pt-8 md:px-margin-desktop md:pt-10">
    <div class="flex animate-rise flex-wrap items-center justify-between gap-x-6 gap-y-1 border-b border-ink pb-2 font-news-mono text-news-label uppercase text-ink-muted">
      <a href="/market-views" class="news-link transition-colors hover:text-oxblood">← All market notes</a>
      <span>{notes.length} monthly notes</span>
    </div>
    <div class="border-b border-ink py-10">
      <h1 class="animate-rise font-news text-news-hero text-ink [animation-delay:80ms]">Monthly views</h1>
      <p class="mt-6 max-w-2xl animate-rise font-news text-news-dek italic text-ink-soft [animation-delay:160ms]">
        The month in one read: where VN-Index travelled, which sectors led and lagged, how foreign investors traded, and what
        to watch next.
      </p>
    </div>
  </section>

  <section class="mx-auto w-full max-w-container-max px-margin-mobile py-8 md:px-margin-desktop">
    <NoteList notes={notes} />
  </section>

  <section class="mx-auto w-full max-w-container-max px-margin-mobile pb-16 pt-8 md:px-margin-desktop">
    <DisclaimerBox />
  </section>
</BaseLayout>
