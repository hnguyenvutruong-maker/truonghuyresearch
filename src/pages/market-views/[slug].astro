---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MarketNote from '../../components/ui/MarketNote.astro';
import { getCollection } from 'astro:content';
import { weeklySummary } from '../../lib/notes';

export async function getStaticPaths() {
  const views = (await getCollection('market-views')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
  return views.map((entry, i) => ({
    params: { slug: entry.slug },
    props: { entry, prev: views[i - 1] ?? null, next: views[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await entry.render();
const note = weeklySummary(entry);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  datePublished: entry.data.date.toISOString(),
  author: { '@type': 'Person', name: 'Nguyen Vu Truong Huy', url: 'https://truonghuyresearch.xyz' },
  publisher: { '@type': 'Person', name: 'Nguyen Vu Truong Huy' },
  url: Astro.url.href,
};
---

<BaseLayout
  type="article"
  image={`/og${note.href}.png`}
  title={`${note.headline} | Weekly Market View ${note.period}`}
  description={`Weekly VN-Index note for ${note.period}: close ${note.close.toFixed(2)} (${note.change >= 0 ? '+' : ''}${note.change.toFixed(2)}%), liquidity, foreign flow, sectors and cross-asset context.`}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <MarketNote
    note={note}
    headings={headings}
    prev={prev ? weeklySummary(prev) : null}
    next={next ? weeklySummary(next) : null}
    listHref="/market-views"
  >
    <Content />
  </MarketNote>
</BaseLayout>
