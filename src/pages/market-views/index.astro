---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Disclaimer from '../../components/ui/Disclaimer.astro';
import ForeignFlowMonitor from '../../components/ui/ForeignFlowMonitor.astro';
import Icon from '../../components/ui/Icon.astro';
import MacroThesisTracker from '../../components/ui/MacroThesisTracker.astro';
import NoteList from '../../components/ui/NoteList.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import VnIndexChart from '../../components/ui/VnIndexChart.astro';
import { formatDate, formatIndex, formatNumber, signedNumber, signedPct } from '../../lib/format';
import { monthlySummary, weeklySummary } from '../../lib/notes';

const weekly = (await getCollection('market-views')).map(weeklySummary);
const monthly = (await getCollection('monthly-views')).map(monthlySummary);
const all = [...weekly, ...monthly].sort((a, b) => b.date.valueOf() - a.date.valueOf());
const trend = [...weekly].sort((a, b) => a.date.valueOf() - b.date.valueOf()).map((n) => ({ time: n.date.toISOString().slice(0, 10), value: n.close }));
const latest = all[0];
const latestWeekly = [...weekly].sort((a, b) => b.date.valueOf() - a.date.valueOf())[0];
const featured = all.slice(0, 3);
---

<BaseLayout
  title="Market notes on the VN-Index | Truong Huy Research"
  description="Weekly and monthly Vietnam market notes: VN-Index levels, liquidity, HOSE foreign flow, sector rotation and cross-asset context."
>
  <PageHeader
    crumbs={[{ label: 'Market notes' }]}
    eyebrow={`${weekly.length} weekly · ${monthly.length} monthly`}
    title="Market notes"
    lead="Where the VN-Index travelled, how much traded, what foreign investors did and how the dollar, oil, gold and Bitcoin moved around it. Figures come from measured data; the prose is checked against them."
  >
    <div class="btn-row">
      {latest && <a class="btn btn--primary" href={latest.href}>Latest note <Icon name="arrow_right" size={14} /></a>}
      <a class="btn btn--secondary" href="/monthly-views">Monthly views</a>
      <a class="btn btn--ghost" href="/rss.xml"><Icon name="rss" size={14} /> RSS</a>
    </div>
    {latestWeekly && (
      <dl slot="aside" class="facts">
        <div><dt>Latest week</dt><dd>{latestWeekly.period}</dd></div>
        <div><dt>VN-Index close</dt><dd>{formatIndex(latestWeekly.close)} <span class={latestWeekly.change >= 0 ? 'up' : 'down'}>{signedPct(latestWeekly.change)}</span></dd></div>
        <div><dt>Avg daily liquidity</dt><dd>{formatNumber(latestWeekly.liquidity, 0)} bn</dd></div>
        <div><dt>Foreign net</dt><dd class={latestWeekly.foreignNet != null && latestWeekly.foreignNet < 0 ? 'down' : 'up'}>{latestWeekly.foreignNet != null ? `${signedNumber(latestWeekly.foreignNet)} bn` : '—'}</dd></div>
      </dl>
    )}
  </PageHeader>

  <section class="section--tight" aria-labelledby="latest-title">
    <div class="container stack-6">
      <div class="sec-head">
        <h2 id="latest-title">Latest</h2>
        <span class="small muted">Most recent note {latest ? formatDate(latest.date) : ''}</span>
      </div>
      <div class="grid-3">
        {featured.map((n) => (
          <a class="note-card" href={n.href}>
            <div class="note-card__by">
              <span class="avatar avatar--sm" aria-hidden="true">TH</span>
              <span class="note-card__who">{n.kind} market view<span>{n.period}</span></span>
            </div>
            <p class="note-card__title">{n.headline}</p>
            <div class="note-card__meta">
              <span class="tag tag--mono">{formatIndex(n.close)}</span>
              <span class:list={['tag', 'tag--mono', n.change >= 0 ? 'tag--up' : 'tag--down']}>{signedPct(n.change)}</span>
              {n.foreignNet != null && <span class="tag tag--mono">Foreign {signedNumber(n.foreignNet, 0)} bn</span>}
            </div>
          </a>
        ))}
      </div>
      <div class="window">
        <div class="window__bar">
          <span class="window__title"><Icon name="chart" size={14} /> VN-Index weekly close</span>
          <span class="window__actions"><span class="tag tag--mono">{trend.length} weeks</span></span>
        </div>
        <div class="window__pad">
          <VnIndexChart trendData={trend} label={`VN-Index weekly close across ${trend.length} weekly notes`} />
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight" id="foreign-flow" aria-labelledby="flow-title">
    <div class="container stack-6">
      <div class="sec-head">
        <h2 id="flow-title">Foreign flow</h2>
        <span class="small muted">Hover or tab through the bars</span>
      </div>
      <ForeignFlowMonitor />
    </div>
  </section>

  <section class="section--tight" id="levels" aria-labelledby="levels-title">
    <div class="container stack-6">
      <div class="sec-head">
        <h2 id="levels-title">Levels &amp; regime</h2>
      </div>
      <MacroThesisTracker />
    </div>
  </section>

  <section class="section--tight" id="archive" aria-labelledby="archive-title">
    <div class="container container--narrow stack-6">
      <div class="sec-head">
        <h2 id="archive-title">Archive</h2>
        <span class="small muted">{all.length} notes</span>
      </div>
      <NoteList notes={all} filter />
      <Disclaimer />
    </div>
  </section>
</BaseLayout>
