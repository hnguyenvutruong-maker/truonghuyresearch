---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Disclaimer from '../../components/ui/Disclaimer.astro';
import NoteList from '../../components/ui/NoteList.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Panel from '../../components/ui/Panel.astro';
import VnIndexChart from '../../components/ui/VnIndexChart.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/format';
import { monthlySummary, weeklySummary } from '../../lib/notes';

const weekly = (await getCollection('market-views')).map(weeklySummary);
const monthly = (await getCollection('monthly-views')).map(monthlySummary);
const notes = [...weekly, ...monthly];
const trend = [...weekly]
  .sort((a, b) => a.date.valueOf() - b.date.valueOf())
  .map((note) => ({ time: note.date.toISOString().slice(0, 10), value: note.close }));
const latest = [...notes].sort((a, b) => b.date.valueOf() - a.date.valueOf())[0];
---

<BaseLayout
  title="Market Notes | Truong Huy Research"
  description="Weekly and monthly Vietnam market notes: VN-Index levels, liquidity, foreign flow, sector rotation and cross-asset context."
>
  <div class="mx-auto w-full max-w-container-max space-y-4 px-margin-mobile py-6 md:px-margin-desktop md:py-8">
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <PageHeader
          tone="market"
          kicker="Section III · Market views"
          title="Market notes"
          lead="Weekly and monthly reads on the Vietnam tape: VN-Index levels, liquidity, foreign flow, sector rotation, and what the dollar, oil, and gold mean for local equities."
          context={latest ? `Latest · ${formatDate(latest.date)}` : undefined}
        />
      </div>
      {trend.length > 0 && (
        <Panel title="VN-Index · weekly close" meta={`${trend.length} weeks`} tone="market" class="lg:col-span-7">
          <VnIndexChart trendData={trend} label="VN-Index weekly closes taken from the notes below" height="md" />
        </Panel>
      )}
    </div>

    <NoteList notes={notes} filter />

    <Disclaimer />
  </div>
</BaseLayout>
