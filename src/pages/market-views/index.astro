---
// Market Intelligence Hub (/market-views) — Fey × Mercury × Koyfin clean layout
import BaseLayout from '../../layouts/BaseLayout.astro';
import Disclaimer from '../../components/ui/Disclaimer.astro';
import DocHead from '../../components/ui/DocHead.astro';
import ForeignFlowMonitor from '../../components/ui/ForeignFlowMonitor.astro';
import MacroThesisTracker from '../../components/ui/MacroThesisTracker.astro';
import NoteList from '../../components/ui/NoteList.astro';
import VnIndexChart from '../../components/ui/VnIndexChart.astro';
import { getCollection } from 'astro:content';
import { formatDate, formatIndex, signedPct } from '../../lib/format';
import { monthlySummary, weeklySummary } from '../../lib/notes';

const weekly = (await getCollection('market-views')).map(weeklySummary);
const monthly = (await getCollection('monthly-views')).map(monthlySummary);
const notes = [...weekly, ...monthly];
const trend = [...weekly]
  .sort((a, b) => a.date.valueOf() - b.date.valueOf())
  .map((n) => ({ time: n.date.toISOString().slice(0, 10), value: n.close }));
const latest = [...notes].sort((a, b) => b.date.valueOf() - a.date.valueOf())[0];
---

<BaseLayout
  title="Market notes on the VN-Index | Truong Huy Research"
  description="Weekly and monthly Vietnam market notes: VN-Index levels, liquidity, live HOSE foreign flow telemetry, sector rotation and cross-asset context."
>
  <div class="doc">
    <DocHead
      label={`${weekly.length} weekly & ${monthly.length} monthly notes · Latest ${formatDate(latest.date)}`}
      title="VN-Index notes &amp; HOSE flow"
      lead="Weekly and monthly reads on VN-Index structure, liquidity, daily foreign trading across HOSE, sector rotation, and global cross-asset channels."
    >
      <div class="toc">
        <a href="#foreign-flow">HOSE Foreign Flow</a>
        <a href="#thesis-tracker">Technical Levels &amp; Macro</a>
        <a href="#archive">Notes Archive ({notes.length})</a>
      </div>
      <div slot="aside" class="sheet">
        <div class="sheet__head">
          <h3 class="t-h3">VN-Index weekly close</h3>
          <span class="mono t-label">
            <strong>{formatIndex(latest.close)}</strong>{' '}
            <span class:list={[latest.change >= 0 ? 'up' : 'down']}>({signedPct(latest.change)})</span>
          </span>
        </div>
        <VnIndexChart trendData={trend} label="VN-Index weekly closes" height="md" />
      </div>
    </DocHead>

    <section id="foreign-flow" class="ground-surface" aria-labelledby="flow-h">
      <div class="wrap stack-5">
        <div class="section-head">
          <h2 id="flow-h">HOSE foreign investor flow</h2>
          <p class="t-lead">
            Daily foreign buy, sell, and net values aggregated across HOSE equities from 15 Jun to 20 Nov 2026.
          </p>
        </div>
        <ForeignFlowMonitor />
      </div>
    </section>

    <section id="thesis-tracker" aria-labelledby="thesis-h">
      <div class="wrap stack-5">
        <div class="section-head">
          <h2 id="thesis-h">Macro regime &amp; technical framework</h2>
          <p class="t-lead">
            Support and resistance levels, active macro themes, and forward risks linking weekly and monthly notes.
          </p>
        </div>
        <MacroThesisTracker />
      </div>
    </section>

    <section id="archive" class="ground-surface" aria-labelledby="archive-h">
      <div class="wrap stack-5">
        <div class="section-head--split">
          <h2 id="archive-h">All market notes</h2>
          <div class="btn-row">
            <a class="btn btn--secondary btn--sm" href="/monthly-views">Monthly Notes ({monthly.length})</a>
            <a class="btn btn--ghost btn--sm" href="/rss.xml">RSS Feed</a>
          </div>
        </div>
        <div class="sheet">
          <NoteList notes={notes} filter />
        </div>
        <Disclaimer />
      </div>
    </section>
  </div>
</BaseLayout>
