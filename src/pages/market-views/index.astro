---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DisclaimerBox from '../../components/DisclaimerBox.astro';
import NoteList from '../../components/broadsheet/NoteList.astro';
import VnIndexChart from '../../components/VnIndexChart.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/format';
import { monthlySummary, weeklySummary } from '../../lib/notes';

const weekly = (await getCollection('market-views')).map(weeklySummary);
const monthly = (await getCollection('monthly-views')).map(monthlySummary);
const notes = [...weekly, ...monthly];
const trend = [...weekly]
  .sort((a, b) => a.date.valueOf() - b.date.valueOf())
  .map((note) => ({ time: note.date.toISOString().slice(0, 10), value: note.close }));
const latest = [...notes].sort((a, b) => b.date.valueOf() - a.date.valueOf())[0];
---

<BaseLayout
  title="Market Notes | Truong Huy Research"
  description="Weekly and monthly Vietnam market notes: VN-Index levels, liquidity, foreign flow, sector rotation and cross-asset context."
>
  <section class="mx-auto w-full max-w-container-max px-margin-mobile pt-8 md:px-margin-desktop md:pt-10">
    <div class="flex animate-rise flex-wrap items-center justify-between gap-x-6 gap-y-1 border-b border-ink pb-2 font-news-mono text-news-label uppercase text-ink-muted">
      <span>Section III · Market Views</span>
      {latest && <span>Latest note · {formatDate(latest.date)}</span>}
    </div>
    <div class="grid grid-cols-1 gap-10 border-b border-ink py-10 lg:grid-cols-12 lg:gap-0">
      <div class="lg:col-span-6 lg:pr-10">
        <h1 class="animate-rise font-news text-news-hero text-ink [animation-delay:80ms]">Market notes</h1>
        <p class="mt-6 max-w-xl animate-rise font-news text-news-dek italic text-ink-soft [animation-delay:160ms]">
          Weekly and monthly reads on the Vietnam tape: VN-Index levels, liquidity, foreign flow, sector rotation, and what
          the dollar, oil, and gold mean for local equities.
        </p>
      </div>
      {trend.length > 0 && (
        <figure class="animate-rise [animation-delay:240ms] lg:col-span-6 lg:border-l lg:border-ink/25 lg:pl-10">
          <VnIndexChart trendData={trend} label="VN-Index · weekly close" />
          <figcaption class="mt-3 font-news text-news-data italic text-ink-muted">Weekly closes taken from the notes below.</figcaption>
        </figure>
      )}
    </div>
  </section>

  <section class="mx-auto w-full max-w-container-max px-margin-mobile py-8 md:px-margin-desktop">
    <NoteList notes={notes} filter />
  </section>

  <section class="mx-auto w-full max-w-container-max px-margin-mobile pb-16 pt-8 md:px-margin-desktop">
    <DisclaimerBox />
  </section>
</BaseLayout>
