---
// Self-hosted fonts (bundled into /_astro/): Archivo (display, width + weight axes),
// Source Sans 3 (body), IBM Plex Mono (labels and figures)
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/source-sans-3/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SiteHeader from '../components/ui/SiteHeader.astro';
import MarketTape from '../components/ui/MarketTape.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';
import Motion from '../components/ui/Motion.astro';
import CommandPalette from '../components/ui/CommandPalette.astro';
import SkyIntro from '../components/ui/SkyIntro.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title,
  description = 'Vietnam equity research, valuation models, and market notes by Nguyen Vu Truong Huy.',
  image = '/og-image.png',
  type = 'website',
} = Astro.props;

const canonicalURL = Astro.url.href;
const ogImageURL = new URL(image, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>(function(){var d=document.documentElement,m=null,h=new Date().getHours();try{m=localStorage.getItem('thr-theme')}catch(e){}var manual=m==='light'||m==='dark';d.dataset.theme=manual?m:(h>=18||h<6?'dark':'light');d.dataset.themeMode=manual?'manual':'auto';d.classList.add('js')})();</script>
    <meta name="theme-color" content="#0B1B33" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Truong Huy Research — Market Views" href="/rss.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Nguyen Vu Truong Huy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Truong Huy Research" />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@trghuyy" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body class="flex min-h-screen flex-col bg-canvas font-sans text-fg antialiased">
    <a href="#main" class="sr-only bg-value px-4 py-2 font-mono text-label uppercase text-white focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70]">Skip to content</a>
    <SiteHeader />
    <MarketTape />

    <main id="main" class="w-full flex-grow">
      <slot />
    </main>

    <SiteFooter />

    <SkyIntro />
    <CommandPalette />
    <Motion />
    <Analytics />
  </body>
</html>
