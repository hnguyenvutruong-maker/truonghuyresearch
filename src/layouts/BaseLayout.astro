---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SiteHeader from '../components/broadsheet/SiteHeader.astro';
import SiteFooter from '../components/broadsheet/SiteFooter.astro';
import Motion from '../components/broadsheet/Motion.astro';
import CommandPalette from '../components/broadsheet/CommandPalette.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title,
  description = 'Vietnam equity research, valuation models, and market notes by Nguyen Vu Truong Huy.',
  image = '/og-image.png',
  type = 'website',
} = Astro.props;

const canonicalURL = Astro.url.href;
const ogImageURL = new URL(image, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="theme-color" content="#F2E8DA" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Truong Huy Research — Market Views" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=arrow_downward,arrow_forward,calendar_month,download,menu,north_east,search,view_week&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Nguyen Vu Truong Huy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Truong Huy Research" />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@trghuyy" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body class="flex min-h-screen flex-col font-news text-ink antialiased">
    <SiteHeader />

    <main class="w-full flex-grow">
      <slot />
    </main>

    <SiteFooter />

    <Analytics />
    <Motion />
    <CommandPalette />

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const setOpen = (open: boolean) => {
        btn?.setAttribute('aria-expanded', String(open));
        menu?.classList.toggle('hidden', !open);
      };
      btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
      menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          btn.focus();
        }
      });
    </script>
  </body>
</html>
