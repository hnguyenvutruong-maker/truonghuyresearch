---
// Institutional Editorial page shell: self-hosted Source Serif 4, Libre Franklin, and IBM Plex Mono.
// Strict Content-Security-Policy compliant (no external Taste kit scripts, zero inline executable scripts).
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource/libre-franklin/400.css';
import '@fontsource/libre-franklin/500.css';
import '@fontsource/libre-franklin/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/site.css';
import Analytics from '@vercel/analytics/astro';
import SiteHeader from '../components/ui/SiteHeader.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';
import CommandPalette from '../components/ui/CommandPalette.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title,
  description = 'Equity research on Vietnam-listed companies: valuation models, open Excel workbooks and market notes by Nguyen Vu Truong Huy.',
  image = '/og-image.png',
  type = 'website',
} = Astro.props;

const canonicalURL = Astro.url.href;
const ogImageURL = new URL(image, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F6F2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Truong Huy Research: market notes" href="/rss.xml" />
    <meta name="author" content="Nguyen Vu Truong Huy" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Truong Huy Research" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@trghuyy" />
  </head>
  <body>
    <SiteHeader />
    <main id="top">
      <slot />
    </main>
    <SiteFooter />
    <CommandPalette />
    <Analytics />
  </body>
</html>
