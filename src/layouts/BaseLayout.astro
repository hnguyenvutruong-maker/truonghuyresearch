---
// Self-hosted fonts (bundled into /_astro/, the CSP allows same-origin fonts only):
// Source Serif 4 (display), IBM Plex Sans (text), IBM Plex Mono (figures).
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SiteHeader from '../components/ui/SiteHeader.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  /** The closing band above the footer links (off on pages that end in their own action). */
  close?: boolean;
}

const {
  title,
  description = 'Equity research on Vietnam-listed companies: valuation models, open workbooks and market notes by Nguyen Vu Truong Huy.',
  image = '/og-image.png',
  type = 'website',
  close = true,
} = Astro.props;

const canonicalURL = Astro.url.href;
const ogImageURL = new URL(image, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#F7F9FA" />
    <meta name="site-kind" content="other" />
    <meta name="page-type" content="service" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Truong Huy Research: market notes" href="/rss.xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Nguyen Vu Truong Huy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Truong Huy Research" />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@trghuyy" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter close={close} />
    <Analytics />
  </body>
</html>
